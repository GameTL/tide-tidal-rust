// Settings page (⌘,).
import { ScrollView } from "std-widgets.slint";
import { App, Theme, EditableInput, Toggle, Icon, Keys } from "common.slint";

component Card inherits Rectangle {
    border-radius: 12px;
    background: #0e0e10;
    border-width: 1px;
    border-color: #17171a;
    VerticalLayout {
        padding-left: 18px;
        padding-right: 18px;
        @children
    }
}

component Row inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <bool> divider: true;
    // Room kept free on the right for the row's controls.
    in property <length> controls-width: 190px;
    // The row has controls (a switch, buttons, a field).
    in property <bool> has-controls: true;
    // Phone width: the controls go under the text, at the right. (By the
    // page's width: the row's own would depend on its padding.)
    property <bool> stacked: App.pane-width < 520px;
    min-height: 82px;
    VerticalLayout {
        alignment: center;
        spacing: 6px;
        padding-right: root.stacked ? 0px : root.controls-width;
        padding-top: root.stacked ? 18px : 0px;
        padding-bottom: !root.stacked ? 0px : root.has-controls ? 66px : 18px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 15px;
            font-weight: 600;
        }

        if root.detail != "": Text {
            text: root.detail;
            color: #b2b2b6;
            font-size: 13px;
            wrap: word-wrap;
        }
    }

    if divider: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #19191c;
    }
    Rectangle {
        y: root.stacked ? root.height - 62px : 0px;
        height: root.stacked ? 46px : root.height;
        @children
    }
}

component QualityRow inherits Rectangle {
    in property <string> key;
    in property <string> title;
    in property <string> detail;
    in property <bool> divider: true;
    in property <bool> first: false;
    property <bool> selected: App.quality == key;
    // Tier colours (Goal.md, "Quality colours"): Low white, High blue, Max gold.
    property <color> tier-color: key == "max" ? Theme.max : key == "high" ? Theme.lossless : Theme.text;
    // Phone width: the detail wraps.
    height: App.pane-width < 480px ? 96px : 82px;
    // Faint wash in the tier colour, as in the official client: strongest in the
    // row's lower-left corner, gone by mid-card and by the top of the row. Two
    // linear fades stand in for an off-centre ellipse, which Slint cannot draw.
    // It starts at the card's edge (inside the 1px border), so it follows the
    // card's corners on the first and last row.
    if selected: Rectangle {
        x: -17px;
        y: 0px;
        width: (parent.width + 36px) * 0.46;
        height: parent.height - (root.divider ? 0px : 1px);
        border-top-left-radius: root.first ? 11px : 0px;
        border-bottom-left-radius: root.divider ? 0px : 11px;
        background: @linear-gradient(90deg, (key == "max" ? #26221a : key == "high" ? #122422 : #1c1c1e) 0%, #0e0e10 100%);
        Rectangle {
            border-top-left-radius: parent.border-top-left-radius;
            background: @linear-gradient(180deg, #0e0e10 0%, #0e0e1000 100%);
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            App.set-quality(root.key);
        }
    }

    Rectangle {
        x: 0px;
        width: 26px;
        height: 26px;
        border-radius: 13px;
        background: #1f1f22;
        if selected: Rectangle {
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.tier-color;
        }
    }

    VerticalLayout {
        x: 48px;
        width: parent.width - 48px;
        alignment: center;
        spacing: 8px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: 15px;
            font-weight: 600;
        }

        Text {
            text: root.detail;
            color: #b2b2b6;
            font-size: 13px;
            wrap: word-wrap;
        }
    }

    if divider: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: #19191c;
    }
}

// Indented to the card's text column and set a little further above the card,
// as in the official client.
component SectionTitle inherits Rectangle {
    in property <string> text;
    height: 67px;
    Text {
        x: 18px;
        y: 0px;
        height: 62px;
        text: root.text;
        color: Theme.text;
        font-size: 17px;
        font-weight: 600;
        vertical-alignment: bottom;
    }
}

component SmallButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    callback clicked();
    width: label.preferred-width + 36px;
    height: 38px;
    border-radius: 19px;
    background: primary ? (ta.has-hover ? #e6e6e6 : white) : (ta.has-hover ? #2c2c2c : #1f1f22);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    label := Text {
        text: root.text;
        color: root.primary ? black : white;
        font-size: 14px;
        font-weight: 600;
    }
}

// The numbered circle in front of a login step.
component StepBadge inherits Rectangle {
    in property <int> number;
    // Already behind the user: a check instead of the number.
    in property <bool> done;
    // A step to do now.
    in property <bool> current;
    width: 24px;
    height: 24px;
    border-radius: 12px;
    background: root.current ? Theme.lossless : #1f1f22;
    if !root.done: Text {
        text: root.number;
        color: root.current ? #10201f : Theme.text-secondary;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.done: Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: @image-url("icons/check.svg");
        size: 14px;
        tint: Theme.lossless;
    }
}

// One numbered step of the login walkthrough.
component LoginStep inherits HorizontalLayout {
    in property <int> number;
    in property <string> title;
    in property <string> detail;
    in property <bool> done;
    in property <bool> current;
    spacing: 12px;
    VerticalLayout {
        alignment: start;
        StepBadge {
            number: root.number;
            done: root.done;
            current: root.current;
        }
    }

    VerticalLayout {
        alignment: start;
        spacing: 2px;
        horizontal-stretch: 1;
        Text {
            text: root.title;
            color: root.done ? Theme.text-secondary : Theme.text;
            font-size: 14px;
            font-weight: 600;
            min-height: 24px;
            vertical-alignment: center;
            wrap: word-wrap;
        }

        if root.detail != "": Text {
            text: root.detail;
            color: Theme.text-secondary;
            font-size: 12px;
            wrap: word-wrap;
        }
    }

    @children
}

// The login, step by step. TIDAL's sign-in ends on its own "Page not found"
// page, which looks like a failure unless the listener expects it. TIDE reads
// that page's address from Safari and Chromium browsers itself; with any other
// browser (App.pkce-manual) the listener copies it and pastes it into step 4.
component LoginSteps inherits VerticalLayout {
    in property <string> button-text;
    spacing: 12px;
    LoginStep {
        number: 1;
        title: "Click " + root.button-text;
        detail: App.pkce-waiting ? "" : "TIDAL opens in your browser.";
        done: App.pkce-waiting;
        current: !App.pkce-waiting;
    }

    LoginStep {
        number: 2;
        title: "Sign in to your TIDAL account";
        current: App.pkce-waiting;
    }

    LoginStep {
        number: 3;
        title: App.pkce-manual ? "Copy the address of “Page not found”" : "Wait for “Page not found”";
        detail: App.pkce-manual ? "Press \{Keys.combo(false, "L")}, then \{Keys.combo(false, "C")}." : "That page is expected. TIDE finishes by itself.";
        current: App.pkce-waiting;
        // What the last page looks like, so it is recognised.
        VerticalLayout {
            alignment: start;
            Rectangle {
                width: 96px;
                height: 54px;
                border-radius: 6px;
                background: black;
                border-width: 1px;
                border-color: #2a2a2a;
                Text {
                    y: 12px;
                    width: parent.width;
                    text: "Page not found";
                    color: white;
                    font-size: 9px;
                    font-weight: 700;
                    horizontal-alignment: center;
                }

                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: 32px;
                    width: 30px;
                    height: 11px;
                    border-radius: 5.5px;
                    background: #1f1f22;
                    Text {
                        text: "Home";
                        color: white;
                        font-size: 6px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    if App.pkce-manual: HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            StepBadge {
                number: 4;
                current: App.pkce-waiting;
            }
        }

        Rectangle {
            height: 38px;
            horizontal-stretch: 1;
            border-radius: 8px;
            border-width: 1px;
            border-color: paste.has-focus ? #3a3a3a : #222222;
            background: #0a0a0a;
            if paste.text == "": Text {
                x: 12px;
                text: "Paste the address here";
                color: Theme.text-secondary;
                font-size: 13px;
                vertical-alignment: center;
            }
            paste := EditableInput {
                x: 12px;
                width: parent.width - 24px;
                height: 18px;
                color: Theme.text;
                font-size: 13px;
                single-line: true;
                vertical-alignment: center;
                selection-background-color: #4a4a4a;
                accepted => {
                    App.pkce-finish(self.text);
                }
            }
        }

        SmallButton {
            text: "Finish";
            clicked => {
                App.pkce-finish(paste.text);
                paste.text = "";
            }
        }
    }
}

// Max-quality (PKCE) login. TIDAL's sign-in page opens in the default browser.
export component MaxLogin inherits VerticalLayout {
    in property <string> button-text: "Log in with TIDAL";
    in property <bool> centered: false;
    // The login screen always shows the steps; Settings once the login started.
    property <bool> show-steps: root.centered || App.pkce-waiting || App.pkce-manual;
    spacing: 12px;
    if root.show-steps && root.centered: LoginSteps {
        button-text: root.button-text;
    }
    if root.show-steps && root.centered: Rectangle {
        height: 4px;
    }
    HorizontalLayout {
        alignment: centered ? center : start;
        spacing: 10px;
        SmallButton {
            text: App.pkce-waiting ? "Open the browser again" : root.button-text;
            primary: true;
            clicked => {
                App.pkce-start();
            }
        }

        if App.pkce-offer-safari: SmallButton {
            text: "Use Safari instead";
            clicked => {
                App.pkce-start-safari();
            }
        }
    }

    // In Settings the button stays put and the steps unfold under it.
    if root.show-steps && !root.centered: LoginSteps {
        button-text: root.button-text;
    }

    if App.pkce-status != "": Text {
        text: App.pkce-status;
        color: Theme.max;
        font-size: 13px;
        wrap: word-wrap;
        horizontal-alignment: centered ? center : left;
    }
}

export component SettingsView inherits Rectangle {
    property <length> column-w: min(892px, self.width - 2 * (App.phone-layout ? 16px : 32px));
    ScrollView {
        content-y <=> App.scroll-y;
        VerticalLayout {
            padding-left: (root.width - root.column-w) / 2;
            padding-right: (root.width - root.column-w) / 2;
            padding-top: 12px;
            padding-bottom: 60px + App.bar-inset;
            alignment: start;
            Text {
                text: "Settings";
                color: Theme.text;
                font-size: 28px;
                font-weight: 700;
                height: 44px;
                vertical-alignment: center;
            }

            Rectangle {
                height: 52px;
                HorizontalLayout {
                    alignment: start;
                    spacing: 26px;
                    for tab[i] in ["General", "Account", "About"]: Rectangle {
                        width: label.preferred-width;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                App.settings-tab = i;
                            }
                        }

                        label := Text {
                            text: tab;
                            color: App.settings-tab == i ? Theme.text : Theme.text-secondary;
                            font-size: 15px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }

                        if App.settings-tab == i: Rectangle {
                            y: parent.height - 2px;
                            height: 2px;
                            background: white;
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: #19191c;
                }
            }

            if App.settings-tab == 0: VerticalLayout {
                spacing: 0px;
                SectionTitle {
                    text: "Audio quality";
                }

                Rectangle {
                    height: 14px;
                }

                Card {
                    QualityRow {
                        key: "low";
                        first: true;
                        title: "Low";
                        detail: "AAC 320 kbps. Balance audio quality and data consumption";
                    }

                    QualityRow {
                        key: "high";
                        title: "High";
                        detail: "16-bit, 44.1 kHz";
                    }

                    QualityRow {
                        key: "max";
                        title: "Max";
                        detail: "Up to 24-bit, 192 kHz when available";
                        divider: false;
                    }
                }

                SectionTitle {
                    text: "Playback";
                }

                Rectangle {
                    height: 14px;
                }

                Card {
                    Row {
                        title: "Sound output";
                        detail: App.output-info;
                        has-controls: false;
                    }

                    Row {
                        title: "Match output sample rate";
                        detail: "Switches the output device to each track's sample rate and bit depth for bit-perfect playback. Never used for Bluetooth or AirPlay.";
                        Toggle {
                            x: parent.width - self.width;
                            on: App.rate-matching;
                            toggled(v) => {
                                App.set-rate-matching(v);
                            }
                        }
                    }

                    Row {
                        title: "DSP";
                        detail: App.dsp-active ? "On for " + App.dsp-device + ". DSP is shaping the sound, so playback is Enhanced rather than bit-perfect." : App.dsp-enabled ? "On for " + App.dsp-device + ". The current settings leave the sound unchanged." : "DSP is off for " + App.dsp-device + ".";
                        HorizontalLayout {
                            x: parent.width - self.width;
                            width: self.preferred-width;
                            height: 38px;
                            spacing: 10px;
                            SmallButton {
                                text: "Open";
                                clicked => { App.navigate("dsp"); }
                            }
                            Rectangle {
                                width: 1px;
                                height: 26px;
                                background: #3a3a3e;
                            }
                            VerticalLayout {
                                alignment: center;
                                Toggle {
                                    on: App.dsp-enabled;
                                    toggled(v) => { App.dsp-set-enabled(v); }
                                }
                            }
                        }
                    }

                    Row {
                        title: "Restore original sample rate";
                        detail: "Gives the device back the sample rate it had before TIDE changed it, after a pause and when TIDE quits. Turn off to leave it at the track's rate.";
                        divider: false;
                        Toggle {
                            x: parent.width - self.width;
                            on: App.restore-sample-rate;
                            toggled(v) => {
                                App.set-restore-sample-rate(v);
                            }
                        }
                    }
                }

                SectionTitle {
                    text: "Display";
                }

                Rectangle {
                    height: 14px;
                }

                Card {
                    Row {
                        title: "BPM";
                        detail: "Show the tempo of each track in track lists (albums, playlists, My Tracks) when there is room.";
                        Toggle {
                            x: parent.width - self.width;
                            on: App.show-audio-metadata;
                            toggled(v) => { App.set-show-audio-metadata(v); }
                        }
                    }

                    Row {
                        title: "Highlight shortcut letters";
                        detail: "Show the key that opens each sidebar page in white. Hold \{Keys.mod} to see them when this is off.";
                        Toggle {
                            x: parent.width - self.width;
                            on: App.show-key-letters;
                            toggled(v) => { App.set-show-key-letters(v); }
                        }
                    }

                    Row {
                        title: "Show collection in sidebar";
                        detail: "Show collection shortcuts in the sidebar. You can also reach them from Navigation.";
                        divider: false;
                        Toggle {
                            x: parent.width - self.width;
                            on: App.show-collection;
                            toggled(v) => { App.set-show-collection(v); }
                        }
                    }
                }

                SectionTitle {
                    text: "Performance & storage";
                }

                Rectangle {
                    height: 14px;
                }

                Card {
                    Row {
                        title: "Offline audio cache";
                        detail: App.cache-info;
                        controls-width: 240px;
                        SmallButton {
                            x: clear-button.x - self.width - 10px;
                            text: "Open folder";
                            clicked => {
                                App.open-cache-folder();
                            }
                        }

                        clear-button := SmallButton {
                            x: parent.width - self.width;
                            text: "Clear";
                            clicked => {
                                App.clear-cache();
                            }
                        }
                    }

                    Row {
                        title: "Maximum cache size";
                        detail: "When the cache is full, the tracks you play least are removed first. What you play most stays.";
                        Rectangle {
                            x: parent.width - self.width;
                            width: 118px;
                            height: 38px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: size-input.has-focus ? #4a4a4a : #26262a;
                            background: #0a0a0a;
                            size-input := EditableInput {
                                x: 12px;
                                width: parent.width - 52px;
                                height: 20px;
                                text <=> App.cache-max;
                                color: Theme.text;
                                font-size: 15px;
                                single-line: true;
                                input-type: decimal;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                                selection-background-color: #4a4a4a;
                                accepted => {
                                    App.set-cache-max(self.text);
                                    self.clear-focus();
                                }
                                focused(on) => {
                                    if !on {
                                        App.set-cache-max(self.text);
                                    }
                                }
                            }

                            Text {
                                x: parent.width - 36px;
                                text: "GB";
                                color: Theme.text-secondary;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Row {
                        title: "Keep most played offline";
                        detail: "Re-downloads your most played tracks in the background if they are missing from the cache.";
                        Toggle {
                            x: parent.width - self.width;
                            on: App.keep-most-played;
                            toggled(v) => {
                                App.set-keep-most-played(v);
                            }
                        }
                    }

                    Row {
                        title: "Fancy Animation";
                        detail: "Sliding back / forward page transitions, with a bigger graphics cache and an extra window buffer. Off, TIDE uses as little memory as it can and still animates at your display's refresh rate.";
                        divider: App.glass-available;
                        Toggle {
                            x: parent.width - self.width;
                            on: App.fancy-animation;
                            toggled(v) => {
                                App.set-fancy-animation(v);
                            }
                        }
                    }

                    if App.glass-available: Row {
                        title: "Liquid Glass";
                        detail: "The player bar is frosted glass: covers and lists show through, blurred, as they scroll beneath it. Uses about 5 MB more memory; off, the bar is solid. Follows macOS Reduce Transparency until you choose here.";
                        divider: false;
                        Toggle {
                            x: parent.width - self.width;
                            on: App.liquid-glass;
                            toggled(v) => {
                                App.set-liquid-glass(v);
                            }
                        }
                    }
                }
            }
            if App.settings-tab == 1: VerticalLayout {
                spacing: 0px;
                SectionTitle {
                    text: "Account";
                }

                Rectangle {
                    height: 14px;
                }

                Card {
                    Row {
                        title: App.username;
                        detail: App.max-login ? "Max quality enabled (up to 24-bit, 192 kHz)" : "Device-code session (up to 16-bit, 44.1 kHz)";
                        divider: false;
                        SmallButton {
                            x: parent.width - self.width;
                            text: "Log out";
                            clicked => {
                                App.logout();
                            }
                        }
                    }
                }

                if !App.max-login: SectionTitle {
                    text: "Max quality";
                }
                if !App.max-login: Rectangle {
                    height: 14px;
                }
                if !App.max-login: Card {
                    VerticalLayout {
                        padding-top: 18px;
                        padding-bottom: 18px;
                        spacing: 12px;
                        Text {
                            text: "This session was created with a device code, which TIDAL limits to 16-bit, 44.1 kHz. Log in again to unlock Hi-Res (up to 24-bit, 192 kHz).";
                            color: #c8c8c8;
                            font-size: 13px;
                            wrap: word-wrap;
                        }

                        MaxLogin {
                            button-text: "Log in for Max quality";
                        }
                    }
                }
            }
            if App.settings-tab == 2: VerticalLayout {
                spacing: 0px;
                SectionTitle {
                    text: "About";
                }

                Rectangle {
                    height: 14px;
                }

                Card {
                    Row {
                        title: "Version " + App.app-version;
                        has-controls: false;
                        detail: "An unofficial, independent player for TIDAL written in Rust. Not affiliated with or endorsed by TIDAL.";
                    }

                    Row {
                        title: "Your data";
                        has-controls: false;
                        detail: "Login tokens stay on this Mac in a file only your user can read. TIDE talks only to TIDAL's servers. See SECURITY.md.";
                        divider: false;
                    }
                }
            }
        }
    }
}
