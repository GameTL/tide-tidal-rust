import { Palette } from "std-widgets.slint";
import { App, Theme, TrackData, CardData, SectionData, LyricLine, SignalStage } from "common.slint";
import { Sidebar, TopBar, PlayerBar } from "chrome.slint";
import { HomeView, TracksView, GridView, StubView, NowPlayingView, LoginView } from "views.slint";
import { SettingsView } from "settings.slint";
import { TrackMenu } from "track-menu.slint";
import { Typography } from "@typography";

export { App, Theme, TrackData, CardData, SectionData, LyricLine, SignalStage }

export component MainWindow inherits Window {
    title: "TIDE";
    min-width: 960px;
    min-height: 620px;
    preferred-width: 1440px;
    preferred-height: 900px;
    background: Theme.bg;
    default-font-size: 15px;
    default-font-family: Typography.family;

    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Native macOS menu bar. Hide (⌘H), Hide Others and Quit (⌘Q) come from
    // the standard application menu that Slint adds automatically.
    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "Close Window"; shortcut: @keys(Control + W); activated => { App.close-window(); } }
        }

        Menu {
            title: "Edit";
            MenuItem { title: "Undo"; shortcut: @keys(Control + Z); activated => { App.edit("undo"); } }
            MenuItem { title: "Redo"; shortcut: @keys(Control + Shift + Z); activated => { App.edit("redo"); } }
            MenuSeparator { }
            MenuItem { title: "Cut"; shortcut: @keys(Control + X); activated => { App.edit("cut"); } }
            MenuItem { title: "Copy"; shortcut: @keys(Control + C); activated => { App.edit("copy"); } }
            MenuItem { title: "Paste"; shortcut: @keys(Control + V); activated => { App.edit("paste"); } }
            MenuItem { title: "Select All"; shortcut: @keys(Control + A); activated => { App.edit("select-all"); } }
        }

        Menu {
            title: "Playback";
            MenuItem {
                title: "Play/Pause";
                shortcut: @keys(Control + P);
                activated => {
                    App.toggle-play();
                }
            }

            MenuItem {
                title: "Next";
                shortcut: @keys(Control + RightArrow);
                activated => {
                    App.next();
                }
            }

            MenuItem {
                title: "Previous";
                shortcut: @keys(Control + LeftArrow);
                activated => {
                    App.prev();
                }
            }

            MenuSeparator { }

            MenuItem {
                title: "Shuffle";
                shortcut: @keys(Control + S);
                activated => {
                    App.toggle-shuffle();
                }
            }

            MenuItem {
                title: "Repeat";
                shortcut: @keys(Control + R);
                activated => {
                    App.cycle-repeat();
                }
            }
        }

        Menu {
            title: "View";
            MenuItem {
                title: "Settings…";
                shortcut: @keys(Control + ",");
                activated => {
                    App.navigate("settings");
                }
            }

            MenuItem {
                title: "Now Playing";
                shortcut: @keys(Control + L);
                activated => {
                    App.open-now-playing();
                }
            }
        }

        Menu {
            title: "Navigation";
            MenuItem {
                title: "Back";
                shortcut: @keys(Control + "[");
                activated => { App.back(); }
            }
            MenuItem {
                title: "Forward";
                shortcut: @keys(Control + "]");
                activated => { App.forward(); }
            }
            MenuItem {
                title: "Search";
                shortcut: @keys(Control + F);
                activated => { App.navigate("focus-search"); }
            }
            MenuSeparator { }
            // Esc returns to the home page, as a new history entry.
            MenuItem {
                title: "Music";
                shortcut: @keys(Escape);
                activated => {
                    if (App.track-menu-open) { App.escape-track-menu(); }
                    else { App.navigate("home"); }
                }
            }
            MenuItem { title: "Explore"; activated => { App.navigate("explore"); } }
            MenuItem { title: "Feed"; activated => { App.navigate("feed"); } }
            MenuSeparator { }
            MenuItem { title: "Mixes & Radio"; activated => { App.navigate("mixes"); } }
            MenuItem { title: "Playlists"; activated => { App.navigate("playlists"); } }
            MenuItem { title: "Albums"; activated => { App.navigate("albums"); } }
            MenuItem { title: "Tracks"; activated => { App.navigate("tracks"); } }
            MenuItem { title: "Videos"; activated => { App.navigate("videos"); } }
            MenuItem { title: "Profiles"; activated => { App.navigate("profiles"); } }
            MenuItem { title: "Save for Later"; activated => { App.navigate("later"); } }
        }

        Menu {
            title: "Window";
            MenuItem {
                title: "Minimize";
                shortcut: @keys(Control + M);
                activated => {
                    App.minimize();
                }
            }
        }

        Menu {
            title: "Help";
            MenuItem { title: "TIDAL Help"; activated => { App.open-help(); } }
        }
    }

    if !App.logged-in: LoginView { }
    if App.logged-in: VerticalLayout {
        HorizontalLayout {
            Sidebar { }

            Rectangle {
                background: Theme.bg;
                clip: true;

                // Where the page pane sits in the window, for the snapshots
                // that back/forward transitions are drawn from.
                property <length> pane-x: self.absolute-position.x;
                property <length> pane-y: self.absolute-position.y;
                property <length> pane-w: self.width;
                property <length> pane-h: self.height;
                init => {
                    App.pane-x = self.pane-x;
                    App.pane-y = self.pane-y;
                    App.pane-width = self.pane-w;
                    App.pane-height = self.pane-h;
                }
                changed pane-x => { App.pane-x = self.pane-x; }
                changed pane-y => { App.pane-y = self.pane-y; }
                changed pane-w => { App.pane-width = self.pane-w; }
                changed pane-h => { App.pane-height = self.pane-h; }

                Rectangle {
                    y: App.view == "album" || App.view == "artist" ? 0px : 64px;
                    height: parent.height - self.y;
                    if App.view == "home": HomeView { }
                    if App.view == "tracks" || App.view == "detail" || App.view == "album" || App.view == "artist" || App.view == "search" || App.view == "queue": TracksView { }
                    if App.view == "grid": GridView { }
                    if App.view == "stub": StubView { }
                    if App.view == "settings": SettingsView { }
                }

                // Back / forward transition. Two panes drawn from page
                // snapshots: the top one slides sideways with the swipe, the
                // one underneath grows from 75% and fades in from dark. Only
                // position, size and opacity change; the bars stay still.
                if App.nav-active: Rectangle {
                    background: black;
                    opacity: App.nav-fade;
                    // Clicks do not reach the page while it is covered.
                    TouchArea { }

                    Rectangle {
                        property <float> grow: 0.75 + 0.25 * App.nav-reveal;
                        width: parent.width * self.grow;
                        height: parent.height * self.grow;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        opacity: App.nav-reveal;
                        background: Theme.bg;
                        if App.nav-has-under: Image {
                            width: 100%;
                            height: 100%;
                            source: App.nav-under;
                            image-fit: fill;
                        }
                    }

                    // Soft edge shadow so the top pane reads as sitting above.
                    Rectangle {
                        x: top-pane.x - self.width;
                        width: 28px;
                        opacity: 1 - App.nav-reveal;
                        background: @linear-gradient(90deg, #00000000 0%, #00000080 100%);
                    }

                    top-pane := Rectangle {
                        x: parent.width * App.nav-reveal;
                        width: parent.width;
                        background: Theme.bg;
                        if App.nav-has-over: Image {
                            width: 100%;
                            height: 100%;
                            source: App.nav-over;
                            image-fit: fill;
                        }
                    }
                }

                TopBar {
                    y: 0;
                    // Left out of page snapshots: it never moves with a pane.
                    visible: !App.capturing;
                }
            }
        }

        PlayerBar { }
    }
    if App.logged-in && App.show-now-playing && !App.capturing: NowPlayingView {
        PlayerBar {
            y: parent.height - self.height;
            overlay: true;
        }
    }
    if App.logged-in && App.track-menu-open && !App.capturing: TrackMenu {
        width: parent.width;
        height: parent.height;
    }
}
