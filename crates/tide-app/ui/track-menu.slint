import { App, Theme, TrackData, Cover, Icon } from "common.slint";

// One trigger per track, one menu per window. Anchors use window coordinates.
export component TrackMenuButton inherits Rectangle {
    in property <string> track-id;
    property <string> opener;
    width: 34px;
    height: 34px;
    accessible-role: button;
    accessible-label: "Track options";
    accessible-action-default => { root.open-menu(); }

    public function open-at(x: length, y: length) {
        if (!root.track-id.is-empty) {
            root.opener = root.track-id;
            trigger.focus();
            App.request-track-menu(root.track-id, x, y);
        }
    }

    function open-menu() {
        root.open-at(self.absolute-position.x, self.absolute-position.y + self.height);
    }

    property <bool> menu-open: App.track-menu-open;
    changed menu-open => {
        if (!App.track-menu-open && !root.opener.is-empty) {
            if (root.opener == root.track-id) {
                trigger.focus();
            }
            root.opener = "";
        }
    }

    trigger := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                root.open-menu();
                return accept;
            }
            return reject;
        }
    }
    area := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.open-menu(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.open-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    Icon {
        source: @image-url("icons/more.svg");
        size: 18px;
        tint: trigger.has-focus ? Theme.text : Theme.text-secondary;
    }
    background: area.has-hover ? #ffffff12 : transparent;
    border-radius: 5px;
    border-width: trigger.has-focus ? 1px : 0px;
    border-color: Theme.text-secondary;
}

component MenuEntry inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> available: true;
    in property <bool> flyout;
    callback entered();
    callback activate();
    height: 38px;
    border-radius: 5px;
    background: selected && available ? #383838 : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-enabled: available;
    accessible-action-default => { if (root.available) { root.activate(); } }

    area := TouchArea {
        enabled: root.available;
        mouse-cursor: pointer;
        changed has-hover => { if (self.has-hover) { root.entered(); } }
        clicked => { root.activate(); }
    }
    Icon {
        x: 10px;
        source: root.icon;
        size: 17px;
        tint: root.available ? Theme.text-secondary : Theme.text-dim;
    }
    Text {
        x: 38px;
        width: parent.width - 65px;
        text: root.label;
        color: root.available ? Theme.text : Theme.text-dim;
        font-size: 14px;
        overflow: elide;
    }
    if flyout: Icon {
        x: parent.width - 24px;
        source: @image-url("icons/chevron-right.svg");
        size: 14px;
    }
}

export component TrackMenu inherits Rectangle {
    in property <TrackData> track: App.track-menu-track;
    property <int> selected: 0;
    property <bool> share-open <=> App.track-menu-share-open;
    property <bool> share-focused: false;
    property <length> margin: 8px;
    property <length> flyout-width: 170px;

    init => {
        root.share-open = false;
        keys.focus();
    }

    changed share-open => {
        if (!root.share-open) { root.share-focused = false; }
    }

    function dismiss() {
        App.track-menu-open = false;
    }

    pure function enabled(index: int) -> bool {
        return (index != 2 || !track.album-id.is-empty) && (index != 3 || !track.artist-id.is-empty);
    }

    function move-selection(step: int) {
        share-open = false;
        share-focused = false;
        selected = mod(selected + step + 5, 5);
        if (!root.enabled(selected)) { selected = mod(selected + step + 5, 5); }
        if (!root.enabled(selected)) { selected = mod(selected + step + 5, 5); }
    }

    function activate(index: int) {
        if (index == 4) {
            share-open = true;
            share-focused = true;
        } else if (root.enabled(index)) {
            root.dismiss();
            if (index == 0) { App.play-track-next(track.id); }
            if (index == 1) { App.toggle-favorite(track.id); }
            if (index == 2) { App.open-track-album(track); }
            if (index == 3) { App.open-track-artist(track); }
        }
    }

    function copy-link() {
        root.dismiss();
        App.copy-track-link(track.id);
    }

    TouchArea {
        clicked => { root.dismiss(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.up && e.button == PointerEventButton.right) {
                root.dismiss();
            }
        }
        scroll-event(_) => { return accept; }
    }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                App.escape-track-menu();
                return accept;
            }
            if (event.text == Key.UpArrow || event.text == Key.DownArrow || event.text == Key.Tab) {
                root.move-selection(event.text == Key.UpArrow || event.modifiers.shift ? -1 : 1);
                return accept;
            }
            if (event.text == Key.RightArrow && root.selected == 4) {
                root.activate(4);
                return accept;
            }
            if (event.text == Key.LeftArrow && root.share-open) {
                root.share-open = false;
                root.share-focused = false;
                return accept;
            }
            if (event.text == Key.Return || event.text == Key.Space) {
                if (root.share-focused) { root.copy-link(); }
                else { root.activate(root.selected); }
                return accept;
            }
            return reject;
        }
    }

    menu := Rectangle {
        x: clamp(App.track-menu-x, root.margin, root.width - self.width - root.margin);
        y: clamp(App.track-menu-y, root.margin, root.height - self.height - root.margin);
        width: 272px;
        height: 272px;
        background: #242424;
        border-color: #393939;
        border-width: 1px;
        border-radius: 12px;
        accessible-role: groupbox;
        accessible-label: "Track options";

        TouchArea { scroll-event(_) => { return accept; } }

        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: 72px;
            background: #1c1c1c;
            border-radius: 11px;
            Cover {
                x: 12px;
                width: 48px;
                height: 48px;
                radius: 4px;
                source: root.track.cover;
            }
            VerticalLayout {
                x: 72px;
                width: parent.width - 84px;
                alignment: center;
                spacing: 3px;
                Text {
                    text: root.track.title;
                    font-size: 14px;
                    font-weight: Theme.demibold;
                    color: Theme.text;
                    overflow: elide;
                }
                Text {
                    text: root.track.artist;
                    font-size: 13px;
                    color: Theme.text-secondary;
                    overflow: elide;
                }
            }
        }

        for entry[index] in [
            { label: "Play next", icon: @image-url("icons/queue.svg") },
            { label: root.track.favorite ? "Remove from My Collection" : "Add to My Collection", icon: root.track.favorite ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg") },
            { label: "Go to album", icon: @image-url("icons/disc.svg") },
            { label: "Go to artist", icon: @image-url("icons/user.svg") },
            { label: "Share", icon: @image-url("icons/share.svg") },
        ]: MenuEntry {
            x: 6px;
            y: 76px + index * 38px;
            width: parent.width - 12px;
            label: entry.label;
            icon: entry.icon;
            available: root.enabled(index);
            selected: root.selected == index;
            flyout: index == 4;
            entered => {
                root.selected = index;
                root.share-open = index == 4;
                root.share-focused = false;
            }
            activate => { root.activate(index); }
        }
    }

    if share-open: Rectangle {
        x: menu.x + menu.width + root.flyout-width <= root.width - root.margin
            ? menu.x + menu.width - 1px : menu.x - root.flyout-width + 1px;
        y: min(menu.y + 224px, root.height - self.height - root.margin);
        width: root.flyout-width;
        height: 50px;
        background: #242424;
        border-color: #393939;
        border-width: 1px;
        border-radius: 8px;
        accessible-role: groupbox;
        accessible-label: "Share";

        TouchArea { scroll-event(_) => { return accept; } }
        MenuEntry {
            x: 6px;
            y: 6px;
            width: parent.width - 12px;
            label: "Copy link";
            icon: @image-url("icons/link.svg");
            selected: root.share-focused;
            entered => { root.share-focused = true; }
            activate => { root.copy-link(); }
        }
    }
}
