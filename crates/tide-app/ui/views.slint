// Main content views.
import { ScrollView } from "std-widgets.slint";
import { TrackMenuButton } from "track-menu.slint";
import { MaxLogin } from "settings.slint";
import { App, Theme, EditableInput, Icon, IconButton, Cover, CardArt, CardData, TrackData, SectionData, ExplicitBadge, PillButton, DragArea } from "common.slint";

// ---------------------------------------------------------------- cards

component MediaCard inherits Rectangle {
    in property <CardData> card;
    height: self.width + 76px;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            App.open-card(root.card);
        }
    }

    CardArt {
        x: 0;
        y: 0;
        width: root.width;
        height: root.width;
        card: root.card;
        opacity: ta.has-hover ? 0.8 : 1.0;
    }

    Text {
        x: 0;
        y: root.width + 12px;
        width: root.width;
        text: card.title;
        color: Theme.text;
        font-size: 15px;
        font-weight: 500;
        overflow: elide;
        horizontal-alignment: card.kind == "artist" ? center : left;
    }

    Text {
        x: 0;
        y: root.width + 35px;
        width: root.width;
        height: 42px;
        text: card.subtitle;
        color: Theme.text-secondary;
        font-size: 15px;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: top;
        horizontal-alignment: card.kind == "artist" ? center : left;
    }
}

// Compact tile: artwork left, two lines of text.
component RowCard inherits Rectangle {
    in property <CardData> card;
    in property <bool> tile: false;
    in property <length> art: 48px;
    height: tile ? 66px : 62px;
    border-radius: 4px;
    background: tile ? (ta.has-hover ? #1e1e1e : Theme.surface) : (ta.has-hover ? #111111 : transparent);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            App.open-card(root.card);
        }
    }

    CardArt {
        x: tile ? 9px : 0px;
        width: root.art;
        height: root.art;
        card: root.card;
        radius: 3px;
    }

    VerticalLayout {
        x: (tile ? 9px : 0px) + root.art + 13px;
        width: root.width - self.x - 12px;
        alignment: center;
        spacing: 3px;
        Text {
            text: card.title;
            color: Theme.text;
            font-size: tile ? 13.5px : 15px;
            font-weight: tile ? 600 : 500;
            overflow: elide;
        }

        if card.subtitle != "": Text {
            text: card.subtitle;
            color: Theme.text-secondary;
            font-size: tile ? 13px : 15px;
            overflow: elide;
        }
    }
}

component RowTrack inherits Rectangle {
    in property <TrackData> track;
    callback play();
    property <bool> active: track.id == App.current-id;
    height: 62px;
    border-radius: 4px;
    background: ta.has-hover ? #111111 : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                more.open-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            root.play();
        }
    }

    Cover {
        x: 0;
        width: 62px;
        height: 62px;
        source: track.cover;
        radius: 3px;
    }

    VerticalLayout {
        x: 75px;
        width: root.width - 75px - 56px;
        alignment: center;
        spacing: 3px;
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Text {
                text: track.title;
                color: active ? App.accent : Theme.text;
                font-size: 15px;
                font-weight: 500;
                overflow: elide;
            }

            if track.explicit: VerticalLayout {
                alignment: center;
                ExplicitBadge { }
            }
        }

        Text {
            text: track.artist;
            color: Theme.text-secondary;
            font-size: 15px;
            overflow: elide;
        }
    }

    more := TrackMenuButton {
        x: root.width - 44px;
        track-id: track.id;
    }
}

component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <bool> arrows: false;
    in property <bool> view-all: true;
    in property <bool> can-prev: false;
    in property <bool> can-next: false;
    callback prev();
    callback next();
    callback show-all();
    height: 34px;
    Text {
        x: 0;
        text: root.title;
        color: Theme.text;
        font-size: 20px;
        font-weight: 700;
        vertical-alignment: center;
    }

    HorizontalLayout {
        x: root.width - self.width - 10px;
        width: self.preferred-width;
        spacing: 10px;
        if root.arrows: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: #141414;
                IconButton {
                    icon: @image-url("icons/chevron-left.svg");
                    size: 14px;
                    enabled: root.can-prev;
                    tint: Theme.text;
                    clicked => {
                        root.prev();
                    }
                }
            }
        }
        if root.arrows: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: #141414;
                IconButton {
                    icon: @image-url("icons/chevron-right.svg");
                    size: 14px;
                    enabled: root.can-next;
                    tint: Theme.text;
                    clicked => {
                        root.next();
                    }
                }
            }
        }
        if root.view-all: Text {
            text: "View all";
            color: all-link.has-hover ? Theme.text : Theme.text-secondary;
            font-size: 14px;
            font-weight: Theme.medium;
            vertical-alignment: center;
            all-link := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.show-all(); }
            }
        }
    }
}

// Reports once (and on paging) that a home section is near the viewport, so
// artwork is only fetched and decoded for what can actually be seen.
component ArtRequest inherits Rectangle {
    in property <int> upto;
    callback request(int, int);
    in property <length> window-height: 1200px;
    property <bool> near: self.absolute-position.y < window-height + 300px && self.absolute-position.y + self.height > -300px;
    property <int> reported: 0;
    public function reset() { reported = 0; }
    Timer {
        interval: 150ms;
        running: near && reported < upto;
        triggered => {
            root.request(reported, upto);
            reported = upto;
        }
    }
}

component Carousel inherits Rectangle {
    in property <SectionData> section;
    in property <bool> view-all: true;
    callback request-art(int, int);
    changed section => { artwork.reset(); }
    property <length> gap: 17px;
    property <int> per-page: max(2, floor((self.width + gap) / (200px + gap)));
    property <length> card-w: (self.width - (per-page - 1) * gap) / per-page;
    property <int> offset: 0;
    property <int> max-offset: max(0, section.cards.length - per-page);
    height: 34px + 16px + card-w + 76px;
    artwork := ArtRequest {
        upto: min(root.offset, root.max-offset) + root.per-page + 1;
        request(from, upto) => { root.request-art(from, upto); }
    }

    SectionHeader {
        y: 0;
        title: section.title;
        arrows: true;
        view-all: root.view-all;
        can-prev: root.offset > 0;
        can-next: root.offset < root.max-offset;
        prev => {
            root.offset = max(0, root.offset - root.per-page);
        }
        next => {
            root.offset = min(root.max-offset, root.offset + root.per-page);
        }
    }

    Rectangle {
        y: 50px;
        height: card-w + 76px;
        clip: true;
        Rectangle {
            x: -min(root.offset, root.max-offset) * (card-w + gap);
            width: section.cards.length * (card-w + gap);
            animate x {
                duration: 280ms;
                easing: ease-out;
            }
            for card[i] in section.cards: MediaCard {
                x: i * (card-w + gap);
                y: 0;
                width: card-w;
                card: card;
            }
        }
    }
}

component RowGrid inherits Rectangle {
    in property <SectionData> section;
    in property <int> section-index;
    in property <bool> tiles: false;
    property <int> cols: self.width > 760px ? 3 : 2;
    property <length> gap-x: tiles ? 9px : 30px;
    property <length> row-h: tiles ? 75px : 79px;
    property <length> col-w: (self.width - (cols - 1) * gap-x) / cols;
    property <int> count: section.layout == "tracks" ? section.tracks.length : section.cards.length;
    property <length> head: tiles ? 0px : 50px;
    height: head + ceil(count / cols) * row-h - (tiles ? 9px : 17px);
    ArtRequest {
        upto: 1000;
        request(from, upto) => { App.section-visible(root.section-index, upto); }
    }

    if !tiles: SectionHeader {
        y: 0;
        title: section.title;
    }
    if section.layout == "tracks": Rectangle {
        y: head;
        for track[i] in section.tracks: RowTrack {
            x: mod(i, cols) * (col-w + gap-x);
            y: floor(i / cols) * row-h;
            width: col-w;
            track: track;
            play => {
                App.play-section-track(root.section-index, track.id);
            }
        }
    }
    if section.layout != "tracks": Rectangle {
        y: head;
        for card[i] in section.cards: RowCard {
            x: mod(i, cols) * (col-w + gap-x);
            y: floor(i / cols) * row-h;
            width: col-w;
            card: card;
            tile: root.tiles;
            art: root.tiles ? 48px : 62px;
        }
    }
}

component Spinner inherits Rectangle {
    height: 120px;
    Text {
        text: "Loading…";
        color: Theme.text-secondary;
        font-size: 15px;
    }
}

export component HomeView inherits Rectangle {
    property <length> pad: clamp((self.width - 900px) * 0.11, 24px, 83px);
    ScrollView {
        content-y <=> App.scroll-y;
        VerticalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            padding-top: 4px;
            padding-bottom: 48px;
            spacing: 0px;
            alignment: start;
            // Tabs
            Rectangle {
                height: 44px;
                HorizontalLayout {
                    alignment: start;
                    spacing: 18px;
                    for tab[i] in ["For you", "Staff Picks", "Uploads"]: Rectangle {
                        width: label.preferred-width;
                        label := Text {
                            text: tab;
                            color: i == 0 ? Theme.text : Theme.text-secondary;
                            font-size: 15px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }

                        if i == 0: Rectangle {
                            y: parent.height - 2px;
                            height: 2px;
                            background: white;
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: #161616;
                }
            }

            Rectangle {
                height: 35px;
            }

            if App.sections.length == 0: Spinner { }
            for section[i] in App.sections: VerticalLayout {
                padding-bottom: section.layout == "shortcuts" ? 44px : 38px;
                if section.layout == "shortcuts": RowGrid {
                    section: section;
                    section-index: i;
                    tiles: true;
                }
                if section.layout == "cards": Carousel {
                    section: section;
                    request-art(from, upto) => { App.section-visible(i, upto); }
                }
                if section.layout == "rows" || section.layout == "tracks": RowGrid {
                    section: section;
                    section-index: i;
                }
            }
        }
    }
}

// ---------------------------------------------------------------- track table

component HeaderLabel inherits Text {
    color: Theme.text-header;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.6px;
    vertical-alignment: center;
}

component Cell inherits Text {
    color: Theme.text;
    font-size: 15px;
    font-weight: 500;
    overflow: elide;
    vertical-alignment: center;
}

component LinkedCell inherits Cell {
    in property <bool> link-enabled;
    callback activated();
    callback context-requested(length, length);

    font-weight: Theme.demibold;

    Rectangle {
        x: 0;
        y: root.height / 2 + root.font-size / 2 + 1px;
        width: link.width;
        height: 1px;
        background: root.color;
        visible: link.enabled && link.has-hover;
    }

    link := TouchArea {
        x: 0;
        width: max(0px, min(root.width, root.preferred-width));
        enabled: root.link-enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context-requested(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => { root.activated(); }
    }
}

component TrackRow inherits Rectangle {
    in property <TrackData> track;
    in property <int> index;
    in property <bool> show-bpm;
    in property <bool> show-date;
    in property <bool> album-page;
    in property <bool> artist-page;
    in property <length> x-artist;
    in property <length> x-album;
    in property <length> x-date;
    in property <length> x-time;
    in property <length> x-bpm;
    property <bool> active: track.id == App.current-id;
    height: 53px;
    border-radius: 6px;
    background: ta.has-hover ? #121212 : transparent;
    ta := TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                more.open-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        double-clicked => {
            App.play-track(track.id);
        }
    }

    if !album-page: Cover {
        x: artist-page ? 0px : 46px;
        width: 46px;
        height: 46px;
        source: track.cover;
        // Rounded clipping creates an offscreen layer for each scrolling thumbnail.
        radius: 0px;
    }

    // Index / play affordance
    Rectangle {
        x: 0;
        width: 44px;
        if active && !ta.has-hover: Icon {
            source: @image-url("icons/volume.svg");
            size: 17px;
            tint: App.accent;
        }
        if !artist-page && !active && !ta.has-hover: Text {
            text: index + 1;
            color: #7c7c7c;
            font-size: 14px;
            font-weight: 500;
        }
        if ta.has-hover: IconButton {
            icon: active && App.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
            size: 15px;
            tint: Theme.text;
            context-requested(x, y) => { more.open-at(x, y); }
            clicked => {
                if (active) {
                    App.toggle-play();
                } else {
                    App.play-track(track.id);
                }
            }
        }
    }

    HorizontalLayout {
        x: album-page ? 46px : artist-page ? 60px : 105px;
        width: x-artist - self.x - 24px;
        alignment: start;
        spacing: 8px;
        Cell {
            text: track.title;
            color: active ? App.accent : Theme.text;
        }

        if track.explicit: VerticalLayout {
            alignment: center;
            ExplicitBadge { }
        }
    }

    LinkedCell {
        x: x-artist;
        width: (album-page ? x-time : x-album) - x-artist - 24px;
        text: track.artist;
        link-enabled: !track.artist-id.is-empty;
        context-requested(x, y) => { more.open-at(x, y); }
        activated => { App.open-track-artist(track); }
    }

    if !album-page: LinkedCell {
        x: x-album;
        width: (show-date ? x-date : x-time) - x-album - 20px;
        text: track.album;
        link-enabled: !track.album-id.is-empty;
        context-requested(x, y) => { more.open-at(x, y); }
        activated => { App.open-track-album(track); }
    }

    if show-date: Cell {
        x: x-date;
        width: x-time - x-date - 12px;
        text: track.date-added;
    }
    Cell {
        x: x-time;
        text: track.duration;
    }

    if show-bpm: Cell {
        x: x-bpm;
        text: track.bpm;
    }
    more := TrackMenuButton {
        x: root.width - 76px;
        track-id: track.id;
    }

    IconButton {
        x: root.width - 42px;
        icon: track.favorite ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
        size: 17px;
        tint: Theme.text;
        context-requested(x, y) => { more.open-at(x, y); }
        clicked => {
            App.toggle-favorite(track.id);
        }
    }
}

component TrackPlaceholder inherits Rectangle {
    in property <length> x-artist;
    in property <length> x-album;
    in property <length> x-time;
    height: 53px;
    background: transparent;

    Rectangle {
        x: 0;
        y: 3px;
        width: 46px;
        height: 46px;
        border-radius: 2px;
        background: #1c1c1c;
    }
    Rectangle {
        x: 60px;
        y: 22px;
        width: max(32px, min(180px, root.x-artist - 84px));
        height: 8px;
        border-radius: 4px;
        background: #242424;
    }
    Rectangle {
        x: root.x-artist;
        y: 22px;
        width: max(32px, min(132px, root.x-album - root.x-artist - 24px));
        height: 8px;
        border-radius: 4px;
        background: #242424;
    }
    Rectangle {
        x: root.x-album;
        y: 22px;
        width: max(32px, min(132px, root.x-time - root.x-album - 24px));
        height: 8px;
        border-radius: 4px;
        background: #242424;
    }
    Rectangle {
        x: root.x-time;
        y: 22px;
        width: 34px;
        height: 8px;
        border-radius: 4px;
        background: #242424;
    }
    Rectangle {
        x: root.width - 66px;
        y: 19px;
        width: 16px;
        height: 14px;
        border-radius: 3px;
        background: #242424;
    }
    Rectangle {
        x: root.width - 42px;
        y: 18px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #242424;
    }
}

export component TracksView inherits Rectangle {
    property <length> pad: clamp((self.width - 900px) * 0.12, 24px, 89px);
    property <length> w: self.width - 2 * pad;
    property <bool> album-page: App.view == "album";
    property <bool> artist-page: App.view == "artist";
    property <bool> about: artist-page && App.artist-tab == 2;
    property <bool> track-placeholders: artist-page && !about && App.loading && App.tracks.length < 5;
    property <int> row-count: artist-page ? (about ? 0 : track-placeholders ? 5 : min(5, App.tracks.length)) : App.tracks.length;
    property <bool> wide: w > 980px && !album-page;
    property <bool> show-bpm: wide && App.bpm-available && App.show-audio-metadata;
    property <bool> show-date: App.tracks-show-date && w > 760px;
    property <bool> has-cover: App.page-has-cover;
    property <bool> filterable: App.view == "tracks";
    property <length> row-h: 53px;
    // Vertical layout of the header block.
    property <length> top-inset: album-page || artist-page ? 64px : 0px;
    property <length> y-title: top-inset + (has-cover ? 4px : 8px);
    property <int> search-cols: w >= 900px ? 3 : 2;
    property <length> search-height: App.view == "search" && App.search-cards.length > 0
        ? 44px + ceil(App.search-cards.length / search-cols) * 66px : 0px;
    property <length> cover-size: album-page ? clamp(w * 0.25, 180px, 256px) : 218px;
    property <length> hero-h: artist-page ? clamp(w * 0.28, 218px, 352px) : has-cover ? cover-size : 38px;
    property <length> y-buttons: artist-page ? top-inset + hero-h - 46px : y-title + hero-h + (has-cover ? 28px : 24px) + search-height;
    property <length> y-filter: y-buttons + 53px + 36px;
    property <length> y-tabs: top-inset + hero-h + 22px;
    property <length> y-top-tracks: y-tabs + 70px;
    property <length> y-columns: artist-page ? y-top-tracks + 38px : filterable ? y-filter + 44px + 40px : y-buttons + 53px + 30px;
    property <length> header-h: y-columns + 36px;
    // Column positions (fractions measured from the official client).
    property <length> x-artist: album-page ? w * 0.49 : wide ? w * 0.324 : w * 0.40;
    property <length> x-album: wide ? w * 0.544 : w * 0.64;
    property <length> x-date: w * 0.724;
    property <length> x-time: show-bpm ? w * 0.839 : w - 150px;
    property <length> x-bpm: w * 0.891;
    // Hand-rolled virtualisation so the header scrolls with the rows.
    property <int> first: max(0, floor((-sv.content-y - header-h) / row-h));
    property <int> visible-rows: ceil(self.height / row-h) + 2;
    changed first => {
        App.rows-visible(first, visible-rows);
    }
    changed visible-rows => {
        App.rows-visible(first, visible-rows);
    }
    sv := ScrollView {
        content-y <=> App.scroll-y;
        content-width: root.width;
        content-height: artist-page ? artist-content.y + artist-content.preferred-height + 32px
            : header-h + row-count * row-h + 48px;
        if artist-page || album-page: Rectangle {
            y: 0;
            width: root.width;
            height: top-inset + (artist-page ? hero-h + 14px : hero-h + 116px);
            clip: true;
            background: App.page-tint.darker(55%);
            if artist-page: Image {
                width: min(root.width * 0.60, parent.height);
                height: parent.height;
                source: App.page-cover;
                image-fit: cover;
                opacity: App.page-cover.width > 0 ? 1 : 0;
                animate opacity {
                    duration: 200ms;
                    easing: ease-in-out;
                }
            }
            Rectangle {
                background: @linear-gradient(180deg, #00000018 0%, #00000035 35%, #000000d9 82%, Theme.bg 100%);
            }
        }
        if has-cover && !artist-page: Cover {
            x: pad;
            y: y-title;
            width: cover-size;
            height: cover-size;
            source: App.page-cover;
            radius: 4px;
        }
        Text {
            x: has-cover && !artist-page ? pad + cover-size + 32px : pad;
            y: artist-page ? y-buttons - 53px : album-page ? y-title + cover-size * 0.23 : has-cover ? y-title + 74px : y-title;
            width: root.width - self.x - pad;
            height: has-cover ? 44px : 38px;
            text: App.page-title;
            color: Theme.text;
            font-size: has-cover ? 36px : 28px;
            font-weight: Theme.bold;
            overflow: elide;
            vertical-alignment: center;
        }

        if has-cover && !artist-page: Text {
            x: pad + cover-size + 32px;
            y: album-page ? y-title + cover-size * 0.23 + 48px : y-title + 124px;
            width: root.width - self.x - pad;
            text: App.page-subtitle;
            color: album-page && App.page-artist.id != "" ? Theme.text : Theme.text-secondary;
            font-size: 15px;
            font-weight: Theme.medium;
            overflow: elide;
            TouchArea {
                width: min(parent.width, parent.preferred-width);
                enabled: album-page && App.page-artist.id != "";
                mouse-cursor: pointer;
                clicked => { App.open-card(App.page-artist); }
            }
        }
        if album-page: VerticalLayout {
            x: pad + cover-size + 32px;
            y: y-title + cover-size * 0.23 + 84px;
            width: max(0px, root.width - self.x - pad);
            height: self.preferred-height;
            spacing: 10px;
            Text {
                text: App.page-summary;
                color: Theme.text-secondary;
                font-size: 12px;
                font-weight: Theme.medium;
                letter-spacing: 1px;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 12px;
                Text {
                    text: App.page-year;
                    color: Theme.text-secondary;
                    font-size: 13px;
                }
                if App.page-quality != "": Text {
                    text: App.page-quality;
                    color: App.page-quality == "MAX" ? Theme.max : App.page-quality == "LOSSLESS" ? Theme.lossless : Theme.text-secondary;
                    font-size: 12px;
                    font-weight: Theme.bold;
                    letter-spacing: 1px;
                }
            }
        }
        if search-height > 0px: Rectangle {
            x: pad;
            y: y-title + hero-h + 12px;
            width: w;
            height: search-height;
            property <length> tile-w: (w - (search-cols - 1) * 12px) / search-cols;
            SectionHeader {
                y: 0;
                title: "Artists & Albums";
                view-all: false;
            }
            for card[i] in App.search-cards: RowCard {
                x: mod(i, search-cols) * (parent.tile-w + 12px);
                y: 38px + floor(i / search-cols) * 66px;
                width: parent.tile-w;
                card: card;
                tile: true;
            }
        }
        if artist-page: Rectangle {
            x: pad;
            y: y-buttons;
            width: 48px;
            height: 48px;
            border-radius: 24px;
            background: artist-play.has-hover ? #dedede : white;
            Icon {
                source: @image-url("icons/play.svg");
                size: 20px;
                tint: black;
            }
            artist-play := TouchArea {
                enabled: App.tracks.length > 0;
                mouse-cursor: pointer;
                clicked => { App.play-all(false); }
            }
        }
        if !artist-page: PillButton {
            x: pad;
            y: y-buttons;
            text: "Play";
            icon: @image-url("icons/play.svg");
            primary: true;
            clicked => {
                App.play-all(false);
            }
        }

        if !artist-page: PillButton {
            x: pad + 176px + 18px;
            y: y-buttons;
            text: "Shuffle";
            icon: @image-url("icons/shuffle.svg");
            clicked => {
                App.play-all(true);
            }
        }

        if artist-page: Rectangle {
            x: pad;
            y: y-tabs;
            width: w;
            height: 46px;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 24px;
                for tab[i] in ["All", "Music", "About"]: Rectangle {
                    width: artist-label.preferred-width;
                    artist-label := Text {
                        text: tab;
                        font-size: 14px;
                        font-weight: Theme.medium;
                        color: App.artist-tab == i ? Theme.text : Theme.text-secondary;
                        vertical-alignment: center;
                    }
                    if App.artist-tab == i: Rectangle {
                        y: parent.height - 2px;
                        height: 2px;
                        background: Theme.text;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { App.artist-tab = i; }
                    }
                }
            }
        }
        if artist-page && !about: SectionHeader {
            x: pad;
            y: y-top-tracks;
            width: w;
            title: "Top Tracks";
            view-all: App.tracks.length > 4;
            show-all => { App.show-artist-tracks(); }
        }

        if filterable: Rectangle {
            x: pad;
            y: y-filter;
            width: w;
            height: 44px;
            border-radius: 8px;
            border-width: 1px;
            border-color: filter.has-focus ? #3a3a3a : Theme.border;
            Icon {
                x: 16px;
                source: @image-url("icons/search.svg");
                size: 16px;
            }

            if filter.text == "": Text {
                x: 49px;
                text: "Filter tracks";
                color: #aeafb2;
                font-size: 15px;
                vertical-alignment: center;
            }
            filter := EditableInput {
                x: 49px;
                width: parent.width - 65px;
                height: 20px;
                text <=> App.filter-text;
                color: Theme.text;
                font-size: 15px;
                single-line: true;
                vertical-alignment: center;
                selection-background-color: #4a4a4a;
                edited => {
                    App.filter(self.text);
                }
            }
        }
        if !about: Rectangle {
            x: pad;
            y: y-columns;
            width: w;
            height: 36px;
            if !artist-page: HeaderLabel {
                x: 0;
                width: 44px;
                text: "#";
                horizontal-alignment: center;
            }

            HeaderLabel {
                x: artist-page ? 60px : 46px;
                text: "TITLE";
            }

            HeaderLabel {
                x: x-artist;
                text: "ARTIST";
            }

            if !album-page: HeaderLabel {
                x: x-album;
                text: "ALBUM";
            }

            if show-date: HeaderLabel {
                x: x-date;
                text: "DATE ADDED";
            }
            if show-date: Icon {
                x: x-date + 91px;
                source: @image-url("icons/chevron-down.svg");
                size: 14px;
                tint: Theme.lossless;
            }
            HeaderLabel {
                x: x-time;
                text: "TIME";
            }

            if show-bpm: HeaderLabel {
                x: x-bpm;
                text: "BPM";
            }
        }

        for i in root.visible-rows: Rectangle {
            x: pad;
            y: header-h + (first + i) * row-h;
            width: w;
            height: row-h;
            background: transparent;
            visible: first + i < row-count;
            if first + i < App.tracks.length: TrackRow {
                width: parent.width;
                track: App.tracks[first + i];
                index: first + i;
                album-page: root.album-page;
                artist-page: root.artist-page;
                show-bpm: root.show-bpm;
                show-date: root.show-date;
                x-artist: root.x-artist;
                x-album: root.x-album;
                x-date: root.x-date;
                x-time: root.x-time;
                x-bpm: root.x-bpm;
            }
            if root.track-placeholders && first + i >= App.tracks.length: TrackPlaceholder {
                width: parent.width;
                x-artist: root.x-artist;
                x-album: root.x-album;
                x-time: root.x-time;
            }
        }
        if !about && App.tracks.length == 0 && !root.track-placeholders: Text {
            x: pad;
            y: header-h + 24px;
            text: App.loading ? "Loading…" : App.catalog-error ? "Couldn’t load tracks" : "Nothing here yet";
            color: Theme.text-secondary;
            font-size: 15px;
        }
        artist-content := VerticalLayout {
            x: pad;
            y: about ? y-tabs + 62px : header-h + row-count * row-h + (row-count == 0 ? 58px : 20px);
            width: w;
            height: self.preferred-height;
            spacing: 16px;
            if artist-page && !about && App.artist-albums.length > 0: Carousel {
                section: { title: "Albums", cards: App.artist-albums };
                view-all: false;
                request-art(from, upto) => { App.artist-release-art(false, from, upto); }
            }
            if artist-page && !about && App.artist-singles.length > 0: Carousel {
                section: { title: "EPs & Singles", cards: App.artist-singles };
                view-all: false;
                request-art(from, upto) => { App.artist-release-art(true, from, upto); }
            }
            if artist-page && App.artist-tab != 1 && (about || App.page-biography != ""): VerticalLayout {
                spacing: 12px;
                SectionHeader {
                    title: "Biography";
                    view-all: false;
                }
                Text {
                    width: min(720px, parent.width);
                    text: App.page-biography == "" ? "No biography available" : App.page-biography;
                    color: Theme.text-secondary;
                    font-size: 15px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// ---------------------------------------------------------------- card grid

export component GridView inherits Rectangle {
    property <length> pad: clamp((self.width - 900px) * 0.12, 24px, 90px);
    property <length> w: self.width - 2 * pad;
    property <length> gap: 18px;
    property <int> cols: max(2, floor((w + gap) / (236px + gap)));
    property <length> card-w: (w - (cols - 1) * gap) / cols;
    property <length> cell-h: card-w + 76px + 64px;
    ScrollView {
        content-y <=> App.scroll-y;
        content-width: root.width;
        content-height: 82px + ceil(App.grid-cards.length / cols) * cell-h + 24px;
        HorizontalLayout {
            x: pad;
            y: 8px;
            height: 38px;
            width: self.preferred-width;
            spacing: 22px;
            Text {
                text: App.page-title;
                color: Theme.text;
                font-size: 28px;
                font-weight: 700;
                vertical-alignment: center;
            }

            VerticalLayout {
                alignment: center;
                Icon {
                    source: @image-url("icons/more.svg");
                    size: 22px;
                    tint: Theme.text-secondary;
                }
            }
        }

        for card[i] in App.grid-cards: MediaCard {
            x: pad + mod(i, cols) * (card-w + gap);
            y: 82px + floor(i / cols) * cell-h;
            width: card-w;
            card: card;
        }
        if App.grid-cards.length == 0: Text {
            x: pad;
            y: 100px;
            text: App.loading ? "Loading…" : "Nothing here yet";
            color: Theme.text-secondary;
            font-size: 15px;
        }
    }
}

export component StubView inherits Rectangle {
    VerticalLayout {
        alignment: center;
        spacing: 10px;
        Text {
            text: App.page-title;
            color: Theme.text;
            font-size: 28px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: "This section isn't available in tidal-rust yet.";
            color: Theme.text-secondary;
            font-size: 15px;
            horizontal-alignment: center;
        }
    }
}

// ---------------------------------------------------------------- now playing

export component NowPlayingView inherits Rectangle {
    background: #1a1a1a;
    Rectangle {
        background: @linear-gradient(180deg, App.np-tint 0%, App.np-tint.darker(0.6) 55%, #1a1716 100%);
    }

    // Swallow clicks so they don't reach the view underneath.
    TouchArea { }

    DragArea {
        y: 0;
        height: 64px;
    }

    property <length> art: min(self.height - 96px - 200px, self.width * 0.40);
    Cover {
        x: max(48px, root.width * 0.28 - self.width / 2);
        y: (root.height - 96px - self.height) / 2 + 20px;
        width: art;
        height: art;
        source: App.np-cover-large;
        radius: 2px;
        drop-shadow-blur: 60px;
        drop-shadow-color: #00000080;
    }

    VerticalLayout {
        x: root.width * 0.51;
        y: 96px;
        width: root.width * 0.37;
        height: root.height - 96px - 110px;
        alignment: center;
        spacing: 30px;
        if App.lyrics.length == 0: Text {
            text: App.lyrics-status;
            color: #ffffff80;
            font-size: 28px;
            font-weight: 700;
            wrap: word-wrap;
        }
        for line in App.lyrics: Text {
            text: line.text;
            color: line.active ? white : #ffffff66;
            font-size: line.active ? 42px : 38px;
            font-weight: 700;
            wrap: word-wrap;
        }
    }

    HorizontalLayout {
        x: root.width - self.width - 16px;
        y: 12px;
        width: self.preferred-width;
        height: 40px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 68px;
                height: 34px;
                border-radius: 17px;
                background: white;
                Text {
                    text: "Lyrics";
                    color: black;
                    font-size: 14px;
                    font-weight: 600;
                }
            }
        }

        IconButton {
            icon: @image-url("icons/chevron-down.svg");
            size: 18px;
            tint: #ffffffb0;
            clicked => {
                App.show-now-playing = false;
            }
        }
    }
}

// ---------------------------------------------------------------- login

export component LoginView inherits Rectangle {
    background: Theme.bg;
    DragArea {
        y: 0;
        height: 64px;
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 520px;
                height: 440px;
                border-radius: 16px;
                background: #0e0e0e;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 40px;
                    spacing: 18px;
                    alignment: center;
                    Text {
                        text: "T I D E";
                        color: Theme.text;
                        font-size: 30px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: App.user-code == "" ? "Log in to start listening in Max quality." : "Enter this code at link.tidal.com";
                        color: Theme.text-secondary;
                        font-size: 15px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    // Default: Max-quality login in the default browser.
                    if App.user-code == "": MaxLogin {
                        centered: true;
                    }
                    if App.user-code != "": Rectangle {
                        height: 72px;
                        border-radius: 10px;
                        background: #161616;
                        EditableInput {
                            text: App.user-code;
                            read-only: true;
                            color: Theme.lossless;
                            font-size: 34px;
                            font-weight: 700;
                            letter-spacing: 6px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    if App.user-code != "": HorizontalLayout {
                        alignment: center;
                        PillButton {
                            width: 240px;
                            text: "Open browser";
                            primary: true;
                            clicked => {
                                App.open-browser();
                            }
                        }
                    }
                    if App.auth-status != "": Text {
                        text: App.auth-status;
                        color: Theme.text-secondary;
                        font-size: 13px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    // Fallback: device code (TIDAL limits it to 16-bit, 44.1 kHz).
                    Rectangle {
                        height: 20px;
                        fallback := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                App.login();
                            }
                        }

                        Text {
                            text: "Trouble logging in? Use a device code instead (16-bit, 44.1 kHz only)";
                            color: fallback.has-hover ? Theme.text : Theme.text-secondary;
                            font-size: 13px;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
