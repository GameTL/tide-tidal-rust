// Main content views.
import { ScrollView } from "std-widgets.slint";
import { TrackMenuButton } from "context-menu.slint";
import { HeaderTools, SearchField, NavItem, SidebarPlaylist } from "chrome.slint";
import { MinimizeButton } from "common.slint";
import { MaxLogin } from "settings.slint";
import { App, Theme, EditableInput, Icon, Kbd, IconButton, DebugButton, Cover, CardArt, CardData, TrackData, TrackSortColumn, SectionData, ExplicitBadge, QualityBadge, TitleWithQuality, ArtistLinks, PillButton, DragArea, MenuPanel, MenuRow, CreateButton, Toggle, TideLoader } from "common.slint";

// ---------------------------------------------------------------- items
//
// Two kinds of item, each with one fixed behaviour wherever it appears:
//
//   GridItem  big artwork on top (carousels, grids, videos). Hover shows play /
//             heart / More on the artwork; the play button plays, the rest opens.
//   SlimItem  artwork left, two lines of text (shortcuts, feed rows, search,
//             artist releases). Hover fades the row and puts a play button on the
//             artwork; the artwork plays, the rest opens (a track plays), More
//             sits on the right.
//
// Every item speaks `CardData` and only calls App.play-card / App.open-card /
// App.request-card-menu. The controller decides what each kind means (a
// "track" card plays from the section it is in, and gets the track menu).

// Shared item helpers.
global Items {
    // A section track as a slim item.
    public pure function from-track(t: TrackData) -> CardData {
        return {
            id: t.id,
            kind: "track",
            title: t.title,
            subtitle: t.artist,
            image: t.cover,
            explicit: t.explicit,
            fresh: t.fresh,
        };
    }
    // Kinds that have a context menu.
    public pure function has-menu(kind: string) -> bool {
        return kind == "album" || kind == "playlist" || kind == "mix" || kind == "artist"
            || kind == "video" || kind == "folder" || kind == "track";
    }
    // Kinds that can be played straight from their artwork.
    public pure function playable(kind: string) -> bool {
        return kind != "page" && kind != "folder";
    }
}

// An item that arrived with a background refresh grows in on its own instead
// of the page redrawing.
component FreshItem inherits Rectangle {
    in property <bool> fresh;
    property <bool> shown: !root.fresh;
    property <float> pop: root.shown ? 1 : 0;
    animate pop { duration: 480ms; easing: cubic-bezier(0.34, 1.45, 0.64, 1); }
    opacity: min(1, root.pop * 1.5);
    transform-scale: 0.86 + 0.14 * root.pop;
    // A beat after the first frame, so the animation starts from 0.
    Timer {
        interval: 40ms;
        running: !root.shown;
        triggered => { root.shown = true; }
    }
}

// Pointer target for an item: right-click opens the item's menu where it was clicked.
component ItemTouch inherits TouchArea {
    in property <CardData> card;
    mouse-cursor: pointer;
    pointer-event(e) => {
        if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
            App.request-card-menu(root.card, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
    }
}

// Heart / More on cover: circular hover plate. Folders keep a filled plate.
component OverlayAction inherits Rectangle {
    in property <image> icon;
    in property <length> diameter: 40px;
    in property <length> icon-size: 16px;
    in property <bool> plate: false;
    out property <bool> hovered: ta.has-hover;
    callback clicked();
    callback context-requested(length, length);
    width: diameter;
    height: diameter;
    border-radius: diameter / 2;
    background: plate ? (ta.has-hover ? #3a3a3a : #2a2a2ae6) : (ta.pressed ? #3a3a3a : ta.has-hover ? #2a2a2ae6 : transparent);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context-requested(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        size: root.icon-size;
        tint: white;
    }
}

// GridItem artwork hover: Play / My Collection / More. Folders keep the teal
// tile and only show More.
component CoverHover inherits Rectangle {
    in property <CardData> card;
    in property <bool> show: false;
    in property <length> play-d: 40px;
    in property <length> inset: 10px;
    property <bool> folder: card.kind == "folder";
    property <bool> playing: App.playing-card-id == card.id && App.playing-card-kind == card.kind;
    property <bool> heart: card.kind == "album" || card.kind == "video" || (card.kind == "playlist" && card.by != "Me" && card.by != "");
    property <bool> playing-now: root.playing && App.playing;
    property <length> action-d: folder ? max(28px, min(36px, root.play-d * 0.8)) : root.play-d;
    property <length> action-icon: max(16px, root.action-d * 0.45);
    // Child buttons steal parent hover; keep the overlay up while any of them is hot.
    out property <bool> hovered: play-ta.has-hover || more-btn.hovered || heart-btn.hovered;
    property <bool> on: show || hovered;
    visible: on && card.kind != "page";
    background: folder ? transparent : #00000099;
    clip: true;

    play-btn := Rectangle {
        visible: root.on && !root.folder;
        x: root.inset;
        y: parent.height - root.inset - root.play-d;
        width: root.play-d;
        height: root.play-d;
        border-radius: root.play-d / 2;
        background: white;
        transform-scale: play-ta.has-hover ? 1.12 : 1;
        animate transform-scale { duration: 150ms; easing: ease-out; }
        play-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { App.play-card(root.card); }
        }
        Icon {
            source: root.playing-now ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
            size: root.play-d * 0.45;
            tint: black;
        }
    }

    more-btn := OverlayAction {
        visible: root.on && Items.has-menu(root.card.kind);
        x: parent.width - root.inset - self.width - (!root.folder && root.heart ? self.width + 4px : 0px);
        y: parent.height - root.inset - self.height;
        diameter: root.action-d;
        icon-size: root.action-icon;
        icon: @image-url("icons/more.svg");
        plate: root.folder;
        clicked => {
            App.request-card-menu(root.card, self.absolute-position.x, self.absolute-position.y + self.height);
        }
        context-requested(x, y) => { App.request-card-menu(root.card, x, y); }
    }

    heart-btn := OverlayAction {
        visible: root.on && root.heart;
        x: parent.width - root.inset - self.width;
        y: parent.height - root.inset - self.height;
        diameter: root.action-d;
        icon-size: root.action-icon;
        icon: card.favorite ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
        clicked => { App.toggle-card-favorite(root.card); }
        context-requested(x, y) => { App.request-card-menu(root.card, x, y); }
    }
}

// SlimItem artwork hover: a scrim and a centred play button fade in; the whole
// artwork plays the item.
component ArtPlay inherits Rectangle {
    in property <CardData> card;
    in property <bool> show: false;
    out property <bool> hovered: ta.has-hover;
    property <bool> live: Items.playable(root.card.kind);
    background: #000000a0;
    opacity: root.live && root.show ? 1 : 0;
    animate opacity { duration: 160ms; easing: ease-out; }
    clip: true;
    Rectangle {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: min(30px, root.width * 0.64);
        height: self.width;
        border-radius: self.width / 2;
        background: white;
        transform-scale: ta.has-hover ? 1.12 : 1;
        animate transform-scale { duration: 150ms; easing: ease-out; }
        Icon {
            // The triangle's optical centre sits right of its box centre.
            x: (parent.width - self.width) / 2 + 1px;
            y: (parent.height - self.height) / 2;
            source: @image-url("icons/play.svg");
            size: parent.width * 0.45;
            tint: black;
        }
    }
    // Not playable (folders, pages): clicks fall through to the row and open it.
    ta := ItemTouch {
        card: root.card;
        enabled: root.live;
        clicked => { App.play-card(root.card); }
    }
}

component GridItem inherits FreshItem {
    in property <CardData> card;
    // Shown as hovered: the card Enter in the grid filter plays.
    in property <bool> spotlight: false;
    // A grey panel behind the whole card on hover, as on track rows (grid pages).
    in property <bool> hover-panel: false;
    property <bool> lit: body.has-hover || spotlight;
    changed lit => {
        if (card.video-cover != "") {
            App.hover-art(card.kind + ":" + card.id, root.lit ? card.video-cover : "");
        }
    }
    // ↑ ↓ moved the pick here: scroll it into the pane.
    changed spotlight => {
        if (spotlight) {
            if (self.absolute-position.y - 12px < App.pane-y) {
                App.scroll-y = min(0px, App.scroll-y + (App.pane-y - self.absolute-position.y) + 24px);
            } else if (self.absolute-position.y + self.height + 12px > App.pane-y + App.pane-height - App.bar-inset) {
                App.scroll-y = App.scroll-y - (self.absolute-position.y + self.height - App.pane-y - App.pane-height + App.bar-inset) - 24px;
            }
        }
    }
    // On a grid page, one of the user's own playlists takes a dragged track
    // (App.drag-active). The area the drag started on keeps the pointer, so
    // the card finds it by position rather than by hover.
    in property <bool> drop-zone: false;
    property <bool> drop-on: drop-zone && App.drag-over-page && card.kind == "playlist" && card.by == "Me"
        && App.drag-x >= self.absolute-position.x && App.drag-x < self.absolute-position.x + self.width
        && App.drag-y >= self.absolute-position.y && App.drag-y < self.absolute-position.y + self.height;
    changed drop-on => {
        if (drop-on) {
            App.drop-target = card.id;
            App.drop-title = card.title;
            App.drop-source = "grid";
        } else if (App.drop-source == "grid" && App.drop-target == card.id) {
            App.drop-target = "";
            App.drop-title = "";
            App.drop-source = "";
        }
    }
    fresh: card.fresh;

    // Rearranged grids (pinning) glide: a card that moves is first drawn where
    // it was and slides to its new slot. Grid pages place cards with
    // slot-x / slot-y inside their group (group-y down the page); other users
    // of the item set x / y themselves and never move this way.
    in property <length> slot-x;
    in property <length> slot-y;
    in property <length> group-y;
    x: root.slot-x + root.fly-ox;
    y: root.slot-y + root.fly-oy;
    property <{x: length, y: length}> home: { x: root.slot-x, y: root.group-y + root.slot-y };
    property <{x: length, y: length}> last-home;
    property <string> key: card.kind + ":" + card.id;
    property <length> fly-dx;
    property <length> fly-dy;
    property <duration> fly-t0;
    property <bool> flying;
    property <float> fly-p: root.flying ? clamp((animation-tick() - root.fly-t0) / 250ms, 0, 1) : 1;
    // Ease in-out (cubic).
    property <float> fly-e: root.fly-p < 0.5 ? 4 * root.fly-p * root.fly-p * root.fly-p : 1 - pow(-2 * root.fly-p + 2, 3) / 2;
    property <length> fly-ox: root.flying ? root.fly-dx * (1 - root.fly-e) : 0px;
    property <length> fly-oy: root.flying ? root.fly-dy * (1 - root.fly-e) : 0px;
    z: root.flying ? 1 : 0;
    function fly-from(fx: length, fy: length) {
        root.fly-dx = fx - root.home.x;
        root.fly-dy = fy - root.home.y;
        root.fly-t0 = animation-tick();
        root.flying = true;
    }
    Timer {
        interval: 260ms;
        running: root.flying;
        triggered => { root.flying = false; }
    }
    init => {
        root.last-home = root.home;
        // The card just pinned or unpinned: from where its menu was opened.
        if (App.grid-reflow && App.fly-from-key == root.key) {
            root.fly-from(App.fly-from-x, App.fly-from-y);
        }
    }
    changed home => {
        if (App.grid-reflow && (abs(root.home.x - root.last-home.x) > 0.5px || abs(root.home.y - root.last-home.y) > 0.5px)) {
            root.fly-from(root.last-home.x + root.fly-ox, root.last-home.y + root.fly-oy);
        }
        root.last-home = root.home;
    }
    // Where the card sits while its menu is open, for Pin to fly it from.
    property <bool> menu-here: App.menu-open && App.menu-card.id == card.id && App.menu-card.kind == card.kind;
    changed menu-here => {
        if (root.menu-here) {
            App.fly-from-key = root.key;
            App.fly-from-x = root.home.x;
            App.fly-from-y = root.home.y;
        }
    }
    // Videos are 16:9 stills with a length line ("2 MIN") under the artists.
    property <bool> wide: card.kind == "video";
    property <length> art-h: wide ? self.width * 9 / 16 : self.width;
    height: self.art-h + (wide ? 100px : 76px);
    body := ItemTouch {
        card: root.card;
        clicked => { App.open-card(root.card); }
    }

    if root.hover-panel: Rectangle {
        x: -10px;
        y: -10px;
        width: root.width + 20px;
        height: root.height + 10px;
        border-radius: 8px;
        background: root.lit ? #121212 : transparent;
        animate background {
            duration: 160ms;
            easing: ease-out;
        }
    }

    if root.drop-on: Rectangle {
        x: -6px;
        y: -6px;
        width: root.width + 12px;
        height: root.height + 6px;
        border-radius: 8px;
        background: #1c1c1c;
        border-width: 1px;
        border-color: App.accent;
    }

    CardArt {
        x: 0;
        y: 0;
        width: root.width;
        height: root.art-h;
        card: root.card;
    }

    CoverHover {
        x: 0;
        y: 0;
        width: root.width;
        height: root.art-h;
        card: root.card;
        show: root.lit;
        play-d: root.wide ? min(56px, root.art-h * 0.36) : min(44px, root.width * 0.28);
        inset: max(8px, root.width * 0.05);
    }

    if card.kind == "artist": Text {
        x: 0;
        y: root.width + 12px;
        width: root.width;
        text: card.title;
        color: Theme.text;
        font-size: 15px;
        font-weight: 500;
        overflow: elide;
        horizontal-alignment: center;
    }

    if card.kind != "artist": TitleWithQuality {
        x: 0;
        y: root.art-h + 12px;
        width: root.width;
        height: 20px;
        title: card.title;
        // Grid / carousel: Max only — High / Low stay on the album page.
        quality: card.kind == "album" && card.quality == "MAX" ? card.quality : "";
        font-size: 15px;
        font-weight: Theme.medium;
    }

    subtitle := Text {
        x: 0;
        y: root.art-h + 35px;
        width: root.width;
        height: root.wide ? min(42px, self.preferred-height) : 42px;
        // An own playlist's "98 TRACKS" and a folder's count are small caps.
        property <bool> counted: card.kind == "folder" || (card.kind == "playlist" && card.by == "Me");
        text: card.subtitle;
        color: Theme.text-secondary;
        font-size: self.counted ? 11.5px : 15px;
        font-weight: self.counted ? Theme.medium : 400;
        letter-spacing: self.counted ? 0.8px : 0px;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: top;
        horizontal-alignment: card.kind == "artist" ? center : left;
    }

    if card.detail != "": Text {
        x: 0;
        y: subtitle.y + subtitle.height + 6px;
        width: root.width;
        text: card.detail;
        color: Theme.text-secondary;
        font-size: 12px;
        font-weight: Theme.demibold;
        letter-spacing: 1px;
    }
}

component SlimItem inherits FreshItem {
    in property <CardData> card;
    // Grey tile (Home shortcuts, search) rather than a bare list row.
    in property <bool> filled: false;
    // A narrow tile (two to a phone-width row) takes smaller artwork and
    // gives its text the room More would keep (More shows on hover, over it).
    property <bool> slim: root.width < 220px;
    in property <length> art: filled ? (root.slim ? 40px : 48px) : 62px;
    fresh: card.fresh;
    property <length> inset: filled ? (root.slim ? 8px : 9px) : 0px;
    property <length> art-radius: card.kind == "artist" ? root.art / 2 : 3px;
    // Child targets steal the row's hover; any of them keeps the row hot.
    property <bool> hot: body.has-hover || art-play.hovered || more.hovered;
    property <bool> active: card.kind == "track"
        ? App.current-id == card.id
        : App.playing-card-id == card.id && App.playing-card-kind == card.kind;
    height: filled ? 66px : 62px;
    border-radius: 4px;
    background: root.filled
        ? (root.hot ? #262626 : Theme.surface)
        : (root.hot ? #111111 : transparent);
    animate background { duration: 160ms; easing: ease-out; }

    body := ItemTouch {
        card: root.card;
        clicked => { App.open-card(root.card); }
    }

    CardArt {
        x: root.inset;
        width: root.art;
        height: root.art;
        card: root.card;
        radius: root.art-radius;
    }

    art-play := ArtPlay {
        x: root.inset;
        y: (parent.height - root.art) / 2;
        width: root.art;
        height: root.art;
        border-radius: root.art-radius;
        card: root.card;
        show: root.hot;
    }

    VerticalLayout {
        x: root.inset + root.art + (root.slim ? 10px : 13px);
        width: root.width - self.x - (root.slim ? 8px : 48px);
        alignment: center;
        spacing: 3px;
        TitleWithQuality {
            height: root.filled ? 18px : 20px;
            title: card.title;
            quality: card.kind == "album" && card.quality == "MAX" ? card.quality : "";
            explicit: card.explicit;
            title-color: root.active ? App.accent : Theme.text;
            font-size: root.filled ? 13.5px : 15px;
            font-weight: root.filled ? Theme.demibold : Theme.medium;
        }

        if card.subtitle != "": Text {
            property <bool> counted: card.kind == "folder" || (card.kind == "playlist" && card.by == "Me");
            text: card.subtitle;
            color: Theme.text-secondary;
            font-size: self.counted ? 11px : root.filled ? 13px : 15px;
            font-weight: self.counted ? Theme.medium : 400;
            letter-spacing: self.counted ? 0.8px : 0px;
            overflow: elide;
        }
    }

    more := OverlayAction {
        visible: root.hot && Items.has-menu(root.card.kind);
        x: root.width - self.width - 8px;
        y: (parent.height - self.height) / 2;
        diameter: 34px;
        icon-size: 16px;
        icon: @image-url("icons/more.svg");
        clicked => {
            App.request-card-menu(root.card, self.absolute-position.x, self.absolute-position.y + self.height);
        }
        context-requested(x, y) => { App.request-card-menu(root.card, x, y); }
    }
}

component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <bool> arrows: false;
    in property <bool> view-all: true;
    in property <bool> can-prev: false;
    in property <bool> can-next: false;
    callback prev();
    callback next();
    callback show-all();
    height: 34px;
    Text {
        x: 0;
        width: max(0px, root.width - (controls.width > 0 ? controls.width + 22px : 0px));
        text: root.title;
        color: Theme.text;
        font-size: 20px;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: center;
    }

    controls := HorizontalLayout {
        x: root.width - self.width - 10px;
        width: self.preferred-width;
        spacing: 10px;
        if root.arrows: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: #141414;
                IconButton {
                    icon: @image-url("icons/chevron-left.svg");
                    size: 14px;
                    enabled: root.can-prev;
                    tint: Theme.text;
                    clicked => {
                        root.prev();
                    }
                }
            }
        }
        if root.arrows: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: #141414;
                IconButton {
                    icon: @image-url("icons/chevron-right.svg");
                    size: 14px;
                    enabled: root.can-next;
                    tint: Theme.text;
                    clicked => {
                        root.next();
                    }
                }
            }
        }
        if root.view-all: Text {
            text: "View all";
            color: all-link.has-hover ? Theme.text : Theme.text-secondary;
            font-size: 14px;
            font-weight: Theme.medium;
            vertical-alignment: center;
            all-link := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.show-all(); }
            }
        }
    }
}

// Reports the visible card range [from, upto) while this block is near the
// viewport, and (0, 0) once it has scrolled away so artwork can be dropped.
component ArtRequest inherits Rectangle {
    in property <int> from: 0;
    in property <int> upto: 0;
    callback request(int, int);
    in property <length> window-height: 1200px;
    // One extra pane of covers, so scrolling onto the next page is already painted.
    out property <length> overscan: max(window-height, 1px);
    property <bool> near: self.absolute-position.y < window-height + overscan && self.absolute-position.y + self.height > -overscan;
    property <int> sent-from: -1;
    property <int> sent-upto: -1;
    property <bool> sent-near: false;
    public function reset() {
        sent-from = -1;
        sent-upto = -1;
        sent-near = false;
    }
    Timer {
        // The first request after a page is built goes out at once, so a page
        // restored behind a back / forward snapshot has its artwork loading
        // before the snapshot lifts. Later range changes (scrolling) debounce.
        interval: sent-near ? 150ms : 16ms;
        running: (near && (sent-from != from || sent-upto != upto)) || (sent-near && !near);
        triggered => {
            if (root.near) {
                root.request(root.from, root.upto);
                sent-from = root.from;
                sent-upto = root.upto;
                sent-near = true;
            } else {
                root.request(0, 0);
                sent-from = 0;
                sent-upto = 0;
                sent-near = false;
            }
        }
    }
}

component Carousel inherits Rectangle {
    in property <SectionData> section;
    in property <bool> view-all: true;
    callback show-all();
    callback request-art(int, int);
    changed section => { artwork.reset(); }
    property <length> gap: 17px;
    property <int> per-page: max(2, floor((self.width + gap) / (200px + gap)));
    property <length> card-w: (self.width - (per-page - 1) * gap) / per-page;
    property <int> offset: 0;
    property <int> max-offset: max(0, section.cards.length - per-page);
    height: 34px + 16px + card-w + 76px;
    artwork := ArtRequest {
        window-height: App.pane-height;
        from: max(0, min(root.offset, root.max-offset) - root.per-page);
        upto: min(section.cards.length, min(root.offset, root.max-offset) + 2 * root.per-page);
        request(from, upto) => { root.request-art(from, upto); }
    }

    // Narrow, the title needs the room: "View all" reaches every card, so
    // the arrows go when it is there.
    property <bool> all-link: root.view-all && section.cards.length > per-page;
    SectionHeader {
        y: 0;
        title: section.title;
        arrows: !(root.all-link && root.width < 420px);
        view-all: root.all-link;
        can-prev: root.offset > 0;
        can-next: root.offset < root.max-offset;
        prev => {
            root.offset = max(0, root.offset - root.per-page);
        }
        next => {
            root.offset = min(root.max-offset, root.offset + root.per-page);
        }
        show-all => {
            root.show-all();
        }
    }

    Rectangle {
        y: 50px;
        height: card-w + 76px;
        clip: true;
        Rectangle {
            x: -min(root.offset, root.max-offset) * (card-w + gap);
            width: section.cards.length * (card-w + gap);
            animate x {
                duration: 280ms;
                easing: ease-out;
            }
            for card[i] in section.cards: GridItem {
                x: i * (card-w + gap);
                y: 0;
                width: card-w;
                card: card;
            }
        }
    }
}

component RowGrid inherits Rectangle {
    in property <SectionData> section;
    in property <int> section-index;
    in property <bool> tiles: false;
    property <int> cols: self.width > 760px ? 3 : self.width > 480px || tiles ? 2 : 1;
    property <length> gap-x: tiles ? 9px : 30px;
    property <length> row-h: tiles ? 75px : 79px;
    property <length> col-w: (self.width - (cols - 1) * gap-x) / cols;
    // Feed rows (Recently played) mix collections and single tracks: tracks follow the cards.
    property <int> count: section.layout == "tracks" ? section.tracks.length : section.layout == "rows" ? section.cards.length + section.tracks.length : section.cards.length;
    property <length> head: tiles ? 0px : 50px;
    height: head + ceil(count / cols) * row-h - (tiles ? 9px : 17px);
    property <int> first-row: max(0, floor((-art.absolute-position.y - art.overscan) / row-h));
    property <int> vis-rows: max(1, ceil((art.overscan + max(App.pane-height, 1px) + art.overscan) / row-h));
    art := ArtRequest {
        width: 100%;
        height: 100%;
        window-height: App.pane-height;
        from: first-row * cols;
        upto: min(count, (first-row + vis-rows) * cols);
        request(from, upto) => { App.section-visible(root.section-index, from, upto); }
    }

    if !tiles: SectionHeader {
        y: 0;
        title: section.title;
    }
    // Feed rows (Recently played) list their tracks after the cards.
    property <int> offset: section.layout == "tracks" ? 0 : section.cards.length;
    Rectangle {
        y: head;
        if section.layout != "tracks": Rectangle {
            for card[i] in section.cards: SlimItem {
                x: mod(i, cols) * (col-w + gap-x);
                y: floor(i / cols) * row-h;
                width: col-w;
                card: card;
                filled: root.tiles;
            }
        }
        if section.layout == "tracks" || section.layout == "rows": Rectangle {
            for track[j] in section.tracks: SlimItem {
                x: mod(root.offset + j, cols) * (col-w + gap-x);
                y: floor((root.offset + j) / cols) * row-h;
                width: col-w;
                card: Items.from-track(track);
                filled: root.tiles;
            }
        }
    }
}

component LinkRow inherits Rectangle {
    in property <SectionData> section;
    property <length> gap: 8px;
    property <int> cols: max(2, floor((self.width + gap) / (118px + gap)));
    property <length> col-w: (self.width - (cols - 1) * gap) / cols;
    property <int> count: section.cards.length;
    property <length> row-h: 44px;
    height: 50px + ceil(count / cols) * row-h;
    SectionHeader {
        y: 0;
        title: section.title;
        view-all: false;
    }
    for card[i] in section.cards: Rectangle {
        x: mod(i, cols) * (col-w + gap);
        y: 50px + floor(i / cols) * row-h;
        width: min(col-w - 4px, chip-label.preferred-width + 28px);
        height: 36px;
        border-radius: 18px;
        background: chip-ta.has-hover ? #2a2a2a : #1c1c1c;
        chip-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { App.open-card(card); }
        }
        chip-label := Text {
            text: card.title;
            color: Theme.text;
            font-size: 14px;
            font-weight: Theme.medium;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Explore genres / moods / decades: wrapping image (or tint) tiles, not chips.
component TileGrid inherits Rectangle {
    in property <SectionData> section;
    in property <int> section-index;
    property <length> gap: 12px;
    property <int> cols: max(self.width < 480px ? 2 : 3, floor((self.width + gap) / (176px + gap)));
    property <length> tile-w: (self.width - (cols - 1) * gap) / cols;
    property <length> tile-h: tile-w * 0.62;
    property <int> count: section.cards.length;
    height: 50px + ceil(count / cols) * (tile-h + gap) - gap;
    art := ArtRequest {
        width: 100%;
        height: 100%;
        window-height: App.pane-height;
        from: 0;
        upto: count;
        request(from, upto) => { App.section-visible(root.section-index, from, upto); }
    }
    SectionHeader {
        y: 0;
        title: section.title;
        view-all: false;
    }
    for card[i] in section.cards: Rectangle {
        x: mod(i, cols) * (tile-w + gap);
        y: 50px + floor(i / cols) * (tile-h + gap);
        width: tile-w;
        height: tile-h;
        border-radius: 4px;
        clip: true;
        background: tile-ta.has-hover ? card.tint.brighter(20%) : card.tint;
        if card.image.width > 0: Image {
            width: 100%;
            height: 100%;
            source: card.image;
            image-fit: cover;
        }
        Rectangle {
            y: parent.height * 0.45;
            width: 100%;
            height: parent.height * 0.55;
            background: @linear-gradient(180deg, #00000000 0%, #00000099 100%);
        }
        Text {
            x: 12px;
            y: parent.height - 40px;
            width: parent.width - 24px;
            height: 32px;
            text: card.title;
            color: white;
            font-size: 15px;
            font-weight: 700;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: bottom;
        }
        tile-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { App.open-card(card); }
        }
    }
}

export component ModulesView inherits Rectangle {
    VerticalLayout {
        alignment: start;
        if App.sections.length == 0 && App.loading: Rectangle {
            height: 280px;
            TideLoader { }
        }
        if App.sections.length == 0 && !App.loading: Text {
            text: "Nothing here yet";
            color: Theme.text-secondary;
            font-size: 15px;
        }
        for section[i] in App.sections: VerticalLayout {
            padding-bottom: section.layout == "shortcuts" ? 44px : 38px;
            if section.layout == "shortcuts": RowGrid {
                section: section;
                section-index: i;
                tiles: true;
            }
            if section.layout == "tiles": TileGrid {
                section: section;
                section-index: i;
            }
            if section.layout == "links": LinkRow {
                section: section;
            }
            if section.layout == "cards": Carousel {
                section: section;
                request-art(from, upto) => { App.section-visible(i, from, upto); }
            }
            if section.layout == "rows" || section.layout == "tracks": RowGrid {
                section: section;
                section-index: i;
            }
        }
    }
}

export component HomeView inherits Rectangle {
    property <length> pad: clamp((self.width - 900px) * 0.11, App.page-gutter, 83px);
    ScrollView {
        content-y <=> App.scroll-y;
        VerticalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            padding-top: 4px;
            padding-bottom: 48px + App.bar-inset;
            spacing: 0px;
            alignment: start;
            // Phone layout: no sidebar says where this is.
            if App.phone-layout: Text {
                height: 48px;
                text: "Home";
                color: Theme.text;
                font-size: 28px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle {
                height: 44px;
                HorizontalLayout {
                    alignment: start;
                    spacing: 18px;
                    for tab[i] in ["For you", "Staff Picks", "Uploads"]: Rectangle {
                        width: label.preferred-width;
                        label := Text {
                            text: tab;
                            color: i == App.home-tab ? Theme.text : Theme.text-secondary;
                            font-size: 15px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }

                        if i == App.home-tab: Rectangle {
                            y: parent.height - 2px;
                            height: 2px;
                            background: white;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { App.set-home-tab(i); }
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: #161616;
                }
            }

            Rectangle {
                height: 35px;
            }

            ModulesView { }
        }
    }
}

export component ModulesPage inherits Rectangle {
    property <length> pad: clamp((self.width - 900px) * 0.11, App.page-gutter, 83px);
    ScrollView {
        content-y <=> App.scroll-y;
        VerticalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            padding-top: 8px;
            padding-bottom: 48px + App.bar-inset;
            alignment: start;
            Rectangle {
                height: 48px;
                Text {
                    width: 100%;
                    height: 100%;
                    text: App.page-title;
                    color: Theme.text;
                    font-size: 28px;
                    font-weight: 700;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            // Phone layout: the search lives here, not in the top bar.
            if App.phone-layout && App.nav-key == "explore": VerticalLayout {
                padding-top: 8px;
                padding-bottom: 22px;
                SearchField {
                    active: !App.video-open && !App.show-now-playing;
                }
            }
            ModulesView { }
        }
    }
}

// ---------------------------------------------------------------- track table

component TrackHeader inherits Rectangle {
    in property <string> text;
    in property <TrackSortColumn> column;
    property <bool> sortable: App.view != "queue";
    property <bool> selected: sortable && App.track-sort-column == column;
    property <bool> numbered: column == TrackSortColumn.position;

    accessible-role: button;
    accessible-enabled: sortable;
    accessible-label: sortable ? "Sort by " + (numbered ? "track position" : text) : text;
    accessible-description: selected ? (App.track-sort-descending ? "Descending" : "Ascending") : "";
    accessible-action-default => { if (sortable) { App.sort-tracks(column); } }

    border-radius: 4px;
    background: focus.has-focus ? #ffffff18 : transparent;

    label := Text {
        x: numbered ? (root.width - self.width) / 2 : 0px;
        width: numbered ? self.preferred-width : max(0px, min(self.preferred-width, root.width - (selected ? 16px : 0px)));
        height: root.height;
        text: root.text;
        color: area.has-hover || focus.has-focus ? Theme.text : Theme.text-header;
        font-size: 12px;
        font-weight: 500;
        letter-spacing: 0.6px;
        overflow: elide;
        vertical-alignment: center;
    }

    if selected: Icon {
        x: label.x + label.width + 4px;
        y: (root.height - self.height) / 2;
        source: @image-url("icons/chevron-down.svg");
        transform-rotation: App.track-sort-descending ? 0deg : 180deg;
        size: 12px;
        tint: Theme.lossless;
    }

    focus := FocusScope {
        width: 0px;
        enabled: root.sortable;
        changed has-focus => { App.track-sort-focused = self.has-focus; }
        key-pressed(event) => {
            if (event.text == Key.Return || event.text == Key.Space) {
                App.sort-tracks(root.column);
                return accept;
            }
            return reject;
        }
    }
    area := TouchArea {
        enabled: root.sortable;
        mouse-cursor: pointer;
        clicked => { App.sort-tracks(root.column); }
    }
}

component Cell inherits Text {
    color: Theme.text;
    font-size: 15px;
    font-weight: 500;
    overflow: elide;
    vertical-alignment: center;
}

component LinkedCell inherits Cell {
    in property <bool> link-enabled;
    callback activated();
    callback context-requested(length, length);

    font-weight: Theme.demibold;

    Rectangle {
        x: 0;
        y: root.height / 2 + root.font-size / 2 + 1px;
        width: link.width;
        height: 1px;
        background: root.color;
        visible: link.enabled && link.has-hover;
    }

    link := TouchArea {
        x: 0;
        width: max(0px, min(root.width, root.preferred-width));
        enabled: root.link-enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context-requested(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => { root.activated(); }
    }
}

component TrackRow inherits Rectangle {
    in property <TrackData> track;
    in property <int> index;
    in property <bool> show-bpm;
    in property <bool> show-date;
    in property <bool> album-page;
    in property <bool> artist-page;
    in property <length> x-artist;
    in property <length> x-album;
    in property <length> x-date;
    in property <length> x-time;
    in property <length> x-bpm;
    // Columns a narrower table leaves out.
    in property <bool> show-album: true;
    in property <bool> show-time: true;
    in property <bool> show-heart: true;
    // Phone width: the title over the artist in one cell, as in the official
    // client; an album numbers its rows, other lists show the artwork (which
    // takes the play button on hover).
    in property <bool> stacked: false;
    // Search's first hit while the search field has focus: shown as if
    // hovered, because Enter plays it.
    in property <bool> spotlight: false;
    property <bool> active: track.id == App.current-id;
    property <length> more-x: root.width - (root.show-heart ? 76px : 36px);
    property <length> text-x: root.stacked ? (album-page ? 40px : 58px) : album-page ? 46px : artist-page ? 60px : 105px;
    property <length> text-end: root.stacked ? (root.show-time ? x-time : root.more-x) - 12px : x-artist - 24px;
    property <bool> lit: ta.has-hover || spotlight;
    height: 53px;
    border-radius: 6px;
    background: lit ? #121212 : transparent;
    animate background {
        duration: 160ms;
        easing: ease-out;
    }
    // Dragged by its name or artwork, the track goes to a playlist.
    ta := TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                more.open-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                App.drag-release(true);
            }
            if (e.kind == PointerEventKind.cancel) {
                App.drag-release(false);
            }
        }
        moved => {
            if (self.pressed) {
                App.drag-move(track.id, track.title, track.artist, track.cover, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        double-clicked => {
            if (!App.drag-gesture) {
                App.play-track(track.id);
            }
        }
    }

    if !album-page: Cover {
        x: artist-page || root.stacked ? 0px : 46px;
        width: 46px;
        height: 46px;
        source: track.cover;
        // Rounded clipping creates an offscreen layer for each scrolling thumbnail.
        radius: 0px;
    }

    // Index / play affordance. Stacked without numbers, it is on the artwork.
    Rectangle {
        x: 0;
        width: root.stacked ? (album-page ? 32px : 46px) : 44px;
        height: root.stacked && !album-page ? 46px : root.height;
        background: root.stacked && !album-page && lit ? #00000099 : transparent;
        if active && !lit && !(root.stacked && !album-page): Icon {
            source: @image-url("icons/volume.svg");
            size: 17px;
            tint: App.accent;
        }
        if !artist-page && !active && !lit && !(root.stacked && !album-page): Text {
            text: track.position > 0 ? track.position : index + 1;
            color: #7c7c7c;
            font-size: 14px;
            font-weight: 500;
        }
        if lit: IconButton {
            icon: active && App.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
            size: 15px;
            tint: Theme.text;
            context-requested(x, y) => { more.open-at(x, y); }
            clicked => {
                if (active) {
                    App.toggle-play();
                } else {
                    App.play-track(track.id);
                }
            }
        }
    }

    HorizontalLayout {
        x: root.text-x;
        y: root.stacked ? 6px : 0px;
        width: max(0px, root.text-end - self.x);
        height: root.stacked ? 22px : root.height;
        alignment: start;
        spacing: 8px;
        Cell {
            text: track.title;
            color: active ? App.accent : Theme.text;
        }

        if track.explicit: VerticalLayout {
            alignment: center;
            ExplicitBadge { }
        }
    }

    ArtistLinks {
        x: root.stacked ? root.text-x : x-artist;
        y: root.stacked ? 28px : 0px;
        width: max(0px, min(self.preferred-width, root.stacked ? root.text-end - root.text-x
            : (album-page || !root.show-album ? x-time : x-album) - x-artist - 24px));
        height: root.stacked ? 19px : root.height;
        artists: track.artists;
        text: track.artist;
        text-color: root.stacked ? Theme.text-secondary : Theme.text;
        font-size: root.stacked ? 14px : 15px;
        font-weight: root.stacked ? Theme.medium : Theme.demibold;
        context-requested(x, y) => { more.open-at(x, y); }
        open(a) => { App.open-artist(a); }
    }

    if !album-page && root.show-album && !root.stacked: LinkedCell {
        x: x-album;
        width: (show-date ? x-date : x-time) - x-album - 20px;
        text: track.album;
        link-enabled: !track.album-id.is-empty;
        context-requested(x, y) => { more.open-at(x, y); }
        activated => { App.open-track-album(track); }
    }

    if show-date && !root.stacked: Cell {
        x: x-date;
        width: x-time - x-date - 12px;
        text: track.date-added;
    }
    if root.show-time: Cell {
        x: x-time;
        text: track.duration;
        color: root.stacked ? Theme.text-secondary : Theme.text;
    }

    if show-bpm && !root.stacked: Cell {
        x: x-bpm;
        width: 44px;
        text: track.bpm;
    }
    more := TrackMenuButton {
        x: root.more-x;
        track-id: track.id;
    }

    if root.show-heart: IconButton {
        x: root.width - 42px;
        icon: track.favorite ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
        size: 17px;
        tint: Theme.text;
        context-requested(x, y) => { more.open-at(x, y); }
        clicked => {
            App.toggle-favorite(track.id);
        }
    }
}

component TrackPlaceholder inherits Rectangle {
    in property <length> x-artist;
    in property <length> x-album;
    in property <length> x-time;
    height: 53px;
    background: transparent;

    Rectangle {
        x: 0;
        y: 3px;
        width: 46px;
        height: 46px;
        border-radius: 2px;
        background: #1c1c1c;
    }
    Rectangle {
        x: 60px;
        y: 22px;
        width: max(32px, min(180px, root.x-artist - 84px));
        height: 8px;
        border-radius: 4px;
        background: #242424;
    }
    Rectangle {
        x: root.x-artist;
        y: 22px;
        width: max(32px, min(132px, root.x-album - root.x-artist - 24px));
        height: 8px;
        border-radius: 4px;
        background: #242424;
    }
    Rectangle {
        x: root.x-album;
        y: 22px;
        width: max(32px, min(132px, root.x-time - root.x-album - 24px));
        height: 8px;
        border-radius: 4px;
        background: #242424;
    }
    Rectangle {
        x: root.x-time;
        y: 22px;
        width: 34px;
        height: 8px;
        border-radius: 4px;
        background: #242424;
    }
    Rectangle {
        x: root.width - 66px;
        y: 19px;
        width: 16px;
        height: 14px;
        border-radius: 3px;
        background: #242424;
    }
    Rectangle {
        x: root.width - 42px;
        y: 18px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #242424;
    }
}

// Icon over a label: the album page's Add / Credits / Share / More.
component ActionButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    // A state that is on: Public.
    in property <color> tint: Theme.text;
    callback clicked();
    width: 64px;
    height: 58px;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Icon {
        y: 4px;
        source: root.icon;
        size: 22px;
        tint: root.tint;
        opacity: ta.has-hover ? 1.0 : 0.85;
    }

    Text {
        y: 38px;
        width: root.width;
        text: root.label;
        color: root.tint;
        font-size: 12px;
        font-weight: Theme.demibold;
        horizontal-alignment: center;
    }

    @children
}

component CatalogTabs inherits Rectangle {
    in property <[string]> tabs;
    in-out property <int> selected;
    height: 46px;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        alignment: start;
        spacing: 24px;
        for tab[index] in root.tabs: Rectangle {
            width: label.preferred-width;
            label := Text {
                text: tab;
                font-size: 14px;
                font-weight: Theme.medium;
                color: root.selected == index ? Theme.text : Theme.text-secondary;
                vertical-alignment: center;
            }
            if root.selected == index: Rectangle {
                y: parent.height - 2px;
                height: 2px;
                background: Theme.text;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected = index;
                    App.scroll-y = 0px;
                }
            }
        }
    }
}

component ChoiceButton inherits Rectangle {
    in property <image> icon;
    in property <string> heading;
    in property <[string]> options;
    in property <string> current;
    in property <bool> highlighted: false;
    in property <string> toggle-label: "";
    in property <bool> toggle-on: false;
    // Open the menu leftwards, for a button at the right edge.
    in property <bool> align-right: false;
    callback chosen(string);
    callback toggled(bool);
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: ta.has-hover ? #1e1e1e : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            pop.show();
        }
    }

    Icon {
        source: root.icon;
        size: 18px;
        tint: root.highlighted ? Theme.lossless : ta.has-hover ? Theme.text : Theme.text-secondary;
    }

    pop := PopupWindow {
        x: root.align-right ? root.width - 260px : 0px;
        y: root.height + 6px;
        width: 260px;
        MenuPanel {
            Text {
                height: 30px;
                text: "   " + root.heading;
                color: Theme.text-secondary;
                font-size: 12px;
                font-weight: Theme.demibold;
                letter-spacing: 0.8px;
                vertical-alignment: center;
            }

            for option in root.options: MenuRow {
                label: option;
                checked: option == root.current;
                activated => {
                    root.chosen(option);
                }
            }

            if root.toggle-label != "": Rectangle {
                height: 8px;
                Rectangle {
                    y: 4px;
                    height: 1px;
                    background: #3a3a3a;
                }
            }
            if root.toggle-label != "": Rectangle {
                height: 44px;
                Text {
                    x: 14px;
                    width: parent.width - 76px;
                    text: root.toggle-label;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: Theme.demibold;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Toggle {
                    x: parent.width - 54px;
                    y: 8px;
                    on: root.toggle-on;
                    toggled(v) => {
                        root.toggled(v);
                    }
                }
            }
        }
    }
}

// Grid of video stills (16:9) or square covers under a section title.
component CardGrid inherits Rectangle {
    in property <string> title;
    in property <bool> wide: true;
    in property <[CardData]> cards;
    in property <string> status;
    in property <string> empty-text;
    in property <string> error-text;
    callback request-art(int, int);
    property <length> gap: 18px;
    property <int> cols: max(1, floor((self.width + gap) / ((wide ? 240px : 180px) + gap)));
    property <length> card-w: (self.width - (cols - 1) * gap) / cols;
    property <length> row-h: (wide ? card-w * 9 / 16 + 100px : card-w + 76px) + gap;
    property <int> first-row: max(0, floor((-art.absolute-position.y - art.overscan - 50px) / row-h));
    property <int> visible-rows: max(1, ceil((art.overscan * 2 + App.pane-height) / row-h) + 1);
    height: cards.length > 0 ? 50px + ceil(cards.length / cols) * row-h - gap : 132px;
    changed cards => { art.reset(); }
    art := ArtRequest {
        width: 100%;
        height: 100%;
        window-height: App.pane-height;
        from: first-row * cols;
        upto: min(cards.length, (first-row + visible-rows) * cols);
        request(from, upto) => { root.request-art(from, upto); }
    }
    SectionHeader {
        y: 0;
        title: root.title;
        view-all: false;
    }
    for slot in root.visible-rows * root.cols: Rectangle {
        property <int> index: root.first-row * root.cols + slot;
        x: mod(slot, root.cols) * (root.card-w + root.gap);
        y: 50px + (root.first-row + floor(slot / root.cols)) * root.row-h;
        width: root.card-w;
        height: root.row-h - root.gap;
        if index < root.cards.length: GridItem {
            width: parent.width;
            hover-panel: true;
            card: root.cards[parent.index];
        }
    }
    if cards.length == 0 && status == "loading": TideLoader {
        x: (root.width - self.width) / 2;
        y: 64px;
    }
    if cards.length == 0 && status != "loading": Text {
        y: 62px;
        width: root.width;
        text: root.status == "error" ? root.error-text : root.empty-text;
        color: Theme.text-secondary;
        font-size: 15px;
        wrap: word-wrap;
    }
}

export component TracksView inherits Rectangle {
    property <length> pad: clamp((self.width - 900px) * 0.12, App.page-gutter, 89px);
    property <length> w: self.width - 2 * pad;
    property <bool> album-page: App.view == "album";
    property <bool> artist-page: App.view == "artist";
    property <bool> search-page: App.view == "search";
    // Creator, description and a line of facts sit beside a playlist's cover.
    property <bool> playlist-page: App.view == "detail" && App.page-card.kind == "playlist";
    property <bool> own-playlist: playlist-page && App.page-card.by == "Me";
    property <bool> about: artist-page && App.artist-tab == 3;
    property <bool> music-tab: artist-page && App.artist-tab == 1;
    // Search tabs: All | Albums | Playlists | Videos.
    property <bool> video-tab: (artist-page && App.artist-tab == 2) || (search-page && App.search-tab == 3);
    property <bool> album-tab: search-page && App.search-tab == 1;
    property <bool> playlist-tab: search-page && App.search-tab == 2;
    property <bool> search-all: search-page && App.search-tab == 0;
    property <bool> show-tracks: !about && !music-tab && !video-tab && !album-tab && !playlist-tab;
    property <bool> track-placeholders: artist-page && show-tracks && App.loading && App.tracks.length < 5;
    property <int> row-count: !show-tracks ? 0 : artist-page ? (track-placeholders ? 5 : min(5, App.tracks.length)) : App.tracks.length;
    property <bool> wide: w > 980px && !album-page;
    // Narrower tables drop columns, the album first, then the date, BPM and
    // time; on a phone-width page each row is the title over the artist.
    property <bool> stacked-rows: w < 520px;
    property <bool> show-album: !album-page && w >= 680px;
    property <bool> show-time: !stacked-rows || w >= 400px;
    property <bool> show-heart: !stacked-rows || w >= 400px;
    // The BPM column (Settings → Display → BPM) sits at the end of the table
    // whenever the table is wide enough for it.
    property <bool> show-bpm: !stacked-rows && w > (album-page ? 560px : 630px) && App.show-audio-metadata;
    // In a narrow table the BPM values take the room of the date.
    property <bool> show-date: App.tracks-show-date && w > 760px && (wide || !show-bpm);
    property <bool> has-cover: App.page-has-cover;
    property <bool> filterable: App.view == "tracks";
    property <length> row-h: 53px;
    // Phone width: the header is one column, centred like the official
    // client's: the cover, the title, the artist, the facts, Play and Shuffle
    // side by side, then the actions as icons over labels.
    property <bool> stack: root.width < 600px;
    property <bool> stack-head: stack && has-cover && !artist-page;
    // The playlist search results' search field (phone layout: not in the top bar).
    property <length> search-row: search-page && App.phone-layout ? 52px : 0px;
    // Vertical layout of the header block.
    property <length> top-inset: album-page || artist-page ? 64px : 0px;
    property <length> y-title: top-inset + (has-cover ? 4px : 8px) + search-row;
    property <int> search-cols: w >= 900px ? 3 : w >= 520px ? 2 : 1;
    // The stacked header under the cover: title, artist line, facts.
    property <bool> has-by: App.page-subtitle != "" || (album-page && App.page-artists.length > 0);
    property <length> stack-meta-h: 32px + (has-by ? 30px : 0px)
        + (album-page ? 26px : 0px)
        + (playlist-page && App.page-description != "" ? 46px : 0px)
        + (playlist-page && App.page-summary != "" ? 24px : 0px);
    property <length> pill-w: stack ? (w - 12px) / 2 : 176px;
    property <length> pill-h: stack ? 48px : 53px;
    // The actions (Add, Share, More…) beside Play and Shuffle, or in a row of
    // their own under them when they would meet (always when stacked).
    property <int> action-count: (App.page-can-favorite ? 1 : 0) + (own-playlist ? 2 : 0) + (album-page ? 1 : 0) + 2;
    property <length> actions-w: action-count * 64px + (action-count - 1) * 12px;
    property <bool> actions-below: App.page-card.id != "" && (stack || 2 * 176px + 18px + 32px + actions-w > w);
    property <length> y-actions: y-buttons + pill-h + 14px;
    property <length> search-height: search-all && App.search-cards.length > 0
        ? 44px + ceil(App.search-cards.length / search-cols) * 66px : 0px;
    // The All tab previews the first playlists; the Playlists tab lists them all.
    property <int> playlist-preview: min(6, App.search-playlists.length);
    property <length> playlists-height: search-all && playlist-preview > 0
        ? 44px + ceil(playlist-preview / search-cols) * 66px : 0px;
    property <length> cover-size: stack ? min(w * 0.64, 240px) : album-page ? clamp(w * 0.25, 180px, 256px) : 218px;
    property <length> hero-h: artist-page ? clamp(w * 0.28, 218px, 352px) : stack-head ? cover-size + 18px + stack-meta-h : has-cover ? cover-size : 38px;
    property <length> search-tabs-y: y-title + hero-h + 12px;
    property <length> y-search-tracks: search-tabs-y + 58px + search-height + playlists-height;
    property <length> y-buttons: artist-page ? top-inset + hero-h - 46px : y-title + hero-h + (stack-head ? 22px : has-cover ? 28px : 24px);
    property <length> y-filter: y-buttons + 53px + 36px;
    property <length> y-tabs: top-inset + hero-h + 22px;
    property <length> y-top-tracks: y-tabs + 70px;
    property <length> y-columns: artist-page ? y-top-tracks + 38px : search-page ? y-search-tracks + 40px : filterable ? y-filter + 44px + 40px
        : actions-below ? y-actions + 58px + 16px : y-buttons + 53px + 30px;
    property <length> header-h: y-columns + (stacked-rows ? 0px : 36px);
    // Column positions (fractions measured from the official client).
    property <length> x-artist: album-page ? w * 0.49 : wide ? w * 0.324 : show-album ? w * 0.40 : w * 0.52;
    property <length> x-album: wide ? w * 0.544 : w * 0.64;
    property <length> x-date: w * 0.724;
    property <length> x-time: !show-bpm ? w - 150px : wide ? w * 0.839 : w - 190px;
    // Ends before the row's More and heart buttons.
    property <length> x-bpm: wide ? w * 0.891 : w - 128px;
    // Hand-rolled virtualisation so the header scrolls with the rows.
    property <int> first: max(0, floor((-sv.content-y - header-h) / row-h));
    property <int> visible-rows: ceil(self.height / row-h) + 2;
    // The part of the page above the player bar (the page runs under a glass bar).
    property <length> view-h: self.height - App.bar-inset;
    // A focused search / filter field picks a row for Enter; ↑ ↓ move it.
    property <bool> picking: (search-page && App.search-focused && App.search-text == App.search-shown) || (filterable && App.filter-focused);
    property <int> pick: App.pick-index;
    changed pick => {
        if (root.picking && root.show-tracks) {
            if (root.header-h + root.pick * root.row-h < -App.scroll-y) {
                App.scroll-y = min(0px, -(root.header-h + root.pick * root.row-h) + 12px);
            } else if (root.header-h + (root.pick + 1) * root.row-h > -App.scroll-y + root.view-h) {
                App.scroll-y = -(root.header-h + (root.pick + 1) * root.row-h - root.view-h + 12px);
            }
        }
    }
    property <int> reveal-request: App.reveal-track-revision;
    function reveal-track() {
        if (App.reveal-track-index >= 0 && App.reveal-track-index < App.tracks.length) {
            App.scroll-y = clamp(root.view-h / 2 - root.header-h - (App.reveal-track-index + 0.5) * root.row-h,
                min(0px, root.height - sv.content-height), 0px);
        }
    }
    changed reveal-request => { root.reveal-track(); }
    changed height => { root.reveal-track(); }
    changed header-h => { root.reveal-track(); }
    init => { root.reveal-track(); }
    changed first => {
        App.rows-visible(first, visible-rows);
    }
    changed visible-rows => {
        App.rows-visible(first, visible-rows);
    }
    sv := ScrollView {
        content-y <=> App.scroll-y;
        content-width: root.width;
        // Leave enough room to center even the final track after a source jump.
        property <length> tail: (App.reveal-track-index >= 0 ? max(48px, root.view-h / 2) : 48px) + App.bar-inset;
        content-height: artist-page || album-page || search-page ? artist-content.y + artist-content.preferred-height + self.tail
            : header-h + row-count * row-h + self.tail;
        if artist-page || album-page: Rectangle {
            y: 0;
            width: root.width;
            height: top-inset + (artist-page ? hero-h + 14px : hero-h + 116px);
            clip: true;
            background: App.page-tint.darker(55%);
            if artist-page: Image {
                width: min(root.width * 0.60, parent.height);
                height: parent.height;
                source: App.page-cover;
                image-fit: cover;
                opacity: App.page-cover.width > 0 ? 1 : 0;
                animate opacity {
                    duration: 200ms;
                    easing: ease-in-out;
                }
            }
            Rectangle {
                background: @linear-gradient(180deg, #00000018 0%, #00000035 35%, #000000d9 82%, Theme.bg 100%);
            }
        }
        if has-cover && !artist-page: Cover {
            x: stack-head ? (root.width - root.cover-size) / 2 : pad;
            y: y-title;
            width: cover-size;
            height: cover-size;
            source: App.page-motion.width > 0 ? App.page-motion : App.page-cover;
            radius: 4px;
        }
        if !stack-head: Text {
            x: has-cover && !artist-page ? pad + cover-size + 32px : pad;
            y: artist-page ? y-buttons - 53px : album-page ? y-title + cover-size * 0.23 : playlist-page ? y-title + 30px : has-cover ? y-title + 74px : y-title;
            width: root.width - self.x - pad - (stack && (album-tab || playlist-tab) ? 84px : 0px);
            height: has-cover ? 44px : 38px;
            text: App.page-title;
            color: Theme.text;
            font-size: has-cover ? 36px : 28px;
            font-weight: Theme.bold;
            overflow: elide;
            vertical-alignment: center;
        }

        if album-page && App.page-artist.id != "" && !stack-head: Cover {
            x: pad + cover-size + 32px;
            y: y-title + cover-size * 0.23 + 46px;
            width: 24px;
            height: 24px;
            source: App.page-artist.image;
            round: true;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { App.open-card(App.page-artist); }
            }
        }
        if has-cover && !artist-page && !stack-head: ArtistLinks {
            property <bool> linked: album-page && App.page-artists.length > 0;
            x: pad + cover-size + 32px + (album-page && App.page-artist.id != "" ? 34px : 0px);
            y: album-page ? y-title + cover-size * 0.23 + 48px : playlist-page ? y-title + 82px : y-title + 124px;
            width: min(self.preferred-width, root.width - self.x - pad);
            height: self.preferred-height;
            artists: linked ? App.page-artists : [];
            text: App.page-subtitle;
            text-color: linked ? Theme.text : Theme.text-secondary;
            font-weight: Theme.medium;
            open(a) => { App.open-artist(a); }
        }
        if playlist-page && App.page-description != "" && !stack-head: Text {
            x: pad + cover-size + 32px;
            y: y-title + 116px;
            width: min(760px, root.width - self.x - pad);
            height: 40px;
            text: App.page-description;
            color: Theme.text-secondary;
            font-size: 14px;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: top;
        }
        if playlist-page && App.page-summary != "" && !stack-head: Text {
            x: pad + cover-size + 32px;
            y: y-title + (App.page-description != "" ? 176px : 122px);
            width: root.width - self.x - pad;
            text: App.page-summary;
            color: Theme.text-secondary;
            font-size: 12px;
            font-weight: Theme.medium;
            letter-spacing: 1px;
            overflow: elide;
        }
        // Stacked: everything beside the cover moves under it, centred.
        if stack-head: VerticalLayout {
            x: pad;
            y: y-title + cover-size + 18px;
            width: w;
            height: root.stack-meta-h;
            spacing: 6px;
            Text {
                height: 32px;
                text: App.page-title;
                color: Theme.text;
                font-size: 24px;
                font-weight: Theme.bold;
                overflow: elide;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.has-by: HorizontalLayout {
                height: 24px;
                alignment: center;
                spacing: 10px;
                if album-page && App.page-artist.id != "": VerticalLayout {
                    alignment: center;
                    Cover {
                        width: 24px;
                        height: 24px;
                        source: App.page-artist.image;
                        round: true;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { App.open-card(App.page-artist); }
                        }
                    }
                }
                ArtistLinks {
                    property <bool> linked: album-page && App.page-artists.length > 0;
                    width: min(self.preferred-width, root.w - 34px);
                    artists: linked ? App.page-artists : [];
                    text: App.page-subtitle;
                    text-color: linked ? Theme.text : Theme.text-secondary;
                    font-weight: Theme.medium;
                    open(a) => { App.open-artist(a); }
                }
            }
            if album-page: HorizontalLayout {
                height: 20px;
                alignment: center;
                spacing: 12px;
                Text {
                    text: App.page-year;
                    color: Theme.text-secondary;
                    font-size: 13px;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
                if App.page-quality != "": VerticalLayout {
                    alignment: center;
                    QualityBadge { tier: App.page-quality; }
                }
            }
            if playlist-page && App.page-description != "": Text {
                height: 40px;
                text: App.page-description;
                color: Theme.text-secondary;
                font-size: 14px;
                wrap: word-wrap;
                overflow: elide;
                horizontal-alignment: center;
                vertical-alignment: top;
            }
            if playlist-page && App.page-summary != "": Text {
                height: 18px;
                text: App.page-summary;
                color: Theme.text-secondary;
                font-size: 12px;
                font-weight: Theme.medium;
                letter-spacing: 1px;
                overflow: elide;
                horizontal-alignment: center;
            }
        }
        if album-page && !stack-head: VerticalLayout {
            x: pad + cover-size + 32px;
            y: y-title + cover-size * 0.23 + 84px;
            width: max(0px, root.width - self.x - pad);
            height: self.preferred-height;
            spacing: 10px;
            Text {
                text: App.page-summary;
                color: Theme.text-secondary;
                font-size: 12px;
                font-weight: Theme.medium;
                letter-spacing: 1px;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 12px;
                Text {
                    text: App.page-year;
                    color: Theme.text-secondary;
                    font-size: 13px;
                }
                if App.page-quality != "": Text {
                    text: App.page-quality;
                    color: App.page-quality == "MAX" ? Theme.max : App.page-quality == "LOSSLESS" || App.page-quality == "HIGH" ? Theme.lossless : Theme.text-secondary;
                    font-size: 12px;
                    font-weight: Theme.bold;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }
        }
        // Phone layout: the field to refine the search, above the results.
        if search-page && App.phone-layout: SearchField {
            x: pad;
            y: y-title - search-row + 4px;
            width: w;
            active: !App.video-open && !App.show-now-playing;
        }
        if search-page: CatalogTabs {
            x: pad;
            y: search-tabs-y;
            width: w;
            tabs: ["All", "Albums", "Playlists", "Videos"];
            selected <=> App.search-tab;
        }
        // Sort and group the Albums and Playlists tabs, as on library grids.
        if album-tab || playlist-tab: HorizontalLayout {
            x: pad + w - self.width;
            // Narrow, the tabs need the whole row: up beside the title.
            y: stack ? y-title + 2px : search-tabs-y + 6px;
            width: self.preferred-width;
            height: 34px;
            spacing: 6px;
            ChoiceButton {
                icon: @image-url("icons/sort.svg");
                heading: "SORT BY";
                align-right: true;
                options: root.album-tab ? ["Relevance", "A-Z", "Artist", "Release date"] : ["Relevance", "A-Z", "Creator"];
                current: root.album-tab ? App.search-album-sort : App.search-playlist-sort;
                highlighted: self.current != "Relevance";
                chosen(option) => {
                    if (root.album-tab) {
                        App.arrange-search("search-albums", option, App.search-album-group);
                    } else {
                        App.arrange-search("search-playlists", option, App.search-playlist-group);
                    }
                }
            }
            ChoiceButton {
                icon: @image-url("icons/group.svg");
                heading: "GROUP BY";
                align-right: true;
                options: root.album-tab ? ["None", "Artist", "Year", "Title"] : ["None", "Creator", "Title"];
                current: root.album-tab ? App.search-album-group : App.search-playlist-group;
                highlighted: self.current != "None";
                chosen(option) => {
                    if (root.album-tab) {
                        App.arrange-search("search-albums", App.search-album-sort, option);
                    } else {
                        App.arrange-search("search-playlists", App.search-playlist-sort, option);
                    }
                }
            }
        }
        if search-height > 0px: Rectangle {
            x: pad;
            y: search-tabs-y + 58px;
            width: w;
            height: search-height;
            property <length> tile-w: (w - (search-cols - 1) * 12px) / search-cols;
            SectionHeader {
                y: 0;
                title: "Profiles & Albums";
                view-all: true;
                show-all => {
                    App.search-tab = 1;
                    App.scroll-y = 0px;
                }
            }
            for card[i] in App.search-cards: SlimItem {
                x: mod(i, search-cols) * (parent.tile-w + 12px);
                y: 38px + floor(i / search-cols) * 66px;
                width: parent.tile-w;
                card: card;
                filled: true;
            }
        }
        if playlists-height > 0px: Rectangle {
            x: pad;
            y: search-tabs-y + 58px + search-height;
            width: w;
            height: playlists-height;
            property <length> tile-w: (w - (search-cols - 1) * 12px) / search-cols;
            ArtRequest {
                width: 100%;
                height: 100%;
                window-height: App.pane-height;
                upto: root.playlist-preview;
                request(from, upto) => { App.catalog-art("search-playlists", -1, from, upto); }
            }
            SectionHeader {
                y: 0;
                title: "Playlists";
                view-all: App.search-playlists.length > root.playlist-preview;
                show-all => {
                    App.search-tab = 2;
                    App.scroll-y = 0px;
                }
            }
            for card[i] in App.search-playlists: SlimItem {
                visible: i < root.playlist-preview;
                x: mod(i, search-cols) * (parent.tile-w + 12px);
                y: 38px + floor(i / search-cols) * 66px;
                width: parent.tile-w;
                card: card;
                filled: true;
            }
        }
        if search-all && App.tracks.length > 0: SectionHeader {
            x: pad;
            y: y-search-tracks;
            width: w;
            title: "Tracks";
            view-all: false;
        }
        if artist-page: Rectangle {
            x: pad;
            y: y-buttons;
            width: 48px;
            height: 48px;
            border-radius: 24px;
            background: artist-play.has-hover ? #dedede : white;
            Icon {
                source: @image-url("icons/play.svg");
                size: 20px;
                tint: black;
            }
            artist-play := TouchArea {
                enabled: App.tracks.length > 0;
                mouse-cursor: pointer;
                clicked => { App.play-all(false); }
            }
        }
        if !artist-page && !search-page && !video-tab: PillButton {
            x: pad;
            y: y-buttons;
            width: root.pill-w;
            height: root.pill-h;
            text: "Play";
            icon: @image-url("icons/play.svg");
            primary: true;
            clicked => {
                App.play-all(false);
            }
        }

        if !artist-page && !search-page && !video-tab: PillButton {
            x: pad + root.pill-w + (stack ? 12px : 18px);
            y: y-buttons;
            width: root.pill-w;
            height: root.pill-h;
            text: "Shuffle";
            icon: @image-url("icons/shuffle.svg");
            clicked => {
                App.play-all(true);
            }
        }

        if artist-page: Rectangle {
            x: pad + 64px;
            y: y-buttons + 6px;
            width: follow-label.preferred-width + 36px;
            height: 36px;
            border-radius: 18px;
            border-width: 1px;
            border-color: follow.has-hover ? Theme.text : #6a6a6a;
            background: App.page-favorite ? #ffffff1a : transparent;
            follow-label := Text {
                text: App.page-favorite ? "Following" : "Follow";
                color: Theme.text;
                font-size: 14px;
                font-weight: Theme.demibold;
            }
            follow := TouchArea {
                mouse-cursor: pointer;
                clicked => { App.toggle-page-favorite(); }
            }
        }
        // Add / Edit / Private / Credits / Share / More, right of Play and
        // Shuffle on album, playlist and mix pages.
        if App.page-card.id != "": HorizontalLayout {
            x: !actions-below ? root.width - pad - self.width : stack ? (root.width - self.width) / 2 : pad;
            y: actions-below ? y-actions : y-buttons - 2px;
            width: self.preferred-width;
            height: 58px;
            spacing: stack ? clamp((w - action-count * 64px) / max(1, action-count - 1), 0px, 24px) : 12px;
            if App.page-can-favorite: ActionButton {
                icon: App.page-favorite ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
                label: App.page-favorite ? "Added" : "Add";
                clicked => { App.toggle-page-favorite(); }
            }
            // The user's own playlist: edit it, and show or hide it on their profile.
            if own-playlist: ActionButton {
                icon: @image-url("icons/edit.svg");
                label: "Edit";
                clicked => { App.page-action("edit", ""); }
            }
            if own-playlist: ActionButton {
                icon: App.page-card.is-public ? @image-url("icons/unlock.svg") : @image-url("icons/lock.svg");
                label: App.page-card.is-public ? "Public" : "Private";
                tint: App.page-card.is-public ? Theme.lossless : Theme.text;
                clicked => { App.page-action(App.page-card.is-public ? "make-private" : "make-public", ""); }
            }
            // Wrapped: a popup on the root of a conditional element crashes the Slint 1.18 compiler.
            if album-page: HorizontalLayout {
                ActionButton {
                    icon: @image-url("icons/info.svg");
                    label: "Credits";
                    clicked => {
                        App.page-action("credits", "");
                        credits-pop.show();
                    }
                    credits-pop := PopupWindow {
                        x: parent.width - 340px;
                        y: parent.height + 6px;
                        width: 340px;
                        height: min(420px, credits-list.preferred-height + 62px);
                        MenuPanel {
                            Text {
                                height: 38px;
                                text: "  Credits";
                                color: Theme.text;
                                font-size: 17px;
                                font-weight: Theme.bold;
                                vertical-alignment: center;
                            }

                            ScrollView {
                                credits-list := VerticalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-bottom: 8px;
                                    spacing: 10px;
                                    alignment: start;
                                    if App.page-credits.length == 0: Text {
                                        text: App.page-credits-status;
                                        color: Theme.text-secondary;
                                        font-size: 14px;
                                    }
                                    for credit in App.page-credits: VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: credit.role;
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                            font-weight: Theme.medium;
                                        }

                                        Text {
                                            text: credit.names;
                                            color: Theme.text;
                                            font-size: 14px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            ActionButton {
                icon: @image-url("icons/share.svg");
                label: "Share";
                clicked => { share-pop.show(); }
                share-pop := PopupWindow {
                    x: parent.width - 240px;
                    y: parent.height + 6px;
                    width: 240px;
                    MenuPanel {
                        MenuRow {
                            label: "Copy link";
                            icon: @image-url("icons/link.svg");
                            has-icon: true;
                            activated => { App.page-action("copy-link", ""); }
                        }
                    }
                }
            }

            // The same menu a right-click on this album or playlist opens.
            ActionButton {
                icon: @image-url("icons/more.svg");
                label: "More";
                clicked => {
                    App.request-card-menu(App.page-card, self.absolute-position.x + self.width - 300px, self.absolute-position.y + self.height + 6px);
                }
            }
        }

        if artist-page: CatalogTabs {
            x: pad;
            y: y-tabs;
            width: w;
            tabs: ["All", "Music", "Videos", "About"];
            selected <=> App.artist-tab;
        }
        if artist-page && show-tracks: SectionHeader {
            x: pad;
            y: y-top-tracks;
            width: w;
            title: "Top Tracks";
            view-all: App.tracks.length > 4;
            show-all => { App.show-artist-tracks(); }
        }

        if filterable: Rectangle {
            x: pad;
            y: y-filter;
            width: w;
            height: 44px;
            border-radius: 8px;
            border-width: 1px;
            border-color: filter.has-focus ? #3a3a3a : Theme.border;
            Icon {
                x: 16px;
                source: @image-url("icons/search.svg");
                size: 16px;
            }

            if filter.text == "": Text {
                x: 49px;
                text: "Filter tracks";
                color: #aeafb2;
                font-size: 15px;
                vertical-alignment: center;
            }
            // "/" focuses this field (platform::configure_input).
            if filter.text == "": Kbd {
                x: parent.width - self.width - 12px;
                y: (parent.height - self.height) / 2;
                glyph: "/";
            }
            filter := EditableInput {
                x: 49px;
                width: parent.width - 65px - (self.text == "" ? 32px : 0px);
                height: 20px;
                text <=> App.filter-text;
                color: Theme.text;
                font-size: 15px;
                single-line: true;
                vertical-alignment: center;
                selection-background-color: #4a4a4a;
                edited => {
                    App.filter(self.text);
                }
                // Enter plays the picked track (the first, or where ↑ ↓ moved it).
                accepted => {
                    if (App.pick-index >= 0 && App.pick-index < App.tracks.length) {
                        App.play-track(App.tracks[App.pick-index].id);
                    }
                }
                property <bool> filter-has-focus: self.has-focus;
                changed filter-has-focus => { App.filter-focused = self.filter-has-focus; }
                init => {
                    App.filter-focused = false;
                    self.take-filter-focus();
                }
                property <int> focus-request: App.focus-filter;
                changed focus-request => { self.take-filter-focus(); }
                function take-filter-focus() {
                    if App.focus-filter != App.focus-filter-seen {
                        App.focus-filter-seen = App.focus-filter;
                        self.focus();
                        self.select-all();
                    }
                }
            }
        }
        // Stacked rows need no column heads.
        if show-tracks && !stacked-rows: Rectangle {
            x: pad;
            y: y-columns;
            width: w;
            height: 36px;
            if !artist-page: TrackHeader {
                x: 0;
                width: 44px;
                text: "#";
                column: position;
            }

            TrackHeader {
                x: artist-page ? 60px : 46px;
                width: x-artist - self.x - 12px;
                text: "TITLE";
                column: title;
            }

            TrackHeader {
                x: x-artist;
                width: (show-album ? x-album : x-time) - self.x - 8px;
                text: "ARTIST";
                column: artist;
            }

            if show-album: TrackHeader {
                x: x-album;
                width: (show-date ? x-date : x-time) - self.x - 8px;
                text: "ALBUM";
                column: album;
            }

            if show-date: TrackHeader {
                x: x-date;
                width: x-time - self.x - 6px;
                text: "DATE ADDED";
                column: date-added;
            }
            TrackHeader {
                x: x-time;
                width: show-bpm ? x-bpm - self.x : 60px;
                text: "TIME";
                column: duration;
            }

            if show-bpm: TrackHeader {
                x: x-bpm;
                width: 44px;
                text: "BPM";
                column: bpm;
            }
        }

        for i in root.visible-rows: Rectangle {
            x: pad;
            y: header-h + (first + i) * row-h;
            width: w;
            height: row-h;
            background: transparent;
            visible: first + i < row-count;
            if first + i < App.tracks.length: TrackRow {
                width: parent.width;
                track: App.tracks[first + i];
                index: first + i;
                spotlight: first + i == App.pick-index && root.picking;
                album-page: root.album-page;
                artist-page: root.artist-page;
                show-bpm: root.show-bpm;
                show-date: root.show-date;
                show-album: root.show-album;
                show-time: root.show-time;
                show-heart: root.show-heart;
                stacked: root.stacked-rows;
                x-artist: root.x-artist;
                x-album: root.x-album;
                x-date: root.x-date;
                x-time: root.x-time;
                x-bpm: root.x-bpm;
            }
            if root.track-placeholders && first + i >= App.tracks.length: TrackPlaceholder {
                width: parent.width;
                x-artist: root.x-artist;
                x-album: root.show-album ? root.x-album : root.x-time;
                x-time: root.x-time;
            }
        }
        if show-tracks && App.tracks.length == 0 && !root.track-placeholders && App.loading: TideLoader {
            x: pad + (w - self.width) / 2;
            y: header-h + 72px;
        }
        if show-tracks && App.tracks.length == 0 && !root.track-placeholders && !App.loading: Text {
            x: pad;
            y: header-h + 24px;
            text: App.catalog-error ? "Couldn’t load tracks" : "Nothing here yet";
            color: Theme.text-secondary;
            font-size: 15px;
        }
        artist-content := VerticalLayout {
            x: pad;
            y: artist-page && !show-tracks ? y-tabs + 62px : search-page && !search-all ? search-tabs-y + 62px : header-h + row-count * row-h + (row-count == 0 ? 58px : 20px);
            width: w;
            height: self.preferred-height;
            spacing: 16px;
            if video-tab: CardGrid {
                title: "Videos";
                cards: root.artist-page ? App.artist-videos : App.search-videos;
                status: root.artist-page ? App.artist-videos-status : App.search-videos-status;
                empty-text: root.artist-page ? "No videos available for this artist" : "No videos found";
                error-text: "Couldn’t load videos. Try opening this page again.";
                request-art(from, upto) => { App.catalog-art(root.artist-page ? "artist-videos" : "search-videos", -1, from, upto); }
            }
            if album-tab: VerticalLayout {
                spacing: 16px;
                for group[g] in App.search-album-groups: CardGrid {
                    title: group.title;
                    wide: false;
                    cards: group.cards;
                    status: App.search-albums-status;
                    empty-text: "No albums found";
                    error-text: "Couldn’t load albums. Try opening this page again.";
                    request-art(from, upto) => { App.catalog-art("search-albums", g, from, upto); }
                }
            }
            if playlist-tab: VerticalLayout {
                spacing: 16px;
                for group[g] in App.search-playlist-groups: CardGrid {
                    title: group.title;
                    wide: false;
                    cards: group.cards;
                    status: App.search-playlists-status;
                    empty-text: "No playlists found";
                    error-text: "Couldn’t load playlists. Try opening this page again.";
                    request-art(from, upto) => { App.catalog-art("search-playlists", g, from, upto); }
                }
            }
            if album-page && App.page-release-line != "": VerticalLayout {
                padding-top: 4px;
                padding-bottom: 46px;
                spacing: 6px;
                Text {
                    text: App.page-release-line;
                    color: Theme.text-secondary;
                    font-size: 11px;
                    font-weight: Theme.demibold;
                    letter-spacing: 1.4px;
                }

                if App.page-copyright != "": Text {
                    text: App.page-copyright;
                    color: Theme.text-secondary;
                    font-size: 11px;
                    font-weight: Theme.demibold;
                    letter-spacing: 1.4px;
                    wrap: word-wrap;
                }
            }
            if album-page && App.artist-albums.length > 0: Carousel {
                section: { title: "More Albums by " + App.page-artist.title, cards: App.artist-albums };
                show-all => { App.show-artist-releases(false); }
                request-art(from, upto) => { App.artist-release-art(false, from, upto); }
            }
            if album-page && App.related-artists.length > 0: Carousel {
                section: { title: "Related Artists", cards: App.related-artists };
                view-all: false;
                request-art(from, upto) => { App.related-art(from, upto); }
            }
            if music-tab: VerticalLayout {
                spacing: 0px;
                SectionHeader {
                    title: "Albums";
                    view-all: false;
                }
                for card in App.artist-albums: SlimItem {
                    width: parent.width;
                    card: card;
                    art: 48px;
                }
                if App.artist-singles.length > 0: SectionHeader {
                    title: "EPs & Singles";
                    view-all: false;
                }
                for card in App.artist-singles: SlimItem {
                    width: parent.width;
                    card: card;
                    art: 48px;
                }
            }
            if artist-page && show-tracks && App.artist-albums.length > 0: Carousel {
                section: { title: "Albums", cards: App.artist-albums };
                show-all => { App.show-artist-releases(false); }
                request-art(from, upto) => { App.artist-release-art(false, from, upto); }
            }
            if artist-page && show-tracks && App.artist-singles.length > 0: Carousel {
                section: { title: "EPs & Singles", cards: App.artist-singles };
                show-all => { App.show-artist-releases(true); }
                request-art(from, upto) => { App.artist-release-art(true, from, upto); }
            }
            if artist-page && show-tracks && App.related-artists.length > 0: Carousel {
                section: { title: "Related Artists", cards: App.related-artists };
                view-all: false;
                request-art(from, upto) => { App.related-art(from, upto); }
            }
            if artist-page && (about || (show-tracks && App.page-biography != "")): VerticalLayout {
                spacing: 12px;
                SectionHeader {
                    title: "Biography";
                    view-all: false;
                }
                Text {
                    width: min(720px, parent.width);
                    text: App.page-biography == "" ? "No biography available" : App.page-biography;
                    color: Theme.text-secondary;
                    font-size: 15px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// ---------------------------------------------------------------- card grid

// Round header button that opens a list of choices (sort by / group by).
// Discrete artwork-size control. Left is smaller covers, right is larger.
component StepSlider inherits Rectangle {
    in property <int> value;
    callback chosen(int);
    width: 128px;
    height: 34px;
    accessible-role: slider;
    accessible-label: "Artwork size";

    property <length> track-x: 22px;
    property <length> track-w: 84px;
    property <float> t: max(0, min(4, value)) / 4;

    function pick(mx: length) -> int {
        return max(0, min(4, Math.round((mx - track-x) / track-w * 4)));
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down || e.kind == PointerEventKind.up {
                root.chosen(root.pick(self.mouse-x));
            }
        }
        moved => {
            if self.pressed {
                root.chosen(root.pick(self.mouse-x));
            }
        }
    }

    // Small 2×2 grid.
    Rectangle { x: 1px; y: 11px; width: 5px; height: 5px; border-radius: 0.5px; background: Theme.text-secondary; }
    Rectangle { x: 8px; y: 11px; width: 5px; height: 5px; border-radius: 0.5px; background: Theme.text-secondary; }
    Rectangle { x: 1px; y: 18px; width: 5px; height: 5px; border-radius: 0.5px; background: Theme.text-secondary; }
    Rectangle { x: 8px; y: 18px; width: 5px; height: 5px; border-radius: 0.5px; background: Theme.text-secondary; }

    Rectangle {
        x: track-x;
        y: 16px;
        width: track-w;
        height: 2px;
        border-radius: 1px;
        background: #404040;
    }

    Rectangle {
        x: track-x + t * track-w - 6px;
        y: 11px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: white;
    }

    // Large single square.
    Rectangle {
        x: parent.width - 14px;
        y: 10px;
        width: 14px;
        height: 14px;
        border-radius: 2px;
        border-width: 1.5px;
        border-color: Theme.text-secondary;
        background: transparent;
    }
}

export component GridView inherits Rectangle {
    property <length> pad: clamp((self.width - 900px) * 0.12, App.page-gutter, 90px);
    property <length> w: self.width - 2 * pad;
    property <length> gap: App.grid-size <= 1 ? 12px : 18px;
    property <length> min-card: App.grid-size <= 0 ? 120px : App.grid-size == 1 ? 152px : App.grid-size == 2 ? 188px : App.grid-size == 3 ? 236px : 292px;
    property <int> cols: max(2, floor((w + gap) / (min-card + gap)));
    property <bool> narrow: w < 460px;
    property <length> card-w: (w - (cols - 1) * gap) / cols;
    // Profiles have no subtitle line under the name.
    property <length> cell-h: App.grid-kind == "videos" ? card-w * 9 / 16 + 100px + gap : card-w + (App.grid-kind == "profiles" ? 40px : 76px) + gap;
    // While a track is dragged over the page, holding it near the top or
    // bottom scrolls the grid (the wheel goes to the area that holds the
    // pointer), faster the closer to the edge.
    property <length> drag-edge: 72px;
    property <length> drag-top: App.pane-y + 64px;
    property <length> drag-bottom: App.pane-y + App.pane-height - App.bar-inset;
    property <float> drag-pull: !App.drag-over-page ? 0
        : App.drag-y < drag-top + drag-edge ? (drag-top + drag-edge - App.drag-y) / drag-edge
        : App.drag-y > drag-bottom - drag-edge ? (drag-bottom - drag-edge - App.drag-y) / drag-edge : 0;
    Timer {
        interval: 16ms;
        running: root.drag-pull != 0;
        triggered => {
            App.scroll-y = clamp(App.scroll-y + root.drag-pull * 18px, min(0px, sv.visible-height - sv.content-height), 0px);
        }
    }
    sv := ScrollView {
        content-y <=> App.scroll-y;
        VerticalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            padding-top: 8px;
            padding-bottom: 24px + App.bar-inset;
            spacing: 0px;
            alignment: start;
            Rectangle {
                height: 38px;
                HorizontalLayout {
                    width: 100%;
                    spacing: 12px;
                    HorizontalLayout {
                        horizontal-stretch: root.narrow ? 1 : 0;
                        spacing: 6px;
                        Text {
                            text: App.page-title;
                            color: Theme.text;
                            font-size: 28px;
                            font-weight: 700;
                            vertical-alignment: center;
                            // A long folder name gives way to the buttons.
                            overflow: elide;
                            min-width: 60px;
                            horizontal-stretch: root.narrow ? 1 : 0;
                        }

                        Rectangle {
                            width: 10px;
                        }

                        if App.grid-sort-options.length > 0: VerticalLayout {
                            alignment: center;
                            ChoiceButton {
                                icon: @image-url("icons/sort.svg");
                                heading: "SORT BY";
                                options: App.grid-sort-options;
                                current: App.grid-sort;
                                chosen(option) => { App.set-grid-sort(option); }
                            }
                        }
                        if App.grid-group-options.length > 1: VerticalLayout {
                            alignment: center;
                            ChoiceButton {
                                icon: @image-url("icons/group.svg");
                                heading: "GROUP BY";
                                options: App.grid-group-options;
                                current: App.grid-group;
                                highlighted: App.grid-group != "None";
                                toggle-label: App.grid-kind == "playlists" ? "Combine other users" : "";
                                toggle-on: App.grid-combine-others;
                                chosen(option) => { App.set-grid-group(option); }
                                toggled(v) => { App.set-grid-combine-others(v); }
                            }
                        }
                        if App.grid-can-create: VerticalLayout {
                            alignment: center;
                            CreateButton {
                                size: 18px;
                            }
                        }
                    }
                    if !root.narrow: Rectangle {
                        horizontal-stretch: 1;
                    }
                    // Phone width: no room for the artwork size; the cards fill two columns.
                    if !root.narrow: VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        StepSlider {
                            value: App.grid-size;
                            chosen(step) => { App.set-grid-size(step); }
                        }
                    }
                }
            }

            Rectangle {
                height: 26px;
            }

            Rectangle {
                height: 44px;
                border-radius: 8px;
                border-width: 1px;
                border-color: filter.has-focus ? #3a3a3a : Theme.border;
                Icon {
                    x: 16px;
                    source: @image-url("icons/search.svg");
                    size: 16px;
                }

                if filter.text == "": Text {
                    x: 49px;
                    text: App.grid-filter-hint;
                    color: #aeafb2;
                    font-size: 15px;
                    vertical-alignment: center;
                }
                // "/" focuses this field (platform::configure_input).
                if filter.text == "": Kbd {
                    x: parent.width - self.width - 12px;
                    y: (parent.height - self.height) / 2;
                    glyph: "/";
                }
                filter := EditableInput {
                    x: 49px;
                    width: parent.width - 65px - (self.text == "" ? 32px : 0px);
                    height: 20px;
                    text <=> App.filter-text;
                    color: Theme.text;
                    font-size: 15px;
                    single-line: true;
                    vertical-alignment: center;
                    selection-background-color: #4a4a4a;
                    edited => {
                        App.filter(self.text);
                    }
                    // Enter plays the picked playlist / album / artist (opens a folder).
                    accepted => { App.play-grid-pick(); }
                    property <bool> filter-has-focus: self.has-focus;
                    changed filter-has-focus => { App.filter-focused = self.filter-has-focus; }
                    init => {
                        App.filter-focused = false;
                        self.take-filter-focus();
                    }
                    property <int> focus-request: App.focus-filter;
                    changed focus-request => { self.take-filter-focus(); }
                    function take-filter-focus() {
                        if App.focus-filter != App.focus-filter-seen {
                            App.focus-filter-seen = App.focus-filter;
                            self.focus();
                            self.select-all();
                        }
                    }
                }
            }

            Rectangle {
                height: 36px;
            }

            if App.grid-cards.length == 0 && App.loading: Rectangle {
                height: 280px;
                TideLoader { }
            }
            if App.grid-cards.length == 0 && !App.loading: Text {
                text: App.filter-text != "" ? "Nothing matches “" + App.filter-text + "”" : "Nothing here yet";
                color: Theme.text-secondary;
                font-size: 15px;
            }
            for group[g] in App.grid-groups: grp := VerticalLayout {
                // A card flying in from another group passes over the groups after it.
                z: App.grid-fly-group == g ? 1 : 0;
                // Group header in the style of a library "group by" view:
                // a rule, the group name and how many items it holds.
                if group.title != "": Rectangle {
                    height: 58px;
                    Rectangle {
                        y: 0px;
                        height: 1px;
                        background: #1f1f1f;
                    }

                    Text {
                        x: 0px;
                        y: 14px;
                        width: parent.width - 120px;
                        text: group.title;
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: Theme.bold;
                        overflow: elide;
                    }

                    Text {
                        x: parent.width - 120px;
                        y: 20px;
                        width: 120px;
                        text: group.cards.length + (group.cards.length == 1 ? " ITEM" : " ITEMS");
                        color: Theme.text-secondary;
                        font-size: 11px;
                        font-weight: Theme.demibold;
                        letter-spacing: 1px;
                        horizontal-alignment: right;
                    }
                }
                // The ungrouped rest under the Pinned group: just the rule between them.
                if group.title == "" && g > 0: Rectangle {
                    height: 28px;
                    Rectangle {
                        y: 0px;
                        height: 1px;
                        background: #1f1f1f;
                    }
                }
                cells := Rectangle {
                    property <int> n: group.cards.length;
                    property <int> first-row: max(0, floor((-art.absolute-position.y - art.overscan) / root.cell-h));
                    property <int> vis-rows: max(1, ceil((art.overscan + max(App.pane-height, 1px) + art.overscan) / root.cell-h));
                    height: ceil(n / root.cols) * root.cell-h;
                    art := ArtRequest {
                        width: 100%;
                        height: 100%;
                        window-height: App.pane-height;
                        from: first-row * root.cols;
                        upto: min(n, (first-row + vis-rows) * root.cols);
                        request(from, upto) => { App.grid-art(g, from, upto); }
                    }
                    for card[i] in group.cards: GridItem {
                        slot-x: mod(i, root.cols) * (root.card-w + root.gap);
                        slot-y: floor(i / root.cols) * root.cell-h;
                        group-y: grp.y + cells.y;
                        width: root.card-w;
                        card: card;
                        hover-panel: true;
                        spotlight: App.filter-focused && card.id == App.grid-pick-id;
                        drop-zone: true;
                    }
                }
            }
        }
    }
}

export component StubView inherits Rectangle {
    VerticalLayout {
        padding-bottom: App.bar-inset;
        alignment: center;
        spacing: 10px;
        Text {
            text: App.page-title;
            color: Theme.text;
            font-size: 28px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: "This section isn't available in tidal-rust yet.";
            color: Theme.text-secondary;
            font-size: 15px;
            horizontal-alignment: center;
        }
    }
}

// ---------------------------------------------------------------- collection

// A place in My Collection, as a row of the Collection tab.
component CollectionRow inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <string> key;
    height: 52px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { App.navigate(root.key); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { App.navigate(root.key); }
    }
    Rectangle {
        x: -8px;
        width: parent.width + 16px;
        border-radius: 10px;
        background: ta.has-hover ? #141414 : transparent;
    }
    Icon {
        x: 2px;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        size: 20px;
        tint: Theme.text;
    }
    Text {
        x: 38px;
        width: parent.width - self.x - 28px;
        text: root.label;
        color: Theme.text;
        font-size: 16px;
        font-weight: Theme.demibold;
        overflow: elide;
        vertical-alignment: center;
    }
    Icon {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        source: @image-url("icons/chevron-right.svg");
        size: 16px;
        tint: Theme.text-secondary;
    }
}

// The Collection tab of the phone layout: what the sidebar offers on a wider
// window, My Collection's pages and then every playlist and folder.
export component CollectionView inherits Rectangle {
    property <length> pad: App.page-gutter;
    ScrollView {
        content-y <=> App.scroll-y;
        VerticalLayout {
            padding-top: 8px;
            padding-bottom: 24px + App.bar-inset;
            alignment: start;
            VerticalLayout {
                padding-left: root.pad;
                padding-right: root.pad;
                Text {
                    height: 48px;
                    text: "Collection";
                    color: Theme.text;
                    font-size: 28px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { height: 10px; }
                CollectionRow { label: "Mixes"; key: "mixes"; icon: @image-url("icons/radio.svg"); }
                CollectionRow { label: "Playlists"; key: "playlists"; icon: @image-url("icons/playlist.svg"); }
                CollectionRow { label: "Albums"; key: "albums"; icon: @image-url("icons/disc.svg"); }
                CollectionRow { label: "Tracks"; key: "tracks"; icon: @image-url("icons/music.svg"); }
                CollectionRow { label: "Videos"; key: "videos"; icon: @image-url("icons/video.svg"); }
                CollectionRow { label: "Profiles"; key: "profiles"; icon: @image-url("icons/key.svg"); }
                CollectionRow { label: "Save for Later"; key: "later"; icon: @image-url("icons/bookmark.svg"); }
                Rectangle {
                    height: 70px;
                    Text {
                        x: 0px;
                        y: 28px;
                        text: "All playlists";
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: 700;
                    }
                    CreateButton {
                        x: parent.width - 66px;
                        y: 22px;
                        size: 18px;
                    }
                    IconButton {
                        x: parent.width - 34px;
                        y: 22px;
                        icon: @image-url("icons/sort.svg");
                        size: 18px;
                        tint: App.sidebar-ascending ? Theme.text-secondary : Theme.text;
                        clicked => { App.sort-playlists(); }
                    }
                }
            }
            // The sidebar's own rows: 16px in, as this page's margin.
            for card in App.sidebar-playlists: SidebarPlaylist {
                compact: false;
                card: card;
            }
            if App.sidebar-playlists.length == 0: HorizontalLayout {
                padding-left: root.pad;
                Text {
                    text: "No playlists yet";
                    color: Theme.text-secondary;
                    font-size: 15px;
                }
            }
        }
    }
}

// ---------------------------------------------------------------- now playing

// One line of the lyrics column. Reports its place when it becomes the line
// being sung, so the column can scroll to it.
component LyricRow inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> synced;
    in property <length> font-size;
    callback picked();
    callback current(length, length);

    init => { if (root.active) { root.current(root.y, root.height); } }
    changed active => { if (root.active) { root.current(root.y, root.height); } }
    changed y => { if (root.active) { root.current(root.y, root.height); } }
    changed height => { if (root.active) { root.current(root.y, root.height); } }

    // How bright the line is; edge fading is applied per-pixel by the column's
    // bounded GPU mask so rolling lines never mutate every row's colour each frame.
    property <float> level: root.active ? 1 : !root.synced ? 0.82 : ta.has-hover ? 0.7 : 0.38;
    animate level { duration: 280ms; easing: ease-out; }

    // The gap to the next line is part of the line, so a click between two
    // lines still lands on one.
    VerticalLayout {
        padding-top: root.font-size * 0.4;
        padding-bottom: root.font-size * 0.4;
        Text {
            text: root.text;
            color: #ffffff.with-alpha(root.level);
            font-size: root.font-size;
            font-weight: 600;
            wrap: word-wrap;
        }
    }
    ta := TouchArea {
        enabled: root.synced;
        mouse-cursor: root.synced ? pointer : default;
        clicked => { root.picked(); }
    }
}

// The lyrics: every line, the one being sung kept a little above the middle,
// fading smoothly per-pixel at the top and bottom edges. Scrolling by hand
// stops following (with macOS elastic rubber-band overscroll) until "Sync lyrics"
// is clicked.
component LyricsColumn inherits Rectangle {
    // Expansion times the lyrics transition: how much of the column shows.
    in property <float> reveal: 1;
    in property <length> font-size: 22px;
    in property <bool> glass: false;
    in property <bool> interactive: true;
    clip: true;
    opacity: root.reveal;
    cache-rendering-hint: root.reveal > 0 && root.reveal < 1;
    accessible-role: AccessibleRole.list;
    accessible-label: "Lyrics text";

    property <length> band: min(root.height * 0.16, 88px);
    // Where the middle of the line being sung rests.
    property <length> anchor: root.height * 0.38;
    property <bool> following: true;
    property <length> active-y: 0px;
    property <length> active-h: 0px;
    property <length> max-offset: max(0px, lines.preferred-height - root.height);
    property <length> follow: clamp(root.active-y + root.active-h / 2 - root.anchor, 0px, root.max-offset);
    animate follow { duration: 480ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    property <length> manual: 0px;
    // 1 while following; eases back to the song on "Sync lyrics", lets go at
    // once when scrolled by hand.
    property <float> mix: root.following ? 1 : 0;
    animate mix { duration: root.following ? 520ms : 0ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    property <length> offset: root.manual + (root.follow - root.manual) * root.mix;
    // Elastic macOS rubber-band overscroll when pulling past either end.
    property <length> over-raw: 0px;
    property <float> over-abs: abs(root.over-raw / 1px);
    property <length> over-damped: (root.over-raw >= 0px ? 1px : -1px) * (root.over-abs / (1 + root.over-abs / 110)) * 0.55;
    property <length> overscroll: App.np-scroll-touching ? root.over-damped : 0px;
    animate overscroll { duration: App.np-scroll-touching ? 0ms : 340ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    property <bool> touching: App.np-scroll-touching;
    changed touching => {
        if (!root.touching) {
            root.over-raw = 0px;
        }
    }
    property <length> shown-offset: root.offset + root.overscroll;

    // A new track starts at the top, following.
    property <string> track: App.current-id;
    changed track => { root.resync(); root.active-y = 0px; root.active-h = 0px; }
    property <bool> open: App.show-now-playing;
    changed open => { if (root.open) { root.resync(); } }
    function resync() { root.following = true; root.over-raw = 0px; }

    scroller := TouchArea {
        scroll-event(e) => {
            if (e.delta-y == 0) {
                return reject;
            }
            if (root.following) {
                root.manual = root.offset;
                root.following = false;
            }
            if (root.over-raw != 0px) {
                let unwound = root.over-raw - e.delta-y;
                if ((root.over-raw < 0px && unwound < 0px) || (root.over-raw > 0px && unwound > 0px)) {
                    root.over-raw = clamp(unwound, -240px, 240px);
                    return accept;
                }
                root.over-raw = 0px;
            }
            let next = root.manual - e.delta-y;
            if (next < 0px) {
                root.manual = 0px;
                if (App.np-scroll-touching) {
                    root.over-raw = clamp(root.over-raw + next, -240px, 0px);
                }
            } else if (next > root.max-offset) {
                let extra = next - root.max-offset;
                root.manual = root.max-offset;
                if (App.np-scroll-touching) {
                    root.over-raw = clamp(root.over-raw + extra, 0px, 240px);
                }
            } else {
                root.manual = next;
            }
            return accept;
        }

        // Bounded vertical edge-fade mask (vendor/i-slint-renderer-skia/fade.rs)
        // also enables subpixel glyph positioning inside so rolling lines glide at 120 Hz.
        Rectangle {
            width: 100%;
            height: 100%;
            background: @conic-gradient(at root.band root.band, #46414401 0deg, #46414401 360deg);

            lines := VerticalLayout {
                y: -root.shown-offset;
                width: root.width;
                height: self.preferred-height;
                padding-top: root.band;
                padding-bottom: root.height - root.anchor;
                for line[i] in App.lyrics: LyricRow {
                    text: line.text;
                    active: i == App.lyric-index;
                    synced: App.lyrics-synced && line.time >= 0 && root.interactive;
                    font-size: root.font-size;
                    visible: self.y + self.height >= root.shown-offset - 48px
                        && self.y <= root.shown-offset + root.height + 48px;
                    current(y, h) => {
                        root.active-y = y;
                        root.active-h = h;
                    }
                    picked => {
                        root.resync();
                        App.seek-lyric(i);
                    }
                }
            }
        }
    }

    if !root.following && App.lyrics-synced && root.reveal >= 1: Rectangle {
        x: parent.width - self.width - 4px;
        y: parent.height - self.height - 8px;
        width: sync-label.preferred-width + 28px;
        height: 32px;
        border-radius: 16px;
        background: root.glass ? (sync-ta.has-hover ? @conic-gradient(#474c5301 0deg, #ffffff3d 360deg) : @conic-gradient(#474c5301 0deg, #ffffff26 360deg))
            : sync-ta.has-hover ? #ffffff3d : #ffffff26;
        accessible-role: button;
        accessible-label: "Sync lyrics";
        accessible-action-default => { root.resync(); }
        sync-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.resync(); }
        }
        sync-label := Text {
            text: "Sync lyrics";
            color: white;
            font-size: 13px;
            font-weight: 600;
        }
    }
}

// One upcoming track in Now Playing's Queue column.
component QueueRow inherits Rectangle {
    in property <TrackData> track;
    in property <bool> interactive: true;
    in property <bool> show-divider: true;
    callback play();

    property <bool> hot: body.has-hover || more-ta.has-hover;
    property <bool> show-time: root.width >= 320px && root.track.duration != "";
    property <length> right-w: root.show-time ? 84px : 44px;

    height: 58px;
    border-radius: 10px;
    background: root.hot ? #ffffff1a : transparent;

    body := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.track.title + (root.track.artist != "" ? " by " + root.track.artist : "");
        accessible-action-default => { root.play(); }
        clicked => { root.play(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                App.request-track-menu(root.track.id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    Cover {
        x: 8px;
        y: 8px;
        width: 42px;
        height: 42px;
        radius: 6px;
        source: root.track.cover;
    }

    Rectangle {
        x: 8px;
        y: 8px;
        width: 42px;
        height: 42px;
        border-radius: 6px;
        background: root.hot ? #00000073 : transparent;
        if root.hot: Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: @image-url("icons/play.svg");
            size: 16px;
            tint: white;
        }
    }

    VerticalLayout {
        x: 62px;
        width: max(0px, parent.width - 62px - root.right-w);
        height: 100%;
        alignment: center;
        spacing: 2px;
        HorizontalLayout {
            alignment: start;
            spacing: 6px;
            Text {
                text: root.track.title;
                color: white;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
            }
            if root.track.explicit: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                ExplicitBadge { }
            }
        }
        Text {
            text: root.track.album != "" ? root.track.artist + " — " + root.track.album : root.track.artist;
            color: #ffffff9e;
            font-size: 12.5px;
            overflow: elide;
        }
    }

    if root.show-time: Text {
        x: parent.width - 80px;
        width: 38px;
        height: 100%;
        text: root.track.duration;
        color: #ffffff78;
        font-size: 12px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }

    Rectangle {
        x: parent.width - 38px;
        y: (parent.height - self.height) / 2;
        width: 32px;
        height: 32px;
        border-radius: 16px;
        background: more-ta.has-hover ? #ffffff22 : transparent;
        animate background { duration: 120ms; easing: ease-out; }
        accessible-role: button;
        accessible-label: "Track options";
        accessible-action-default => {
            App.request-track-menu(root.track.id, self.absolute-position.x, self.absolute-position.y + self.height);
        }
        more-ta := TouchArea {
            enabled: root.interactive;
            mouse-cursor: pointer;
            clicked => {
                App.request-track-menu(root.track.id, self.absolute-position.x, self.absolute-position.y + self.height);
            }
        }
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: @image-url("icons/more.svg");
            size: 16px;
            tint: more-ta.has-hover ? white : #ffffff80;
        }
    }

    if root.show-divider: Rectangle {
        x: 62px;
        y: parent.height - 1px;
        width: max(0px, parent.width - 70px);
        height: 1px;
        background: #ffffff14;
    }
}

// Upcoming tracks beside the artwork in Now Playing: borderless like Lyrics,
// floating directly over the backdrop wash with 1:1 macOS trackpad scroll,
// elastic rubber-band overscroll, and soft per-pixel edge fades.
component QueueColumn inherits Rectangle {
    in property <float> reveal: 1;
    in property <bool> interactive: true;

    property <length> header-h: App.np-context != "" ? 56px : 36px;
    property <length> row-h: 58px;
    property <length> list-pad: 4px;
    property <length> view-h: max(0px, root.height - root.header-h);
    property <length> content-h: App.np-queue.length * root.row-h + 2 * root.list-pad;
    property <length> max-scroll: max(0px, root.content-h - root.view-h);
    property <length> scroll: 0px;
    // Elastic macOS rubber-band overscroll when pulling past the top or bottom.
    property <length> over-raw: 0px;
    property <float> over-abs: abs(root.over-raw / 1px);
    property <length> over-damped: (root.over-raw >= 0px ? 1px : -1px) * (root.over-abs / (1 + root.over-abs / 110)) * 0.55;
    property <length> overscroll: App.np-scroll-touching ? root.over-damped : 0px;
    animate overscroll { duration: App.np-scroll-touching ? 0ms : 340ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    property <bool> touching: App.np-scroll-touching;
    changed touching => {
        if (!root.touching) {
            root.over-raw = 0px;
        }
    }
    property <length> shown-scroll: root.scroll + root.overscroll;
    // Match LyricsColumn's soft edge fade (0.16 of height) so scrolled rows
    // dissolve smoothly at both edges without hard-clipping. At scroll 0 the
    // top stays crisp under the header; at the bottom the last track clears.
    property <length> fade-band: min(root.view-h * 0.16, 72px);
    property <length> top-fade: min(max(0px, root.shown-scroll) * 1.5, root.fade-band);
    property <length> bottom-fade: min(max(0px, root.max-scroll - root.shown-scroll) * 1.5, root.fade-band);
    property <int> first: max(0, floor((root.shown-scroll - root.list-pad) / root.row-h));
    property <int> visible-rows: max(1, ceil(max(1px, root.view-h) / root.row-h) + 2);
    property <int> queue-len: App.np-queue.length;
    property <string> current-track: App.current-id;

    clip: true;
    opacity: root.reveal;
    cache-rendering-hint: root.reveal > 0 && root.reveal < 1;
    accessible-role: AccessibleRole.list;
    accessible-label: "Play queue";

    init => {
        if (self.visible) {
            App.np-queue-visible(root.first, root.visible-rows);
        }
    }
    changed first => {
        if (self.visible) {
            App.np-queue-visible(root.first, root.visible-rows);
        }
    }
    changed visible-rows => {
        if (self.visible) {
            App.np-queue-visible(root.first, root.visible-rows);
        }
    }
    changed current-track => {
        root.scroll = 0px;
        root.over-raw = 0px;
        if (self.visible) {
            App.np-queue-visible(0, root.visible-rows);
        }
    }
    // Now Playing keeps the column while another tab is on screen, and lets
    // its covers go meanwhile: ask for them again when it comes back.
    changed visible => {
        if (self.visible) {
            App.np-queue-visible(root.first, root.visible-rows);
        }
    }
    changed queue-len => {
        if (root.scroll > root.max-scroll) {
            root.scroll = root.max-scroll;
        }
        if (self.visible) {
            App.np-queue-visible(root.first, root.visible-rows);
        }
    }

    // Header: Continue Playing and clickable source context.
    Rectangle {
        y: 0px;
        width: parent.width;
        height: root.header-h;
        Text {
            x: 8px;
            y: 0px;
            width: max(0px, parent.width - 16px);
            text: "Continue Playing";
            color: white;
            font-size: 18px;
            font-weight: 700;
            overflow: elide;
        }
        if App.np-context != "": Rectangle {
            x: 8px;
            y: 25px;
            width: max(0px, parent.width - 16px);
            height: 20px;
            ctx-ta := TouchArea {
                enabled: root.interactive;
                mouse-cursor: pointer;
                clicked => { App.open-now-playing-context(); }
            }
            Text {
                width: 100%;
                height: 100%;
                text: "From " + App.np-context;
                color: ctx-ta.has-hover ? #ffffffd9 : #ffffff94;
                font-size: 13px;
                overflow: elide;
                vertical-alignment: center;
            }
        }
        Rectangle {
            x: 8px;
            y: parent.height - 1px;
            width: max(0px, parent.width - 16px);
            height: 1px;
            background: #ffffff1c;
        }
    }

    // Direct 1:1 macOS trackpad viewport with elastic overscroll and bounded
    // vertical edge-fade mask (vendor/i-slint-renderer-skia/fade.rs).
    Rectangle {
        x: 0px;
        y: root.header-h;
        width: parent.width;
        height: root.view-h;
        clip: true;

        q-scroller := TouchArea {
            scroll-event(e) => {
                if (e.delta-y == 0 || !root.interactive || App.np-queue.length == 0) {
                    return reject;
                }
                if (root.over-raw != 0px) {
                    let unwound = root.over-raw - e.delta-y;
                    if ((root.over-raw < 0px && unwound < 0px) || (root.over-raw > 0px && unwound > 0px)) {
                        root.over-raw = clamp(unwound, -240px, 240px);
                        return accept;
                    }
                    root.over-raw = 0px;
                }
                let next = root.scroll - e.delta-y;
                if (next < 0px) {
                    root.scroll = 0px;
                    if (App.np-scroll-touching) {
                        root.over-raw = clamp(root.over-raw + next, -240px, 0px);
                    }
                } else if (next > root.max-scroll) {
                    let extra = next - root.max-scroll;
                    root.scroll = root.max-scroll;
                    if (App.np-scroll-touching) {
                        root.over-raw = clamp(root.over-raw + extra, 0px, 240px);
                    }
                } else {
                    root.scroll = next;
                }
                return accept;
            }

            Rectangle {
                width: 100%;
                height: 100%;
                background: @conic-gradient(at root.top-fade root.bottom-fade, #46414401 0deg, #46414401 360deg);

                for i in root.visible-rows: Rectangle {
                    x: 0px;
                    y: root.list-pad + (root.first + i) * root.row-h - root.shown-scroll;
                    width: max(0px, root.width - 8px);
                    height: root.row-h;
                    background: transparent;
                    visible: root.first + i < App.np-queue.length;
                    if root.first + i < App.np-queue.length: QueueRow {
                        width: parent.width;
                        height: parent.height;
                        track: App.np-queue[root.first + i];
                        interactive: root.interactive;
                        show-divider: root.first + i + 1 < App.np-queue.length;
                        play => { App.play-queue-index(root.first + i); }
                    }
                }
            }
        }
    }

    if root.content-h > root.view-h && root.view-h > 20px: Rectangle {
        property <length> track-h: root.view-h - 12px;
        property <length> base-thumb-h: clamp(self.track-h * (root.view-h / max(1px, root.content-h)), 28px, self.track-h);
        property <length> thumb-h: max(20px, self.base-thumb-h - abs(root.overscroll / 1px) * 0.4px);
        property <float> frac: clamp(root.shown-scroll / max(1px, root.max-scroll), 0, 1);
        x: parent.width - 4px;
        y: root.header-h + 6px + (self.track-h - self.thumb-h) * self.frac;
        width: 3px;
        height: self.thumb-h;
        border-radius: 1.5px;
        background: #ffffff38;
    }

    if App.np-queue.length == 0: VerticalLayout {
        x: 16px;
        y: root.header-h;
        width: max(0px, parent.width - 32px);
        height: max(0px, parent.height - root.header-h);
        alignment: center;
        spacing: 8px;
        HorizontalLayout {
            alignment: center;
            Icon {
                source: @image-url("icons/queue.svg");
                size: 28px;
                tint: #ffffff4d;
            }
        }
        Text {
            text: "Nothing up next";
            color: #ffffffc0;
            font-size: 15px;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: "Use Play next on any track to queue it here.";
            color: #ffffff70;
            font-size: 13px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// A radio mix in Now Playing's Similar tracks tab: opens the mix, or plays
// it from the button that shows on hover.
component RadioCard inherits Rectangle {
    in property <CardData> card;
    in property <bool> interactive: true;
    property <length> art: 152px;
    width: root.art;
    height: root.art + 52px;
    accessible-role: button;
    accessible-label: root.card.title + ", " + root.card.subtitle;
    accessible-action-default => { App.open-card(root.card); }
    Cover {
        y: 0px;
        width: root.art;
        height: root.art;
        radius: 6px;
        source: root.card.image;
        // The mix's name over its artwork, as TIDAL draws radio covers.
        Rectangle {
            y: parent.height * 0.5;
            height: parent.height * 0.5;
            background: @linear-gradient(180deg, #00000000 0%, #000000b8 100%);
        }
        Text {
            x: 10px;
            y: parent.height - 46px;
            width: parent.width - 20px;
            text: root.card.subtitle == "Artist radio" ? "Artist Radio" : "Track Radio";
            color: #ffffffb8;
            font-size: 11px;
            font-weight: 600;
            overflow: elide;
        }
        Text {
            x: 10px;
            y: parent.height - 30px;
            width: parent.width - 20px;
            text: root.card.title;
            color: white;
            font-size: 15px;
            font-weight: 700;
            overflow: elide;
        }
    }
    ta := TouchArea {
        enabled: root.interactive;
        mouse-cursor: pointer;
        clicked => { App.open-card(root.card); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                App.request-card-menu(root.card, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        // Over the art; keeps the hover while the pointer is on it.
        if ta.has-hover: Rectangle {
            x: root.art - self.width - 8px;
            y: 8px;
            width: 34px;
            height: 34px;
            border-radius: 17px;
            background: play-ta.has-hover ? white : #ffffffe0;
            accessible-role: button;
            accessible-label: "Play " + root.card.title + " " + root.card.subtitle;
            accessible-action-default => { App.play-card(root.card); }
            play-ta := TouchArea {
                enabled: root.interactive;
                mouse-cursor: pointer;
                clicked => { App.play-card(root.card); }
            }
            Icon {
                x: (parent.width - self.width) / 2 + 1px;
                y: (parent.height - self.height) / 2;
                source: @image-url("icons/play.svg");
                size: 14px;
                tint: black;
            }
        }
    }
    Text {
        y: root.art + 10px;
        width: root.art;
        text: root.card.title;
        color: white;
        font-size: 14px;
        font-weight: 600;
        overflow: elide;
    }
    Text {
        y: root.art + 30px;
        width: root.art;
        text: root.card.subtitle;
        color: #ffffff94;
        font-size: 13px;
        overflow: elide;
    }
}

// The scrolling body of Similar tracks and Credits, its edges fading as
// Lyrics and Queue do (vendor/i-slint-renderer-skia/fade.rs).
component NpTabScroll inherits Rectangle {
    in property <bool> interactive: true;
    in property <length> content-h;
    out property <length> scroll: -flick.content-y;
    property <length> fade-band: min(root.height * 0.16, 72px);
    property <length> top-fade: min(max(0px, root.scroll) * 1.5, root.fade-band);
    property <length> bottom-fade: min(max(0px, root.content-h - root.height - root.scroll) * 1.5, root.fade-band);
    clip: true;
    Rectangle {
        background: @conic-gradient(at root.top-fade root.bottom-fade, #46414401 0deg, #46414401 360deg);
        flick := Flickable {
            interactive: root.interactive;
            content-height: max(root.height, root.content-h);
            @children
        }
    }
}

// Now Playing's Similar tracks tab: the artist's and the track's radio, then
// TIDAL's suggestions for the track.
component SimilarColumn inherits Rectangle {
    in property <float> reveal: 1;
    in property <bool> interactive: true;
    // Fades in when the first answer for a track arrives (loaded ahead, so
    // usually before the tab is opened).
    property <float> ready: App.np-similar.length > 0 || App.np-radios.length > 0 || App.np-similar-status != "" ? 1 : 0;
    animate ready { duration: 220ms; easing: ease-out; }
    opacity: root.reveal * root.ready;
    cache-rendering-hint: self.opacity > 0 && self.opacity < 1;
    accessible-role: AccessibleRole.list;
    accessible-label: "Similar tracks";
    NpTabScroll {
        interactive: root.interactive;
        content-h: body.preferred-height;
        body := VerticalLayout {
            width: root.width;
            alignment: start;
            padding-bottom: 16px;
            if App.np-radios.length > 0: HorizontalLayout {
                padding-left: 8px;
                Text {
                    height: 40px;
                    text: "Mixes & Radio";
                    color: white;
                    font-size: 18px;
                    font-weight: 700;
                }
            }
            if App.np-radios.length > 0: HorizontalLayout {
                alignment: start;
                padding-left: 8px;
                padding-bottom: 28px;
                spacing: 16px;
                for card in App.np-radios: RadioCard {
                    card: card;
                    interactive: root.interactive;
                }
            }
            if App.np-similar.length > 0: HorizontalLayout {
                padding-left: 8px;
                Text {
                    height: 40px;
                    text: "Suggested tracks";
                    color: white;
                    font-size: 18px;
                    font-weight: 700;
                }
            }
            for track[i] in App.np-similar: QueueRow {
                track: track;
                interactive: root.interactive;
                show-divider: i + 1 < App.np-similar.length;
                play => { App.play-np-similar(i); }
            }
            if App.np-similar-status != "": HorizontalLayout {
                padding-left: 8px;
                Text {
                    text: App.np-similar-status;
                    color: #ffffff94;
                    font-size: 14px;
                }
            }
        }
    }
}

// Now Playing's Credits tab: each role and who filled it, then the release
// year and label.
component CreditsColumn inherits Rectangle {
    in property <float> reveal: 1;
    in property <bool> interactive: true;
    property <float> ready: App.np-credits.length > 0 || App.np-credits-status != "" ? 1 : 0;
    animate ready { duration: 220ms; easing: ease-out; }
    opacity: root.reveal * root.ready;
    cache-rendering-hint: self.opacity > 0 && self.opacity < 1;
    accessible-role: AccessibleRole.list;
    accessible-label: "Credits";
    NpTabScroll {
        interactive: root.interactive;
        content-h: body.preferred-height;
        body := VerticalLayout {
            width: root.width;
            // Centred beside the artwork while it fits.
            height: max(root.height, self.preferred-height);
            alignment: center;
            padding-left: 8px;
            padding-right: 8px;
            spacing: 20px;
            for line in App.np-credits: VerticalLayout {
                spacing: 4px;
                Text {
                    text: line.role;
                    color: white;
                    font-size: 15px;
                    font-weight: 600;
                }
                Text {
                    text: line.names;
                    color: #ffffffa6;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }
            if App.np-credits-status != "": Text {
                text: App.np-credits-status;
                color: #ffffff94;
                font-size: 14px;
            }
        }
    }
}

// Title, artist and favourite under the artwork, where the player bar has no
// room for them (App.compact-layout).
component NowPlayingMeta inherits Rectangle {
    in property <float> reveal: 1;
    height: 52px;
    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                spacing: 8px;
                title-ta := TouchArea {
                    horizontal-stretch: 1;
                    enabled: App.np-album-id != "";
                    mouse-cursor: self.enabled ? pointer : default;
                    clicked => { App.open-now-playing-album(); }
                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        Text {
                            text: App.np-title;
                            color: #ffffff.with-alpha(root.reveal);
                            font-size: 18px;
                            font-weight: 600;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        // Shown once the view is mostly open: fading it would
                        // need a layer for 16 pixels.
                        if App.np-explicit && root.reveal > 0.5: VerticalLayout {
                            alignment: center;
                            ExplicitBadge { }
                        }
                    }
                }
            }
            artist-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { App.open-now-playing-artist(); }
                Text {
                    width: 100%;
                    text: App.np-artist;
                    color: #ffffff.with-alpha(root.reveal * (artist-ta.has-hover ? 0.85 : 0.6));
                    font-size: 14px;
                    overflow: elide;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            IconButton {
                icon: App.np-favorite ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
                size: 20px;
                tint: #ffffff.with-alpha(root.reveal);
                hover-tint: #ffffff.with-alpha(root.reveal);
                accessible-role: button;
                accessible-label: App.np-favorite ? "Remove from My Collection" : "Add to My Collection";
                clicked => { App.toggle-favorite(App.current-id); }
            }
        }
    }
}

export component NowPlayingView inherits Rectangle {
    out property <float> expansion: App.show-now-playing ? 1 : 0;
    animate expansion { duration: 250ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
    // Re-evaluated when the animation starts and ends, not every frame, so it
    // doesn't invalidate the cached layers below.
    out property <bool> presenting: App.show-now-playing || root.expansion > 0;
    // Fully open, the view hides the page's player bar: it need not be glass.
    changed expansion => { App.bar-covered = self.expansion >= 1; }
    // Fading a group needs an offscreen layer; Skia sizes it to the whole
    // window, several times a frame. While the view animates, each faded group
    // renders once into a texture of its own size, which is blended instead.
    // Off at rest, where the cache would crop hover tips. Compare `expansion`
    // directly: a property derived from an animated one isn't refreshed
    // while the animation runs.
    // Faded through its colours: `opacity` with `visible` makes it a group.
    Rectangle {
        visible: root.presenting;
        background: @linear-gradient(180deg, App.np-tint.with-alpha(root.expansion) 0%, App.np-tint.darker(0.6).with-alpha(root.expansion) 55%, #1a1716.with-alpha(root.expansion) 100%);
    }
    // Glass: the cover's colours wash the whole view when available, while the
    // chrome controls still render as Liquid Glass whenever App.glass is on.
    property <bool> glass: App.glass;
    property <bool> backdrop-glass: App.glass && App.np-backdrop.width > 0;
    if root.backdrop-glass && root.presenting: Image {
        width: 100%;
        height: 100%;
        source: App.np-backdrop;
        image-fit: fill;
        image-rendering: smooth;
        opacity: root.expansion;
    }
    if root.backdrop-glass && root.presenting: Rectangle {
        background: @linear-gradient(180deg, #000000.with-alpha(0.34 * root.expansion) 0%, #000000.with-alpha(0.5 * root.expansion) 60%, #000000.with-alpha(0.62 * root.expansion) 100%);
    }
    // The collapsed artwork lets the original player-bar hit area handle clicks.
    TouchArea { enabled: root.presenting; }
    DragArea { y: 0px; height: 64px; enabled: App.show-now-playing; }

    // ------------------------------------------------------------ layout
    // Three arrangements, after TIDAL's own: wide (art centred, or art left
    // with lyrics or queue right), and narrow, one column: art over the title,
    // the transport below (the overlay player bar, compact), the active panel
    // taking the art's place with the art shrunk beside the title.
    property <bool> narrow: root.width < 720px;
    // The overlay bar shows no title when compact: Now Playing does.
    property <bool> meta: App.compact-layout;
    property <length> meta-h: root.meta ? 68px : 0px;
    // Right-column tabs, after TIDAL's: Lyrics (0), Queue (1), Similar
    // tracks (2) and Credits (3), one at a time. They sit side by side as
    // pages: a click glides between them, a two-finger swipe drags through
    // them 1:1 (`App.np-swipe-*`), and swiping back past the first closes
    // the column.
    property <bool> lyrics-on: App.show-lyrics && !App.show-queue && App.np-tab == "" && App.lyrics-status == "";
    property <bool> queue-on: App.show-queue && App.np-tab == "";
    property <bool> similar-on: App.np-tab == "similar";
    property <bool> credits-on: App.np-tab == "credits";
    property <bool> panel-on: root.lyrics-on || root.queue-on || root.similar-on || root.credits-on;
    // The first tab there is: Queue when the track has no lyrics.
    property <int> first-tab: App.lyrics-status == "" ? 0 : 1;
    // The pages' position at rest: the open tab, gliding to a newly picked one.
    property <float> rest: 0;
    property <bool> glide: false;
    animate rest { duration: root.glide ? 340ms : 0ms; easing: cubic-bezier(0.32, 0.72, 0, 1); }
    // While fingers drive it, the swipe's position (one below the first tab
    // is the artwork centred).
    property <float> pos: App.np-swipe-active ? App.np-swipe-progress : root.rest;
    // Never left of the first tab: swiping back past it grows the artwork
    // rather than sliding a blank page in.
    property <float> page: max(root.pos, root.first-tab);
    // 0 with artwork centred, 1 with a right column open; moving between
    // tabs keeps the artwork steady while the pages slide.
    property <float> panel: App.np-swipe-active ? clamp(root.pos - root.first-tab + 1, 0, 1) : (root.panel-on ? 1 : 0);
    animate panel { duration: App.np-swipe-active ? 0ms : 480ms; easing: cubic-bezier(0.4, 0, 0.2, 1); }
    // How much of tab `i` is on screen: its page is that far from the middle.
    pure function near(i: int) -> float {
        clamp(1 - abs(root.page - i), 0, 1)
    }
    // Reclaim decoded queue covers once the Queue page has left the screen.
    property <bool> queue-live: root.presenting && root.panel > 0 && root.near(1) > 0;
    changed queue-live => {
        if (!root.queue-live) {
            App.np-queue-visible(0, 0);
        }
    }

    property <length> top: 64px;
    property <length> bottom: root.height - App.player-height - (root.narrow ? 8px : 24px);
    property <length> room: max(0px, root.bottom - root.top - root.meta-h);
    // Wide.
    property <length> margin: clamp(root.width * 0.05, 32px, 96px);
    property <length> gap: clamp(root.width * 0.045, 32px, 80px);
    property <length> centred-size: max(0px, min(root.room * 0.86, root.width - 2 * root.margin));
    property <length> side-size: max(0px, min(root.room * 0.84, (root.width - 2 * root.margin - root.gap) * 0.46, 640px));
    property <length> column-w: max(0px, min(root.width - 2 * root.margin - root.gap - root.side-size, 560px));
    property <length> pair-x: (root.width - root.side-size - root.gap - root.column-w) / 2;
    // Narrow.
    property <length> pad: 20px;
    property <length> thumb: 56px;
    property <length> narrow-size: max(0px, min(root.width - 2 * root.pad, root.room - 16px));
    property <length> narrow-y: root.top + max(0px, (root.room - root.narrow-size) / 2);
    property <length> narrow-meta-off: root.narrow-y + root.narrow-size + 12px;
    property <length> narrow-meta-on: root.bottom - root.meta-h + (root.meta-h - root.thumb) / 2;

    // The art at rest, without a panel (off) and with Lyrics or Queue (on).
    property <length> off-size: root.narrow ? root.narrow-size : root.centred-size;
    property <length> off-x: (root.width - root.off-size) / 2;
    property <length> off-y: root.narrow ? root.narrow-y : root.top + (root.room - root.off-size) / 2;
    property <length> on-size: root.narrow ? root.thumb : root.side-size;
    property <length> on-x: root.narrow ? root.pad : root.pair-x;
    property <length> on-y: root.narrow ? root.narrow-meta-on : root.top + (root.room - root.on-size) / 2;

    // Destination-size art, scaled down to the player slot. Animating width/height
    // or drop-shadow-blur rebuilds a ~1000px Skia blur every frame: the art is
    // laid out once at the larger of its two sizes and only scaled, by the
    // expansion and by the panel transition alike.
    property <length> base: max(1px, root.off-size, root.on-size);
    property <length> art: root.off-size + (root.on-size - root.off-size) * root.panel;
    property <length> dest-x: root.off-x + (root.on-x - root.off-x) * root.panel;
    property <length> dest-y: root.off-y + (root.on-y - root.off-y) * root.panel;
    // The artwork's place in the dock at rest: the player bar's, or the phone
    // layout's mini player.
    property <length> slot: App.art-slot-size;
    property <length> slot-x: 16px;
    property <length> slot-y: root.height - App.dock-height + App.art-slot-top;
    property <float> grow: (root.slot + (root.art - root.slot) * root.expansion) / root.base;

    // The art leans away from the pointer, as if pressed where it points,
    // and rests flat when the pointer leaves. Drawn by the Skia renderer's
    // tilt marker (vendor/i-slint-renderer-skia/tilt.rs); other renderers
    // draw it flat. Eased, so a still pointer costs no frames.
    property <bool> tracking: art-ta.has-hover && App.show-now-playing && root.art > 120px;
    property <float> pu: root.tracking ? clamp(art-ta.mouse-x / max(1px, art-ta.width) * 2 - 1, -1, 1) : 0;
    property <float> pv: root.tracking ? clamp(art-ta.mouse-y / max(1px, art-ta.height) * 2 - 1, -1, 1) : 0;
    animate pu, pv { duration: 420ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    property <float> lift: root.tracking ? 1.02 : 1;
    animate lift { duration: 420ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
    // Degrees as lengths: the marker's centre carries them.
    property <length> yaw: root.pu * 8px;
    property <length> pitch: root.pv * 8px;

    // Right-column clip box and Queue vertical placement.
    // Anchoring `col-x` to the artwork's live right edge (`dest-x + art + gap`)
    // and delaying `panel-fade` until the artwork starts clearing keeps both
    // Lyrics and Queue strictly outside the artwork on every animation frame.
    property <float> panel-t: clamp((root.panel - (root.narrow ? 0.35 : 0.2)) / (root.narrow ? 0.65 : 0.8), 0, 1);
    property <float> panel-fade: root.panel-t * root.panel-t * (3 - 2 * root.panel-t);
    property <length> col-x: root.narrow ? root.pad : root.dest-x + root.art + root.gap;
    property <length> queue-y: root.narrow ? root.top + 12px : max(root.top + 16px, root.on-y);
    property <length> queue-bottom: root.narrow
        ? root.narrow-meta-on - 12px
        : min(root.height - App.player-height - 64px, root.on-y + root.on-size + root.meta-h);
    property <length> queue-h: max(0px, root.queue-bottom - root.queue-y);

    Rectangle {
        x: root.slot-x + (root.dest-x - root.slot-x) * root.expansion;
        y: root.slot-y + (root.dest-y - root.slot-y) * root.expansion;
        width: root.base;
        height: root.base;
        transform-origin: { x: 0px, y: 0px };
        transform-scale: root.grow;
        Rectangle {
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-scale: root.lift;
            background: @conic-gradient(at root.yaw root.pitch, #3d711701 0deg, #3d711701 360deg);
            Rectangle {
                border-radius: 4px;
                drop-shadow-blur: root.presenting ? 60px : 0;
                drop-shadow-color: #00000080;
                Cover {
                    width: 100%;
                    height: 100%;
                    source: App.np-motion.width > 0 ? App.np-motion : App.np-cover-large.width > 0 ? App.np-cover-large : App.np-cover;
                    radius: (4px - 2px * root.expansion) / max(root.grow, 0.001);
                }
            }
        }
    }
    // Where the pointer is over the art, at rest (flat, unscaled).
    art-ta := TouchArea {
        x: root.dest-x;
        y: root.dest-y;
        width: root.art;
        height: root.art;
        enabled: App.show-now-playing;
        accessible-role: image;
        accessible-label: "Artwork";
    }

    if root.meta && root.presenting: NowPlayingMeta {
        // Under the art; in the narrow arrangement with a panel, beside the
        // thumbnail at the bottom.
        x: root.narrow ? root.pad + (root.thumb + 14px) * root.panel : root.dest-x;
        y: root.narrow ? root.narrow-meta-off + (root.narrow-meta-on - root.narrow-meta-off) * root.panel
            : root.dest-y + root.art + 14px;
        width: root.narrow ? root.width - root.pad - self.x : max(200px, root.art);
        reveal: root.expansion;
    }

    // Right-column box with soft left/right edge fades while sliding or swiping
    // so content dissolves cleanly at both sides (never hard-clipping against
    // the box edge, and never overlapping the artwork).
    property <length> col-w: root.narrow ? max(0px, root.width - 2 * root.pad) : root.column-w;
    // One page to the next: a neighbour starts just past the box's edge fade.
    property <length> span: root.col-w + root.side-fade;
    property <bool> sliding: App.np-swipe-active
        || abs(root.rest - round(root.rest)) > 0.001
        || (root.panel > 0 && root.panel < 1);
    property <length> side-fade: root.sliding ? (root.narrow ? min(root.pad, 24px) : min(root.gap * 0.72, 48px)) : 0px;
    property <bool> interactive: App.show-now-playing && !App.np-swipe-active && !root.sliding;

    if root.presenting && root.panel > 0: Rectangle {
        x: root.col-x - root.side-fade;
        y: 0px;
        width: root.col-w + 2 * root.side-fade;
        height: root.height;
        clip: true;

        // Horizontal smoothstep alpha fade along both sides while sliding/swiping
        // (vendor/i-slint-renderer-skia/fade.rs); zero layer cost at rest.
        Rectangle {
            width: 100%;
            height: 100%;
            background: @conic-gradient(at root.side-fade root.side-fade, #46414801 0deg, #46414801 360deg);

            // Kept while the column is open, hidden off screen: its
            // scroll and sung line are where they were when it comes back.
            LyricsColumn {
                visible: root.near(0) > 0;
                x: root.side-fade + (0 - root.page) * root.span;
                y: root.top;
                width: root.col-w;
                height: root.narrow ? root.narrow-meta-on - 12px - root.top : root.height - App.player-height - 64px - root.top;
                font-size: clamp(self.width * 0.045, 18px, 30px);
                reveal: root.expansion * root.panel-fade * root.near(0);
                glass: root.glass;
                interactive: root.interactive && root.lyrics-on;
            }

            QueueColumn {
                visible: root.near(1) > 0;
                x: root.side-fade + (1 - root.page) * root.span;
                y: root.queue-y;
                width: root.col-w;
                height: root.queue-h;
                reveal: root.expansion * root.panel-fade * root.near(1);
                interactive: root.interactive && root.queue-on;
            }

            SimilarColumn {
                visible: root.near(2) > 0;
                x: root.side-fade + (2 - root.page) * root.span;
                y: root.queue-y;
                width: root.col-w;
                height: root.queue-h;
                reveal: root.expansion * root.panel-fade * root.near(2);
                interactive: root.interactive && root.similar-on;
            }

            CreditsColumn {
                visible: root.near(3) > 0;
                x: root.side-fade + (3 - root.page) * root.span;
                y: root.queue-y;
                width: root.col-w;
                height: root.queue-h;
                reveal: root.expansion * root.panel-fade * root.near(3);
                interactive: root.interactive && root.credits-on;
            }
        }
    }

    // [ Lyrics | Queue | Similar | Credits ] | Search, Debug, Profile, using
    // the same tools as the other views. Narrow: the search gives way;
    // Minimize moves up beside the segmented pill. Similar and Credits show
    // only while the row has room for them clear of the traffic lights (the
    // window's left 80px of the top row); below 420px the segments tighten.
    property <bool> tight: root.narrow && root.width < 360px;
    property <bool> compact-pill: root.narrow && root.width < 420px;
    property <length> seg-w: root.compact-pill ? 46px : 68px;
    property <length> pill-pad: 3px;
    property <length> divider-gap: root.compact-pill ? 5px : 15px;
    property <length> header-w: root.narrow ? (root.tight ? 92px : 101px) : 407px;
    property <length> trail-w: root.divider-gap + 1px + (root.compact-pill ? 4px : 15px);
    property <length> lead-w: root.narrow ? 80px + 52px : 80px;
    // Dark ink over a light backdrop (see App.np-light); the chosen segment
    // becomes a dark thumb with light text.
    property <bool> light: App.np-light;
    property <int> seg-count: root.width - root.header-w - root.seg-w * 4 - root.pill-pad * 2 - root.trail-w >= root.lead-w ? 4 : 2;
    changed seg-count => {
        App.np-tab-count = root.seg-count;
        if (root.seg-count < 4) {
            App.np-tab = "";
        }
    }
    property <length> pill-w: root.seg-w * root.seg-count + root.pill-pad * 2;
    property <length> group-w: root.pill-w + root.trail-w;
    property <int> panel-mode: root.credits-on ? 4 : root.similar-on ? 3 : root.queue-on ? 2 : root.lyrics-on ? 1 : 0;
    property <int> last-mode: 0;
    property <float> thumb-alpha: root.panel-mode > 0 ? 1 : 0;
    animate thumb-alpha { duration: App.np-swipe-active ? 0ms : 200ms; easing: ease-out; }
    // The thumb rides with the pages; past the last tab it gives a little.
    property <float> thumb-pos: min(root.page, root.seg-count - 1 + 0.06);
    property <float> thumb-vis: App.np-swipe-active ? root.panel : root.thumb-alpha;
    // How much of the thumb lies under segment `i`: its label turns dark.
    pure function cover(i: int) -> float {
        root.thumb-vis * clamp(1 - abs(root.thumb-pos - i), 0, 1)
    }
    // The segment shown as chosen (during a swipe, the nearest).
    property <int> lit: App.np-swipe-active
        ? (root.panel >= 0.5 ? round(root.page) : -1)
        : root.panel-mode - 1;
    changed panel-mode => {
        if (root.panel-mode > 0) {
            // From the centred artwork the column fades in on its tab; from
            // another tab the pages glide. A swipe has already put them there.
            root.glide = !App.np-swipe-active && root.last-mode > 0 && root.last-mode != root.panel-mode;
            root.rest = root.panel-mode - 1;
        }
        root.last-mode = root.panel-mode;
    }
    init => {
        App.bar-covered = self.expansion >= 1;
        App.np-tab-count = root.seg-count;
        root.last-mode = root.panel-mode;
        root.rest = max(0, root.panel-mode - 1);
    }

    // Glass capsule behind the segmented toggle: leaf rectangle so its
    // opacity feeds glass::draw directly during expansion.
    if root.glass && root.presenting: Rectangle {
        x: panel-group.x;
        y: 14px;
        width: root.pill-w;
        height: 36px;
        border-radius: 18px;
        opacity: root.expansion;
        background: @conic-gradient(#474c5301 0deg, #ffffff18 360deg);
    }

    panel-group := Rectangle {
        x: header.x - self.width;
        y: 0px;
        width: root.group-w;
        height: 64px;
        opacity: root.expansion;
        cache-rendering-hint: root.expansion > 0 && root.expansion < 1;
        visible: root.presenting;
        // Lyrics is dim when the track has none.
        property <bool> none: App.lyrics-status != "";

        // Segmented pill track (plain fallback when glass is off; glass track
        // sits behind this group as a leaf rectangle).
        Rectangle {
            x: 0px;
            y: 14px;
            width: root.pill-w;
            height: 36px;
            border-radius: 18px;
            background: root.glass ? transparent : root.light ? #0000000f : #ffffff14;
            border-width: root.glass ? 0px : 1px;
            border-color: root.light ? #0000001f : #ffffff1c;

            // Sliding active pill thumb (tracks fingers 1:1 during swipe and glides on click).
            Rectangle {
                x: root.pill-pad + root.seg-w * root.thumb-pos;
                y: root.pill-pad;
                width: root.seg-w;
                height: 30px;
                border-radius: 15px;
                background: (root.light ? #1d1d1f : #ffffff).with-alpha(root.thumb-vis);
            }

            for label[i] in ["Lyrics", "Queue", "Similar", "Credits"]: Rectangle {
                x: root.pill-pad + root.seg-w * i;
                y: root.pill-pad;
                width: root.seg-w;
                height: 30px;
                border-radius: 15px;
                visible: i < root.seg-count;
                // Hover: a wash on the track, or the thumb dimmed to #e6e6e6.
                background: !seg-ta.has-hover ? transparent
                    : (i == root.lit) != root.light ? #0000001a : #ffffff1f;
                animate background { duration: 150ms; }
                accessible-role: button;
                accessible-label: i == 2 ? "Similar tracks" : label;
                accessible-checked: i == root.panel-mode - 1;
                accessible-action-default => { root.pick(i); }
                seg-ta := TouchArea {
                    enabled: App.show-now-playing && i < root.seg-count;
                    mouse-cursor: pointer;
                    clicked => { root.pick(i); }
                }
                Text {
                    text: label;
                    color: i == 0 && panel-group.none ? (root.light ? #00000052 : #ffffff59)
                        : root.light ? white.mix(#000000d9, root.cover(i))
                        : black.mix(white, root.cover(i));
                    font-size: root.compact-pill ? 12px : 13.5px;
                    font-weight: 600;
                }
            }
        }
        Rectangle { x: root.pill-w + root.divider-gap; y: 22px; width: 1px; height: 20px; background: root.light ? #00000033 : #ffffff40; }
    }
    function pick(i: int) {
        if (i == 0) {
            App.toggle-np-lyrics();
        } else if (i == 1) {
            App.toggle-np-queue();
        } else {
            App.toggle-np-tab(i == 2 ? "similar" : "credits");
        }
    }
    header := HeaderTools {
        x: parent.width - self.width;
        y: 0px;
        width: root.header-w;
        search: !root.narrow;
        active: App.show-now-playing;
        // Glass reads what is behind it: not while it fades in a layer of its own.
        glass: root.glass && root.expansion >= 1;
        overlay: true;
        light: root.light;
        visible: root.presenting;
        opacity: root.expansion;
        cache-rendering-hint: root.expansion > 0 && root.expansion < 1;
    }
    MinimizeButton {
        x: root.narrow ? max(80px, panel-group.x - (root.tight ? 6px : 8px) - self.width) : root.width - self.width - 32px;
        y: root.narrow ? 14px : root.height - App.player-height - 52px;
        width: root.narrow ? (root.tight ? 34px : 44px) : 96px;
        opacity: root.expansion;
        cache-rendering-hint: root.expansion > 0 && root.expansion < 1;
        visible: root.presenting;
        enabled: App.show-now-playing;
        // Glass reads what is behind it: not while it fades in a layer of its own.
        glass: root.glass && root.expansion >= 1;
        // Up in the header only when narrow; wide, it sits low on the darker wash.
        light: root.narrow && root.light;
        clicked => { App.show-now-playing = false; }
    }
    // The transport controls (the overlay PlayerBar, mounted after this) sit
    // on a floating pane of glass. No children, so its opacity is the glass's
    // own alpha and needs no layer.
    if root.glass && root.presenting: Rectangle {
        x: 10px;
        y: root.height - App.player-height;
        width: root.width - 20px;
        height: App.player-height - 8px;
        border-radius: 24px;
        opacity: root.expansion;
        background: @conic-gradient(#474c5301 0deg, #ffffff1f 360deg);
    }
}

// ---------------------------------------------------------------- login

export component LoginView inherits Rectangle {
    background: Theme.bg;
    DragArea {
        y: 0;
        height: 64px;
    }

    ScrollView {
        content-height: max(root.height, 592px);
        VerticalLayout {
            height: max(root.height, 592px);
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: min(520px, root.width - 32px);
                    height: 560px;
                    border-radius: 16px;
                    background: #0e0e0e;
                    border-width: 1px;
                    border-color: Theme.border;
                    VerticalLayout {
                        padding: 40px;
                        spacing: 18px;
                        alignment: center;
                        VerticalLayout {
                            spacing: 4px;
                            Text {
                                text: "T I D E";
                                color: Theme.text;
                                font-size: 30px;
                                font-weight: 800;
                                horizontal-alignment: center;
                            }

                            if App.app-version != "": Text {
                                text: "v" + App.app-version;
                                color: Theme.text-dim;
                                font-size: 12px;
                                horizontal-alignment: center;
                            }
                        }

                        Text {
                            text: App.user-code == "" ? "Log in to start listening in Max quality." : "Enter this code at link.tidal.com";
                            color: Theme.text-secondary;
                            font-size: 15px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        // Default: Max-quality login in the default browser.
                        if App.user-code == "": MaxLogin {
                            centered: true;
                        }
                        if App.user-code != "": Rectangle {
                            height: 72px;
                            border-radius: 10px;
                            background: #161616;
                            EditableInput {
                                text: App.user-code;
                                read-only: true;
                                color: Theme.lossless;
                                font-size: 34px;
                                font-weight: 700;
                                letter-spacing: 6px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        if App.user-code != "": HorizontalLayout {
                            alignment: center;
                            PillButton {
                                width: 240px;
                                text: "Open browser";
                                primary: true;
                                clicked => {
                                    App.open-browser();
                                }
                            }
                        }
                        if App.auth-status != "": Text {
                            text: App.auth-status;
                            color: Theme.text-secondary;
                            font-size: 13px;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 1px;
                            background: Theme.border;
                        }

                        // Fallback: device code (TIDAL limits it to 16-bit, 44.1 kHz).
                        Rectangle {
                            height: 20px;
                            fallback := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    App.login();
                                }
                            }

                            Text {
                                text: "Trouble logging in? Use a device code instead (16-bit, 44.1 kHz only)";
                                color: fallback.has-hover ? Theme.text : Theme.text-secondary;
                                font-size: 13px;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
