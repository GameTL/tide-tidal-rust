// Main content views.
import { ScrollView } from "std-widgets.slint";
import { TrackMenuButton } from "context-menu.slint";
import { MaxLogin } from "settings.slint";
import { App, Theme, EditableInput, Icon, IconButton, DebugButton, Cover, CardArt, CardData, TrackData, SectionData, ExplicitBadge, TitleWithQuality, ArtistLinks, PillButton, DragArea, MenuPanel, MenuRow, CreateButton, Toggle, TideLoader } from "common.slint";

// ---------------------------------------------------------------- cards

// Heart / More on cover: circular hover plate. Folders keep a filled plate.
component OverlayAction inherits Rectangle {
    in property <image> icon;
    in property <length> diameter: 40px;
    in property <length> icon-size: 16px;
    in property <bool> plate: false;
    out property <bool> hovered: ta.has-hover;
    callback clicked();
    callback context-requested(length, length);
    width: diameter;
    height: diameter;
    border-radius: diameter / 2;
    background: plate ? (ta.has-hover ? #3a3a3a : #2a2a2ae6) : (ta.pressed ? #3a3a3a : ta.has-hover ? #2a2a2ae6 : transparent);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context-requested(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        size: root.icon-size;
        tint: white;
    }
}

// Play / My Collection / More on artwork. Folders keep the teal tile and only show More.
component CoverHover inherits Rectangle {
    in property <CardData> card;
    in property <bool> show: false;
    in property <bool> enabled: true;
    in property <length> play-d: 40px;
    in property <length> inset: 10px;
    property <bool> folder: card.kind == "folder";
    property <bool> playing: App.playing-card-id == card.id && App.playing-card-kind == card.kind;
    property <bool> heart: card.kind == "album" || card.kind == "video" || (card.kind == "playlist" && card.by != "Me" && card.by != "");
    property <bool> more: folder || card.kind == "album" || card.kind == "playlist" || card.kind == "mix" || card.kind == "artist" || card.kind == "video";
    property <bool> playing-now: root.playing && App.playing;
    property <length> action-d: folder ? max(28px, min(36px, root.play-d * 0.8)) : root.play-d;
    property <length> action-icon: max(16px, root.action-d * 0.45);
    // Child buttons steal parent hover; keep the overlay up while any of them is hot.
    out property <bool> hovered: play-ta.has-hover || more-btn.hovered || heart-btn.hovered;
    property <bool> on: show || hovered;
    visible: enabled && on && card.kind != "page";
    background: folder ? transparent : #00000099;
    clip: true;

    play-btn := Rectangle {
        visible: root.on && !root.folder;
        x: root.inset;
        y: parent.height - root.inset - root.play-d;
        width: root.play-d;
        height: root.play-d;
        border-radius: root.play-d / 2;
        background: white;
        transform-scale: play-ta.has-hover ? 1.12 : 1;
        animate transform-scale {
            duration: 150ms;
            easing: ease-out;
        }
        play-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if (root.playing) {
                    App.toggle-play();
                } else {
                    App.play-card(root.card);
                }
            }
        }
        Icon {
            source: root.playing-now ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
            size: root.play-d * 0.45;
            tint: black;
        }
    }

    more-btn := OverlayAction {
        visible: root.on && root.more;
        x: parent.width - root.inset - self.width - (!root.folder && root.heart ? self.width + 4px : 0px);
        y: parent.height - root.inset - self.height;
        diameter: root.action-d;
        icon-size: root.action-icon;
        icon: @image-url("icons/more.svg");
        plate: root.folder;
        clicked => {
            App.request-card-menu(root.card, self.absolute-position.x, self.absolute-position.y + self.height);
        }
        context-requested(x, y) => { App.request-card-menu(root.card, x, y); }
    }

    heart-btn := OverlayAction {
        visible: root.on && root.heart;
        x: parent.width - root.inset - self.width;
        y: parent.height - root.inset - self.height;
        diameter: root.action-d;
        icon-size: root.action-icon;
        icon: card.favorite ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
        clicked => { App.toggle-card-favorite(root.card); }
        context-requested(x, y) => { App.request-card-menu(root.card, x, y); }
    }
}

component MediaCard inherits Rectangle {
    in property <CardData> card;
    // Videos are 16:9 stills with a length line ("2 MIN") under the artists.
    property <bool> wide: card.kind == "video";
    property <length> art-h: wide ? self.width * 9 / 16 : self.width;
    height: self.art-h + (wide ? 100px : 76px);
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                App.request-card-menu(root.card, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            App.open-card(root.card);
        }
    }

    CardArt {
        x: 0;
        y: 0;
        width: root.width;
        height: root.art-h;
        card: root.card;
    }

    CoverHover {
        x: 0;
        y: 0;
        width: root.width;
        height: root.art-h;
        card: root.card;
        show: ta.has-hover;
        play-d: root.wide ? min(56px, root.art-h * 0.36) : min(44px, root.width * 0.28);
        inset: max(8px, root.width * 0.05);
    }

    if card.kind == "artist": Text {
        x: 0;
        y: root.width + 12px;
        width: root.width;
        text: card.title;
        color: Theme.text;
        font-size: 15px;
        font-weight: 500;
        overflow: elide;
        horizontal-alignment: center;
    }

    if card.kind != "artist": TitleWithQuality {
        x: 0;
        y: root.art-h + 12px;
        width: root.width;
        height: 20px;
        title: card.title;
        // Grid / carousel: Max only — High / Low stay on the album page.
        quality: card.kind == "album" && card.quality == "MAX" ? card.quality : "";
        font-size: 15px;
        font-weight: Theme.medium;
    }

    subtitle := Text {
        x: 0;
        y: root.art-h + 35px;
        width: root.width;
        height: root.wide ? min(42px, self.preferred-height) : 42px;
        text: card.subtitle;
        color: Theme.text-secondary;
        font-size: 15px;
        wrap: word-wrap;
        overflow: elide;
        vertical-alignment: top;
        horizontal-alignment: card.kind == "artist" ? center : left;
    }

    if card.detail != "": Text {
        x: 0;
        y: subtitle.y + subtitle.height + 6px;
        width: root.width;
        text: card.detail;
        color: Theme.text-secondary;
        font-size: 12px;
        font-weight: Theme.demibold;
        letter-spacing: 1px;
    }
}

// Compact tile: artwork left, two lines of text.
component RowCard inherits Rectangle {
    in property <CardData> card;
    in property <bool> tile: false;
    in property <length> art: 48px;
    // Home shortcuts keep CoverHover. Feed compact rows do not.
    in property <bool> overlay: true;
    // Feed rows play on click; tiles / search / artist rows open the page.
    in property <bool> play-on-click: false;
    height: tile ? 66px : 62px;
    border-radius: 4px;
    background: tile ? ((ta.has-hover || hover.hovered) ? #1e1e1e : Theme.surface) : ((ta.has-hover || hover.hovered) ? #111111 : transparent);
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                App.request-card-menu(root.card, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            if (root.play-on-click) {
                App.play-card(root.card);
            } else {
                App.open-card(root.card);
            }
        }
    }

    CardArt {
        x: tile ? 9px : 0px;
        width: root.art;
        height: root.art;
        card: root.card;
        radius: 3px;
    }

    hover := CoverHover {
        x: tile ? 9px : 0px;
        y: (parent.height - root.art) / 2;
        width: root.art;
        height: root.art;
        border-radius: 3px;
        card: root.card;
        enabled: root.overlay;
        show: ta.has-hover;
        play-d: min(28px, root.art * 0.5);
        inset: 4px;
    }

    VerticalLayout {
        x: (tile ? 9px : 0px) + root.art + 13px;
        width: root.width - self.x - 12px;
        alignment: center;
        spacing: 3px;
        TitleWithQuality {
            height: tile ? 18px : 20px;
            title: card.title;
            quality: card.kind == "album" && card.quality == "MAX" ? card.quality : "";
            font-size: tile ? 13.5px : 15px;
            font-weight: tile ? Theme.demibold : Theme.medium;
        }

        if card.subtitle != "": Text {
            text: card.subtitle;
            color: Theme.text-secondary;
            font-size: tile ? 13px : 15px;
            overflow: elide;
        }
    }
}

component RowTrack inherits Rectangle {
    in property <TrackData> track;
    callback play();
    property <bool> active: track.id == App.current-id;
    height: 62px;
    border-radius: 4px;
    background: ta.has-hover ? #111111 : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                more.open-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            root.play();
        }
    }

    Cover {
        x: 0;
        width: 62px;
        height: 62px;
        source: track.cover;
        radius: 3px;
    }

    VerticalLayout {
        x: 75px;
        width: root.width - 75px - 56px;
        alignment: center;
        spacing: 3px;
        HorizontalLayout {
            alignment: start;
            spacing: 8px;
            Text {
                text: track.title;
                color: active ? App.accent : Theme.text;
                font-size: 15px;
                font-weight: 500;
                overflow: elide;
            }

            if track.explicit: VerticalLayout {
                alignment: center;
                ExplicitBadge { }
            }
        }

        Text {
            text: track.artist;
            color: Theme.text-secondary;
            font-size: 15px;
            overflow: elide;
        }
    }

    more := TrackMenuButton {
        x: root.width - 44px;
        track-id: track.id;
    }
}

component SectionHeader inherits Rectangle {
    in property <string> title;
    in property <bool> arrows: false;
    in property <bool> view-all: true;
    in property <bool> can-prev: false;
    in property <bool> can-next: false;
    callback prev();
    callback next();
    callback show-all();
    height: 34px;
    Text {
        x: 0;
        text: root.title;
        color: Theme.text;
        font-size: 20px;
        font-weight: 700;
        vertical-alignment: center;
    }

    HorizontalLayout {
        x: root.width - self.width - 10px;
        width: self.preferred-width;
        spacing: 10px;
        if root.arrows: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: #141414;
                IconButton {
                    icon: @image-url("icons/chevron-left.svg");
                    size: 14px;
                    enabled: root.can-prev;
                    tint: Theme.text;
                    clicked => {
                        root.prev();
                    }
                }
            }
        }
        if root.arrows: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: #141414;
                IconButton {
                    icon: @image-url("icons/chevron-right.svg");
                    size: 14px;
                    enabled: root.can-next;
                    tint: Theme.text;
                    clicked => {
                        root.next();
                    }
                }
            }
        }
        if root.view-all: Text {
            text: "View all";
            color: all-link.has-hover ? Theme.text : Theme.text-secondary;
            font-size: 14px;
            font-weight: Theme.medium;
            vertical-alignment: center;
            all-link := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.show-all(); }
            }
        }
    }
}

// Reports the visible card range [from, upto) while this block is near the
// viewport, and (0, 0) once it has scrolled away so artwork can be dropped.
component ArtRequest inherits Rectangle {
    in property <int> from: 0;
    in property <int> upto: 0;
    callback request(int, int);
    in property <length> window-height: 1200px;
    // One extra pane of covers, so scrolling onto the next page is already painted.
    out property <length> overscan: max(window-height, 1px);
    property <bool> near: self.absolute-position.y < window-height + overscan && self.absolute-position.y + self.height > -overscan;
    property <int> sent-from: -1;
    property <int> sent-upto: -1;
    property <bool> sent-near: false;
    public function reset() {
        sent-from = -1;
        sent-upto = -1;
        sent-near = false;
    }
    Timer {
        // The first request after a page is built goes out at once, so a page
        // restored behind a back / forward snapshot has its artwork loading
        // before the snapshot lifts. Later range changes (scrolling) debounce.
        interval: sent-near ? 150ms : 16ms;
        running: (near && (sent-from != from || sent-upto != upto)) || (sent-near && !near);
        triggered => {
            if (root.near) {
                root.request(root.from, root.upto);
                sent-from = root.from;
                sent-upto = root.upto;
                sent-near = true;
            } else {
                root.request(0, 0);
                sent-from = 0;
                sent-upto = 0;
                sent-near = false;
            }
        }
    }
}

component Carousel inherits Rectangle {
    in property <SectionData> section;
    in property <bool> view-all: true;
    callback show-all();
    callback request-art(int, int);
    changed section => { artwork.reset(); }
    property <length> gap: 17px;
    property <int> per-page: max(2, floor((self.width + gap) / (200px + gap)));
    property <length> card-w: (self.width - (per-page - 1) * gap) / per-page;
    property <int> offset: 0;
    property <int> max-offset: max(0, section.cards.length - per-page);
    height: 34px + 16px + card-w + 76px;
    artwork := ArtRequest {
        window-height: App.pane-height;
        from: max(0, min(root.offset, root.max-offset) - root.per-page);
        upto: min(section.cards.length, min(root.offset, root.max-offset) + 2 * root.per-page);
        request(from, upto) => { root.request-art(from, upto); }
    }

    SectionHeader {
        y: 0;
        title: section.title;
        arrows: true;
        view-all: root.view-all && section.cards.length > per-page;
        can-prev: root.offset > 0;
        can-next: root.offset < root.max-offset;
        prev => {
            root.offset = max(0, root.offset - root.per-page);
        }
        next => {
            root.offset = min(root.max-offset, root.offset + root.per-page);
        }
        show-all => {
            root.show-all();
        }
    }

    Rectangle {
        y: 50px;
        height: card-w + 76px;
        clip: true;
        Rectangle {
            x: -min(root.offset, root.max-offset) * (card-w + gap);
            width: section.cards.length * (card-w + gap);
            animate x {
                duration: 280ms;
                easing: ease-out;
            }
            for card[i] in section.cards: MediaCard {
                x: i * (card-w + gap);
                y: 0;
                width: card-w;
                card: card;
            }
        }
    }
}

component RowGrid inherits Rectangle {
    in property <SectionData> section;
    in property <int> section-index;
    in property <bool> tiles: false;
    property <int> cols: self.width > 760px ? 3 : 2;
    property <length> gap-x: tiles ? 9px : 30px;
    property <length> row-h: tiles ? 75px : 79px;
    property <length> col-w: (self.width - (cols - 1) * gap-x) / cols;
    property <int> count: section.layout == "tracks" ? section.tracks.length : section.cards.length;
    property <length> head: tiles ? 0px : 50px;
    height: head + ceil(count / cols) * row-h - (tiles ? 9px : 17px);
    property <int> first-row: max(0, floor((-art.absolute-position.y - art.overscan) / row-h));
    property <int> vis-rows: max(1, ceil((art.overscan + max(App.pane-height, 1px) + art.overscan) / row-h));
    art := ArtRequest {
        width: 100%;
        height: 100%;
        window-height: App.pane-height;
        from: first-row * cols;
        upto: min(count, (first-row + vis-rows) * cols);
        request(from, upto) => { App.section-visible(root.section-index, from, upto); }
    }

    if !tiles: SectionHeader {
        y: 0;
        title: section.title;
    }
    if section.layout == "tracks": Rectangle {
        y: head;
        for track[i] in section.tracks: RowTrack {
            x: mod(i, cols) * (col-w + gap-x);
            y: floor(i / cols) * row-h;
            width: col-w;
            track: track;
            play => {
                App.play-section-track(root.section-index, track.id);
            }
        }
    }
    if section.layout != "tracks": Rectangle {
        y: head;
        for card[i] in section.cards: RowCard {
            x: mod(i, cols) * (col-w + gap-x);
            y: floor(i / cols) * row-h;
            width: col-w;
            card: card;
            tile: root.tiles;
            art: root.tiles ? 48px : 62px;
            overlay: root.tiles;
            play-on-click: !root.tiles;
        }
    }
}

component Spinner inherits Rectangle {
    height: 120px;
    Text {
        text: "Loading…";
        color: Theme.text-secondary;
        font-size: 15px;
    }
}

component LinkRow inherits Rectangle {
    in property <SectionData> section;
    property <length> gap: 8px;
    property <int> cols: max(2, floor((self.width + gap) / (118px + gap)));
    property <length> col-w: (self.width - (cols - 1) * gap) / cols;
    property <int> count: section.cards.length;
    property <length> row-h: 44px;
    height: 50px + ceil(count / cols) * row-h;
    SectionHeader {
        y: 0;
        title: section.title;
        view-all: false;
    }
    for card[i] in section.cards: Rectangle {
        x: mod(i, cols) * (col-w + gap);
        y: 50px + floor(i / cols) * row-h;
        width: min(col-w - 4px, chip-label.preferred-width + 28px);
        height: 36px;
        border-radius: 18px;
        background: chip-ta.has-hover ? #2a2a2a : #1c1c1c;
        chip-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { App.open-card(card); }
        }
        chip-label := Text {
            text: card.title;
            color: Theme.text;
            font-size: 14px;
            font-weight: Theme.medium;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

// Explore genres / moods / decades: wrapping image (or tint) tiles, not chips.
component TileGrid inherits Rectangle {
    in property <SectionData> section;
    in property <int> section-index;
    property <length> gap: 12px;
    property <int> cols: max(3, floor((self.width + gap) / (176px + gap)));
    property <length> tile-w: (self.width - (cols - 1) * gap) / cols;
    property <length> tile-h: tile-w * 0.62;
    property <int> count: section.cards.length;
    height: 50px + ceil(count / cols) * (tile-h + gap) - gap;
    art := ArtRequest {
        width: 100%;
        height: 100%;
        window-height: App.pane-height;
        from: 0;
        upto: count;
        request(from, upto) => { App.section-visible(root.section-index, from, upto); }
    }
    SectionHeader {
        y: 0;
        title: section.title;
        view-all: false;
    }
    for card[i] in section.cards: Rectangle {
        x: mod(i, cols) * (tile-w + gap);
        y: 50px + floor(i / cols) * (tile-h + gap);
        width: tile-w;
        height: tile-h;
        border-radius: 4px;
        clip: true;
        background: tile-ta.has-hover ? card.tint.brighter(20%) : card.tint;
        if card.image.width > 0: Image {
            width: 100%;
            height: 100%;
            source: card.image;
            image-fit: cover;
        }
        Rectangle {
            y: parent.height * 0.45;
            width: 100%;
            height: parent.height * 0.55;
            background: @linear-gradient(180deg, #00000000 0%, #00000099 100%);
        }
        Text {
            x: 12px;
            y: parent.height - 40px;
            width: parent.width - 24px;
            height: 32px;
            text: card.title;
            color: white;
            font-size: 15px;
            font-weight: 700;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: bottom;
        }
        tile-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { App.open-card(card); }
        }
    }
}

export component ModulesView inherits Rectangle {
    VerticalLayout {
        alignment: start;
        if App.sections.length == 0 && App.loading: Rectangle {
            height: 280px;
            TideLoader { }
        }
        if App.sections.length == 0 && !App.loading: Text {
            text: "Nothing here yet";
            color: Theme.text-secondary;
            font-size: 15px;
        }
        for section[i] in App.sections: VerticalLayout {
            padding-bottom: section.layout == "shortcuts" ? 44px : 38px;
            if section.layout == "shortcuts": RowGrid {
                section: section;
                section-index: i;
                tiles: true;
            }
            if section.layout == "tiles": TileGrid {
                section: section;
                section-index: i;
            }
            if section.layout == "links": LinkRow {
                section: section;
            }
            if section.layout == "cards": Carousel {
                section: section;
                request-art(from, upto) => { App.section-visible(i, from, upto); }
            }
            if section.layout == "rows" || section.layout == "tracks": RowGrid {
                section: section;
                section-index: i;
            }
        }
    }
}

export component HomeView inherits Rectangle {
    property <length> pad: clamp((self.width - 900px) * 0.11, 24px, 83px);
    ScrollView {
        content-y <=> App.scroll-y;
        VerticalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            padding-top: 4px;
            padding-bottom: 48px;
            spacing: 0px;
            alignment: start;
            Rectangle {
                height: 44px;
                HorizontalLayout {
                    alignment: start;
                    spacing: 18px;
                    for tab[i] in ["For you", "Staff Picks", "Uploads"]: Rectangle {
                        width: label.preferred-width;
                        label := Text {
                            text: tab;
                            color: i == App.home-tab ? Theme.text : Theme.text-secondary;
                            font-size: 15px;
                            font-weight: 500;
                            vertical-alignment: center;
                        }

                        if i == App.home-tab: Rectangle {
                            y: parent.height - 2px;
                            height: 2px;
                            background: white;
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { App.set-home-tab(i); }
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: #161616;
                }
            }

            Rectangle {
                height: 35px;
            }

            ModulesView { }
        }
    }
}

export component ModulesPage inherits Rectangle {
    property <length> pad: clamp((self.width - 900px) * 0.11, 24px, 83px);
    ScrollView {
        content-y <=> App.scroll-y;
        VerticalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            padding-top: 8px;
            padding-bottom: 48px;
            alignment: start;
            Rectangle {
                height: 48px;
                Text {
                    width: 100%;
                    height: 100%;
                    text: App.page-title;
                    color: Theme.text;
                    font-size: 28px;
                    font-weight: 700;
                    horizontal-alignment: left;
                    vertical-alignment: center;
                }
            }
            ModulesView { }
        }
    }
}

// ---------------------------------------------------------------- track table

component HeaderLabel inherits Text {
    color: Theme.text-header;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.6px;
    vertical-alignment: center;
}

component Cell inherits Text {
    color: Theme.text;
    font-size: 15px;
    font-weight: 500;
    overflow: elide;
    vertical-alignment: center;
}

component LinkedCell inherits Cell {
    in property <bool> link-enabled;
    callback activated();
    callback context-requested(length, length);

    font-weight: Theme.demibold;

    Rectangle {
        x: 0;
        y: root.height / 2 + root.font-size / 2 + 1px;
        width: link.width;
        height: 1px;
        background: root.color;
        visible: link.enabled && link.has-hover;
    }

    link := TouchArea {
        x: 0;
        width: max(0px, min(root.width, root.preferred-width));
        enabled: root.link-enabled;
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context-requested(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => { root.activated(); }
    }
}

component TrackRow inherits Rectangle {
    in property <TrackData> track;
    in property <int> index;
    in property <bool> show-bpm;
    in property <bool> show-date;
    in property <bool> album-page;
    in property <bool> artist-page;
    in property <length> x-artist;
    in property <length> x-album;
    in property <length> x-date;
    in property <length> x-time;
    in property <length> x-bpm;
    property <bool> active: track.id == App.current-id;
    height: 53px;
    border-radius: 6px;
    background: ta.has-hover ? #121212 : transparent;
    ta := TouchArea {
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                more.open-at(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        double-clicked => {
            App.play-track(track.id);
        }
    }

    if !album-page: Cover {
        x: artist-page ? 0px : 46px;
        width: 46px;
        height: 46px;
        source: track.cover;
        // Rounded clipping creates an offscreen layer for each scrolling thumbnail.
        radius: 0px;
    }

    // Index / play affordance
    Rectangle {
        x: 0;
        width: 44px;
        if active && !ta.has-hover: Icon {
            source: @image-url("icons/volume.svg");
            size: 17px;
            tint: App.accent;
        }
        if !artist-page && !active && !ta.has-hover: Text {
            text: index + 1;
            color: #7c7c7c;
            font-size: 14px;
            font-weight: 500;
        }
        if ta.has-hover: IconButton {
            icon: active && App.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
            size: 15px;
            tint: Theme.text;
            context-requested(x, y) => { more.open-at(x, y); }
            clicked => {
                if (active) {
                    App.toggle-play();
                } else {
                    App.play-track(track.id);
                }
            }
        }
    }

    HorizontalLayout {
        x: album-page ? 46px : artist-page ? 60px : 105px;
        width: x-artist - self.x - 24px;
        alignment: start;
        spacing: 8px;
        Cell {
            text: track.title;
            color: active ? App.accent : Theme.text;
        }

        if track.explicit: VerticalLayout {
            alignment: center;
            ExplicitBadge { }
        }
    }

    ArtistLinks {
        x: x-artist;
        width: min(self.preferred-width, (album-page ? x-time : x-album) - x-artist - 24px);
        height: root.height;
        artists: track.artists;
        text: track.artist;
        font-weight: Theme.demibold;
        context-requested(x, y) => { more.open-at(x, y); }
        open(a) => { App.open-artist(a); }
    }

    if !album-page: LinkedCell {
        x: x-album;
        width: (show-date ? x-date : x-time) - x-album - 20px;
        text: track.album;
        link-enabled: !track.album-id.is-empty;
        context-requested(x, y) => { more.open-at(x, y); }
        activated => { App.open-track-album(track); }
    }

    if show-date: Cell {
        x: x-date;
        width: x-time - x-date - 12px;
        text: track.date-added;
    }
    Cell {
        x: x-time;
        text: track.duration;
    }

    if show-bpm: Cell {
        x: x-bpm;
        text: track.bpm;
    }
    more := TrackMenuButton {
        x: root.width - 76px;
        track-id: track.id;
    }

    IconButton {
        x: root.width - 42px;
        icon: track.favorite ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
        size: 17px;
        tint: Theme.text;
        context-requested(x, y) => { more.open-at(x, y); }
        clicked => {
            App.toggle-favorite(track.id);
        }
    }
}

component TrackPlaceholder inherits Rectangle {
    in property <length> x-artist;
    in property <length> x-album;
    in property <length> x-time;
    height: 53px;
    background: transparent;

    Rectangle {
        x: 0;
        y: 3px;
        width: 46px;
        height: 46px;
        border-radius: 2px;
        background: #1c1c1c;
    }
    Rectangle {
        x: 60px;
        y: 22px;
        width: max(32px, min(180px, root.x-artist - 84px));
        height: 8px;
        border-radius: 4px;
        background: #242424;
    }
    Rectangle {
        x: root.x-artist;
        y: 22px;
        width: max(32px, min(132px, root.x-album - root.x-artist - 24px));
        height: 8px;
        border-radius: 4px;
        background: #242424;
    }
    Rectangle {
        x: root.x-album;
        y: 22px;
        width: max(32px, min(132px, root.x-time - root.x-album - 24px));
        height: 8px;
        border-radius: 4px;
        background: #242424;
    }
    Rectangle {
        x: root.x-time;
        y: 22px;
        width: 34px;
        height: 8px;
        border-radius: 4px;
        background: #242424;
    }
    Rectangle {
        x: root.width - 66px;
        y: 19px;
        width: 16px;
        height: 14px;
        border-radius: 3px;
        background: #242424;
    }
    Rectangle {
        x: root.width - 42px;
        y: 18px;
        width: 16px;
        height: 16px;
        border-radius: 8px;
        background: #242424;
    }
}

// Icon over a label: the album page's Add / Credits / Share / More.
component ActionButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked();
    width: 64px;
    height: 58px;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    Icon {
        y: 4px;
        source: root.icon;
        size: 22px;
        tint: Theme.text;
        opacity: ta.has-hover ? 1.0 : 0.85;
    }

    Text {
        y: 38px;
        width: root.width;
        text: root.label;
        color: Theme.text;
        font-size: 12px;
        font-weight: Theme.demibold;
        horizontal-alignment: center;
    }

    @children
}

component CatalogTabs inherits Rectangle {
    in property <[string]> tabs;
    in-out property <int> selected;
    height: 46px;
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
    HorizontalLayout {
        alignment: start;
        spacing: 24px;
        for tab[index] in root.tabs: Rectangle {
            width: label.preferred-width;
            label := Text {
                text: tab;
                font-size: 14px;
                font-weight: Theme.medium;
                color: root.selected == index ? Theme.text : Theme.text-secondary;
                vertical-alignment: center;
            }
            if root.selected == index: Rectangle {
                y: parent.height - 2px;
                height: 2px;
                background: Theme.text;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.selected = index;
                    App.scroll-y = 0px;
                }
            }
        }
    }
}

component VideoGrid inherits Rectangle {
    in property <[CardData]> cards;
    in property <string> status;
    in property <string> empty-text;
    callback request-art(int, int);
    property <length> gap: 18px;
    property <int> cols: max(1, floor((self.width + gap) / (240px + gap)));
    property <length> card-w: (self.width - (cols - 1) * gap) / cols;
    property <length> row-h: card-w * 9 / 16 + 100px + gap;
    property <int> first-row: max(0, floor((-art.absolute-position.y - art.overscan - 50px) / row-h));
    property <int> visible-rows: max(1, ceil((art.overscan * 2 + App.pane-height) / row-h) + 1);
    height: cards.length > 0 ? 50px + ceil(cards.length / cols) * row-h - gap : 132px;
    changed cards => { art.reset(); }
    art := ArtRequest {
        width: 100%;
        height: 100%;
        window-height: App.pane-height;
        from: first-row * cols;
        upto: min(cards.length, (first-row + visible-rows) * cols);
        request(from, upto) => { root.request-art(from, upto); }
    }
    SectionHeader {
        title: "Videos";
        view-all: false;
    }
    for slot in root.visible-rows * root.cols: Rectangle {
        property <int> index: root.first-row * root.cols + slot;
        x: mod(slot, root.cols) * (root.card-w + root.gap);
        y: 50px + (root.first-row + floor(slot / root.cols)) * root.row-h;
        width: root.card-w;
        height: root.row-h - root.gap;
        if index < root.cards.length: MediaCard {
            width: parent.width;
            card: root.cards[parent.index];
        }
    }
    if cards.length == 0 && status == "loading": TideLoader {
        x: (root.width - self.width) / 2;
        y: 64px;
    }
    if cards.length == 0 && status != "loading": Text {
        y: 62px;
        width: root.width;
        text: root.status == "error" ? "Couldn’t load videos. Try opening this page again." : root.empty-text;
        color: Theme.text-secondary;
        font-size: 15px;
        wrap: word-wrap;
    }
}

export component TracksView inherits Rectangle {
    property <length> pad: clamp((self.width - 900px) * 0.12, 24px, 89px);
    property <length> w: self.width - 2 * pad;
    property <bool> album-page: App.view == "album";
    property <bool> artist-page: App.view == "artist";
    property <bool> search-page: App.view == "search";
    property <bool> about: artist-page && App.artist-tab == 3;
    property <bool> music-tab: artist-page && App.artist-tab == 1;
    property <bool> video-tab: (artist-page && App.artist-tab == 2) || (search-page && App.search-tab == 1);
    property <bool> show-tracks: !about && !music-tab && !video-tab;
    property <bool> track-placeholders: artist-page && show-tracks && App.loading && App.tracks.length < 5;
    property <int> row-count: !show-tracks ? 0 : artist-page ? (track-placeholders ? 5 : min(5, App.tracks.length)) : App.tracks.length;
    property <bool> wide: w > 980px && !album-page;
    property <bool> show-bpm: wide && App.bpm-available && App.show-audio-metadata;
    property <bool> show-date: App.tracks-show-date && w > 760px;
    property <bool> has-cover: App.page-has-cover;
    property <bool> filterable: App.view == "tracks";
    property <length> row-h: 53px;
    // Vertical layout of the header block.
    property <length> top-inset: album-page || artist-page ? 64px : 0px;
    property <length> y-title: top-inset + (has-cover ? 4px : 8px);
    property <int> search-cols: w >= 900px ? 3 : 2;
    property <length> search-height: search-page && !video-tab && App.search-cards.length > 0
        ? 44px + ceil(App.search-cards.length / search-cols) * 66px : 0px;
    property <length> cover-size: album-page ? clamp(w * 0.25, 180px, 256px) : 218px;
    property <length> hero-h: artist-page ? clamp(w * 0.28, 218px, 352px) : has-cover ? cover-size : 38px;
    property <length> search-tabs-y: y-title + hero-h + 12px;
    property <length> y-buttons: artist-page ? top-inset + hero-h - 46px : y-title + hero-h + (has-cover ? 28px : 24px) + search-height + (search-page ? 58px : 0px);
    property <length> y-filter: y-buttons + 53px + 36px;
    property <length> y-tabs: top-inset + hero-h + 22px;
    property <length> y-top-tracks: y-tabs + 70px;
    property <length> y-columns: artist-page ? y-top-tracks + 38px : filterable ? y-filter + 44px + 40px : y-buttons + 53px + 30px;
    property <length> header-h: y-columns + 36px;
    // Column positions (fractions measured from the official client).
    property <length> x-artist: album-page ? w * 0.49 : wide ? w * 0.324 : w * 0.40;
    property <length> x-album: wide ? w * 0.544 : w * 0.64;
    property <length> x-date: w * 0.724;
    property <length> x-time: show-bpm ? w * 0.839 : w - 150px;
    property <length> x-bpm: w * 0.891;
    // Hand-rolled virtualisation so the header scrolls with the rows.
    property <int> first: max(0, floor((-sv.content-y - header-h) / row-h));
    property <int> visible-rows: ceil(self.height / row-h) + 2;
    changed first => {
        App.rows-visible(first, visible-rows);
    }
    changed visible-rows => {
        App.rows-visible(first, visible-rows);
    }
    sv := ScrollView {
        content-y <=> App.scroll-y;
        content-width: root.width;
        content-height: artist-page || album-page || search-page ? artist-content.y + artist-content.preferred-height + 48px
            : header-h + row-count * row-h + 48px;
        if artist-page || album-page: Rectangle {
            y: 0;
            width: root.width;
            height: top-inset + (artist-page ? hero-h + 14px : hero-h + 116px);
            clip: true;
            background: App.page-tint.darker(55%);
            if artist-page: Image {
                width: min(root.width * 0.60, parent.height);
                height: parent.height;
                source: App.page-cover;
                image-fit: cover;
                opacity: App.page-cover.width > 0 ? 1 : 0;
                animate opacity {
                    duration: 200ms;
                    easing: ease-in-out;
                }
            }
            Rectangle {
                background: @linear-gradient(180deg, #00000018 0%, #00000035 35%, #000000d9 82%, Theme.bg 100%);
            }
        }
        if has-cover && !artist-page: Cover {
            x: pad;
            y: y-title;
            width: cover-size;
            height: cover-size;
            source: App.page-cover;
            radius: 4px;
        }
        Text {
            x: has-cover && !artist-page ? pad + cover-size + 32px : pad;
            y: artist-page ? y-buttons - 53px : album-page ? y-title + cover-size * 0.23 : has-cover ? y-title + 74px : y-title;
            width: root.width - self.x - pad;
            height: has-cover ? 44px : 38px;
            text: App.page-title;
            color: Theme.text;
            font-size: has-cover ? 36px : 28px;
            font-weight: Theme.bold;
            overflow: elide;
            vertical-alignment: center;
        }

        if album-page && App.page-artist.id != "": Cover {
            x: pad + cover-size + 32px;
            y: y-title + cover-size * 0.23 + 46px;
            width: 24px;
            height: 24px;
            source: App.page-artist.image;
            round: true;
            TouchArea {
                mouse-cursor: pointer;
                clicked => { App.open-card(App.page-artist); }
            }
        }
        if has-cover && !artist-page: ArtistLinks {
            property <bool> linked: album-page && App.page-artists.length > 0;
            x: pad + cover-size + 32px + (album-page && App.page-artist.id != "" ? 34px : 0px);
            y: album-page ? y-title + cover-size * 0.23 + 48px : y-title + 124px;
            width: min(self.preferred-width, root.width - self.x - pad);
            height: self.preferred-height;
            artists: linked ? App.page-artists : [];
            text: App.page-subtitle;
            text-color: linked ? Theme.text : Theme.text-secondary;
            font-weight: Theme.medium;
            open(a) => { App.open-artist(a); }
        }
        if album-page: VerticalLayout {
            x: pad + cover-size + 32px;
            y: y-title + cover-size * 0.23 + 84px;
            width: max(0px, root.width - self.x - pad);
            height: self.preferred-height;
            spacing: 10px;
            Text {
                text: App.page-summary;
                color: Theme.text-secondary;
                font-size: 12px;
                font-weight: Theme.medium;
                letter-spacing: 1px;
            }
            HorizontalLayout {
                alignment: start;
                spacing: 12px;
                Text {
                    text: App.page-year;
                    color: Theme.text-secondary;
                    font-size: 13px;
                }
                if App.page-quality != "": Text {
                    text: App.page-quality;
                    color: App.page-quality == "MAX" ? Theme.max : App.page-quality == "LOSSLESS" || App.page-quality == "HIGH" ? Theme.lossless : Theme.text-secondary;
                    font-size: 12px;
                    font-weight: Theme.bold;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }
        }
        if search-page: CatalogTabs {
            x: pad;
            y: search-tabs-y;
            width: w;
            tabs: ["All", "Videos"];
            selected <=> App.search-tab;
        }
        if search-height > 0px: Rectangle {
            x: pad;
            y: search-tabs-y + 58px;
            width: w;
            height: search-height;
            property <length> tile-w: (w - (search-cols - 1) * 12px) / search-cols;
            SectionHeader {
                y: 0;
                title: "Artists & Albums";
                view-all: false;
            }
            for card[i] in App.search-cards: RowCard {
                x: mod(i, search-cols) * (parent.tile-w + 12px);
                y: 38px + floor(i / search-cols) * 66px;
                width: parent.tile-w;
                card: card;
                tile: true;
            }
        }
        if artist-page: Rectangle {
            x: pad;
            y: y-buttons;
            width: 48px;
            height: 48px;
            border-radius: 24px;
            background: artist-play.has-hover ? #dedede : white;
            Icon {
                source: @image-url("icons/play.svg");
                size: 20px;
                tint: black;
            }
            artist-play := TouchArea {
                enabled: App.tracks.length > 0;
                mouse-cursor: pointer;
                clicked => { App.play-all(false); }
            }
        }
        if !artist-page && !video-tab: PillButton {
            x: pad;
            y: y-buttons;
            text: "Play";
            icon: @image-url("icons/play.svg");
            primary: true;
            clicked => {
                App.play-all(false);
            }
        }

        if !artist-page && !video-tab: PillButton {
            x: pad + 176px + 18px;
            y: y-buttons;
            text: "Shuffle";
            icon: @image-url("icons/shuffle.svg");
            clicked => {
                App.play-all(true);
            }
        }

        if artist-page: Rectangle {
            x: pad + 64px;
            y: y-buttons + 6px;
            width: follow-label.preferred-width + 36px;
            height: 36px;
            border-radius: 18px;
            border-width: 1px;
            border-color: follow.has-hover ? Theme.text : #6a6a6a;
            background: App.page-favorite ? #ffffff1a : transparent;
            follow-label := Text {
                text: App.page-favorite ? "Following" : "Follow";
                color: Theme.text;
                font-size: 14px;
                font-weight: Theme.demibold;
            }
            follow := TouchArea {
                mouse-cursor: pointer;
                clicked => { App.toggle-page-favorite(); }
            }
        }
        // Add / Credits / Share / More, right of Play and Shuffle on album,
        // playlist and mix pages.
        if App.page-card.id != "": HorizontalLayout {
            x: root.width - pad - self.width;
            y: y-buttons - 2px;
            width: self.preferred-width;
            height: 58px;
            spacing: 12px;
            if App.page-can-favorite: ActionButton {
                icon: App.page-favorite ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
                label: App.page-favorite ? "Added" : "Add";
                clicked => { App.toggle-page-favorite(); }
            }
            // Wrapped: a popup on the root of a conditional element crashes the Slint 1.18 compiler.
            if album-page: HorizontalLayout {
                ActionButton {
                    icon: @image-url("icons/info.svg");
                    label: "Credits";
                    clicked => {
                        App.page-action("credits", "");
                        credits-pop.show();
                    }
                    credits-pop := PopupWindow {
                        x: parent.width - 340px;
                        y: parent.height + 6px;
                        width: 340px;
                        height: min(420px, credits-list.preferred-height + 62px);
                        MenuPanel {
                            Text {
                                height: 38px;
                                text: "  Credits";
                                color: Theme.text;
                                font-size: 17px;
                                font-weight: Theme.bold;
                                vertical-alignment: center;
                            }

                            ScrollView {
                                credits-list := VerticalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-bottom: 8px;
                                    spacing: 10px;
                                    alignment: start;
                                    if App.page-credits.length == 0: Text {
                                        text: App.page-credits-status;
                                        color: Theme.text-secondary;
                                        font-size: 14px;
                                    }
                                    for credit in App.page-credits: VerticalLayout {
                                        spacing: 2px;
                                        Text {
                                            text: credit.role;
                                            color: Theme.text-secondary;
                                            font-size: 12px;
                                            font-weight: Theme.medium;
                                        }

                                        Text {
                                            text: credit.names;
                                            color: Theme.text;
                                            font-size: 14px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            ActionButton {
                icon: @image-url("icons/share.svg");
                label: "Share";
                clicked => { share-pop.show(); }
                share-pop := PopupWindow {
                    x: parent.width - 240px;
                    y: parent.height + 6px;
                    width: 240px;
                    MenuPanel {
                        MenuRow {
                            label: "Copy link";
                            icon: @image-url("icons/link.svg");
                            has-icon: true;
                            activated => { App.page-action("copy-link", ""); }
                        }
                    }
                }
            }

            // The same menu a right-click on this album or playlist opens.
            ActionButton {
                icon: @image-url("icons/more.svg");
                label: "More";
                clicked => {
                    App.request-card-menu(App.page-card, self.absolute-position.x + self.width - 300px, self.absolute-position.y + self.height + 6px);
                }
            }
        }

        if artist-page: CatalogTabs {
            x: pad;
            y: y-tabs;
            width: w;
            tabs: ["All", "Music", "Videos", "About"];
            selected <=> App.artist-tab;
        }
        if artist-page && show-tracks: SectionHeader {
            x: pad;
            y: y-top-tracks;
            width: w;
            title: "Top Tracks";
            view-all: App.tracks.length > 4;
            show-all => { App.show-artist-tracks(); }
        }

        if filterable: Rectangle {
            x: pad;
            y: y-filter;
            width: w;
            height: 44px;
            border-radius: 8px;
            border-width: 1px;
            border-color: filter.has-focus ? #3a3a3a : Theme.border;
            Icon {
                x: 16px;
                source: @image-url("icons/search.svg");
                size: 16px;
            }

            if filter.text == "": Text {
                x: 49px;
                text: "Filter tracks";
                color: #aeafb2;
                font-size: 15px;
                vertical-alignment: center;
            }
            filter := EditableInput {
                x: 49px;
                width: parent.width - 65px;
                height: 20px;
                text <=> App.filter-text;
                color: Theme.text;
                font-size: 15px;
                single-line: true;
                vertical-alignment: center;
                selection-background-color: #4a4a4a;
                edited => {
                    App.filter(self.text);
                }
            }
        }
        if show-tracks: Rectangle {
            x: pad;
            y: y-columns;
            width: w;
            height: 36px;
            if !artist-page: HeaderLabel {
                x: 0;
                width: 44px;
                text: "#";
                horizontal-alignment: center;
            }

            HeaderLabel {
                x: artist-page ? 60px : 46px;
                text: "TITLE";
            }

            HeaderLabel {
                x: x-artist;
                text: "ARTIST";
            }

            if !album-page: HeaderLabel {
                x: x-album;
                text: "ALBUM";
            }

            if show-date: HeaderLabel {
                x: x-date;
                text: "DATE ADDED";
            }
            if show-date: Icon {
                x: x-date + 91px;
                source: @image-url("icons/chevron-down.svg");
                size: 14px;
                tint: Theme.lossless;
            }
            HeaderLabel {
                x: x-time;
                text: "TIME";
            }

            if show-bpm: HeaderLabel {
                x: x-bpm;
                text: "BPM";
            }
        }

        for i in root.visible-rows: Rectangle {
            x: pad;
            y: header-h + (first + i) * row-h;
            width: w;
            height: row-h;
            background: transparent;
            visible: first + i < row-count;
            if first + i < App.tracks.length: TrackRow {
                width: parent.width;
                track: App.tracks[first + i];
                index: first + i;
                album-page: root.album-page;
                artist-page: root.artist-page;
                show-bpm: root.show-bpm;
                show-date: root.show-date;
                x-artist: root.x-artist;
                x-album: root.x-album;
                x-date: root.x-date;
                x-time: root.x-time;
                x-bpm: root.x-bpm;
            }
            if root.track-placeholders && first + i >= App.tracks.length: TrackPlaceholder {
                width: parent.width;
                x-artist: root.x-artist;
                x-album: root.x-album;
                x-time: root.x-time;
            }
        }
        if show-tracks && App.tracks.length == 0 && !root.track-placeholders && App.loading: TideLoader {
            x: pad + (w - self.width) / 2;
            y: header-h + 72px;
        }
        if show-tracks && App.tracks.length == 0 && !root.track-placeholders && !App.loading: Text {
            x: pad;
            y: header-h + 24px;
            text: App.catalog-error ? "Couldn’t load tracks" : "Nothing here yet";
            color: Theme.text-secondary;
            font-size: 15px;
        }
        artist-content := VerticalLayout {
            x: pad;
            y: artist-page && !show-tracks ? y-tabs + 62px : search-page && video-tab ? search-tabs-y + 62px : header-h + row-count * row-h + (row-count == 0 ? 58px : 20px);
            width: w;
            height: self.preferred-height;
            spacing: 16px;
            if (artist-page && video-tab) || search-page: VideoGrid {
                cards: root.artist-page ? App.artist-videos : App.search-videos;
                status: root.artist-page ? App.artist-videos-status : App.search-videos-status;
                empty-text: root.artist-page ? "No videos available for this artist" : "No videos found";
                request-art(from, upto) => { App.catalog-video-art(root.artist-page, from, upto); }
            }
            if album-page && App.page-release-line != "": VerticalLayout {
                padding-top: 4px;
                padding-bottom: 46px;
                spacing: 6px;
                Text {
                    text: App.page-release-line;
                    color: Theme.text-secondary;
                    font-size: 11px;
                    font-weight: Theme.demibold;
                    letter-spacing: 1.4px;
                }

                if App.page-copyright != "": Text {
                    text: App.page-copyright;
                    color: Theme.text-secondary;
                    font-size: 11px;
                    font-weight: Theme.demibold;
                    letter-spacing: 1.4px;
                    wrap: word-wrap;
                }
            }
            if album-page && App.artist-albums.length > 0: Carousel {
                section: { title: "More Albums by " + App.page-artist.title, cards: App.artist-albums };
                show-all => { App.show-artist-releases(false); }
                request-art(from, upto) => { App.artist-release-art(false, from, upto); }
            }
            if album-page && App.related-artists.length > 0: Carousel {
                section: { title: "Related Artists", cards: App.related-artists };
                view-all: false;
                request-art(from, upto) => { App.related-art(from, upto); }
            }
            if music-tab: VerticalLayout {
                spacing: 0px;
                SectionHeader {
                    title: "Albums";
                    view-all: false;
                }
                for card in App.artist-albums: RowCard {
                    width: parent.width;
                    card: card;
                }
                if App.artist-singles.length > 0: SectionHeader {
                    title: "EPs & Singles";
                    view-all: false;
                }
                for card in App.artist-singles: RowCard {
                    width: parent.width;
                    card: card;
                }
            }
            if artist-page && show-tracks && App.artist-albums.length > 0: Carousel {
                section: { title: "Albums", cards: App.artist-albums };
                show-all => { App.show-artist-releases(false); }
                request-art(from, upto) => { App.artist-release-art(false, from, upto); }
            }
            if artist-page && show-tracks && App.artist-singles.length > 0: Carousel {
                section: { title: "EPs & Singles", cards: App.artist-singles };
                show-all => { App.show-artist-releases(true); }
                request-art(from, upto) => { App.artist-release-art(true, from, upto); }
            }
            if artist-page && show-tracks && App.related-artists.length > 0: Carousel {
                section: { title: "Related Artists", cards: App.related-artists };
                view-all: false;
                request-art(from, upto) => { App.related-art(from, upto); }
            }
            if artist-page && (about || (show-tracks && App.page-biography != "")): VerticalLayout {
                spacing: 12px;
                SectionHeader {
                    title: "Biography";
                    view-all: false;
                }
                Text {
                    width: min(720px, parent.width);
                    text: App.page-biography == "" ? "No biography available" : App.page-biography;
                    color: Theme.text-secondary;
                    font-size: 15px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// ---------------------------------------------------------------- card grid

// Round header button that opens a list of choices (sort by / group by).
component ChoiceButton inherits Rectangle {
    in property <image> icon;
    in property <string> heading;
    in property <[string]> options;
    in property <string> current;
    in property <bool> highlighted: false;
    in property <string> toggle-label: "";
    in property <bool> toggle-on: false;
    callback chosen(string);
    callback toggled(bool);
    width: 34px;
    height: 34px;
    border-radius: 17px;
    background: ta.has-hover ? #1e1e1e : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            pop.show();
        }
    }

    Icon {
        source: root.icon;
        size: 18px;
        tint: root.highlighted ? Theme.lossless : ta.has-hover ? Theme.text : Theme.text-secondary;
    }

    pop := PopupWindow {
        x: 0px;
        y: root.height + 6px;
        width: 260px;
        MenuPanel {
            Text {
                height: 30px;
                text: "   " + root.heading;
                color: Theme.text-secondary;
                font-size: 12px;
                font-weight: Theme.demibold;
                letter-spacing: 0.8px;
                vertical-alignment: center;
            }

            for option in root.options: MenuRow {
                label: option;
                checked: option == root.current;
                activated => {
                    root.chosen(option);
                }
            }

            if root.toggle-label != "": Rectangle {
                height: 8px;
                Rectangle {
                    y: 4px;
                    height: 1px;
                    background: #3a3a3a;
                }
            }
            if root.toggle-label != "": Rectangle {
                height: 44px;
                Text {
                    x: 14px;
                    width: parent.width - 76px;
                    text: root.toggle-label;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: Theme.demibold;
                    overflow: elide;
                    vertical-alignment: center;
                }
                Toggle {
                    x: parent.width - 54px;
                    y: 8px;
                    on: root.toggle-on;
                    toggled(v) => {
                        root.toggled(v);
                    }
                }
            }
        }
    }
}

// Discrete artwork-size control. Left is smaller covers, right is larger.
component StepSlider inherits Rectangle {
    in property <int> value;
    callback chosen(int);
    width: 128px;
    height: 34px;
    accessible-role: slider;
    accessible-label: "Artwork size";

    property <length> track-x: 22px;
    property <length> track-w: 84px;
    property <float> t: max(0, min(4, value)) / 4;

    function pick(mx: length) -> int {
        return max(0, min(4, Math.round((mx - track-x) / track-w * 4)));
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down || e.kind == PointerEventKind.up {
                root.chosen(root.pick(self.mouse-x));
            }
        }
        moved => {
            if self.pressed {
                root.chosen(root.pick(self.mouse-x));
            }
        }
    }

    // Small 2×2 grid.
    Rectangle { x: 1px; y: 11px; width: 5px; height: 5px; border-radius: 0.5px; background: Theme.text-secondary; }
    Rectangle { x: 8px; y: 11px; width: 5px; height: 5px; border-radius: 0.5px; background: Theme.text-secondary; }
    Rectangle { x: 1px; y: 18px; width: 5px; height: 5px; border-radius: 0.5px; background: Theme.text-secondary; }
    Rectangle { x: 8px; y: 18px; width: 5px; height: 5px; border-radius: 0.5px; background: Theme.text-secondary; }

    Rectangle {
        x: track-x;
        y: 16px;
        width: track-w;
        height: 2px;
        border-radius: 1px;
        background: #404040;
    }

    Rectangle {
        x: track-x + t * track-w - 6px;
        y: 11px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: white;
    }

    // Large single square.
    Rectangle {
        x: parent.width - 14px;
        y: 10px;
        width: 14px;
        height: 14px;
        border-radius: 2px;
        border-width: 1.5px;
        border-color: Theme.text-secondary;
        background: transparent;
    }
}

export component GridView inherits Rectangle {
    property <length> pad: clamp((self.width - 900px) * 0.12, 24px, 90px);
    property <length> w: self.width - 2 * pad;
    property <length> gap: App.grid-size <= 1 ? 12px : 18px;
    property <length> min-card: App.grid-size <= 0 ? 120px : App.grid-size == 1 ? 152px : App.grid-size == 2 ? 188px : App.grid-size == 3 ? 236px : 292px;
    property <int> cols: max(2, floor((w + gap) / (min-card + gap)));
    property <length> card-w: (w - (cols - 1) * gap) / cols;
    // Profiles have no subtitle line under the name.
    property <length> cell-h: App.grid-kind == "videos" ? card-w * 9 / 16 + 100px + gap : card-w + (App.grid-kind == "profiles" ? 40px : 76px) + gap;
    ScrollView {
        content-y <=> App.scroll-y;
        VerticalLayout {
            padding-left: root.pad;
            padding-right: root.pad;
            padding-top: 8px;
            padding-bottom: 24px;
            spacing: 0px;
            alignment: start;
            Rectangle {
                height: 38px;
                HorizontalLayout {
                    width: 100%;
                    spacing: 12px;
                    HorizontalLayout {
                        horizontal-stretch: 0;
                        spacing: 6px;
                        Text {
                            text: App.page-title;
                            color: Theme.text;
                            font-size: 28px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 10px;
                        }

                        if App.grid-sort-options.length > 0: VerticalLayout {
                            alignment: center;
                            ChoiceButton {
                                icon: @image-url("icons/sort.svg");
                                heading: "SORT BY";
                                options: App.grid-sort-options;
                                current: App.grid-sort;
                                chosen(option) => { App.set-grid-sort(option); }
                            }
                        }
                        if App.grid-group-options.length > 1: VerticalLayout {
                            alignment: center;
                            ChoiceButton {
                                icon: @image-url("icons/group.svg");
                                heading: "GROUP BY";
                                options: App.grid-group-options;
                                current: App.grid-group;
                                highlighted: App.grid-group != "None";
                                toggle-label: App.grid-kind == "playlists" ? "Combine other users" : "";
                                toggle-on: App.grid-combine-others;
                                chosen(option) => { App.set-grid-group(option); }
                                toggled(v) => { App.set-grid-combine-others(v); }
                            }
                        }
                        if App.grid-can-create: VerticalLayout {
                            alignment: center;
                            CreateButton {
                                size: 18px;
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    VerticalLayout {
                        horizontal-stretch: 0;
                        alignment: center;
                        StepSlider {
                            value: App.grid-size;
                            chosen(step) => { App.set-grid-size(step); }
                        }
                    }
                }
            }

            Rectangle {
                height: 26px;
            }

            Rectangle {
                height: 44px;
                border-radius: 8px;
                border-width: 1px;
                border-color: filter.has-focus ? #3a3a3a : Theme.border;
                Icon {
                    x: 16px;
                    source: @image-url("icons/search.svg");
                    size: 16px;
                }

                if filter.text == "": Text {
                    x: 49px;
                    text: App.grid-filter-hint;
                    color: #aeafb2;
                    font-size: 15px;
                    vertical-alignment: center;
                }
                filter := EditableInput {
                    x: 49px;
                    width: parent.width - 65px;
                    height: 20px;
                    text <=> App.filter-text;
                    color: Theme.text;
                    font-size: 15px;
                    single-line: true;
                    vertical-alignment: center;
                    selection-background-color: #4a4a4a;
                    edited => {
                        App.filter(self.text);
                    }
                }
            }

            Rectangle {
                height: 36px;
            }

            if App.grid-cards.length == 0 && App.loading: Rectangle {
                height: 280px;
                TideLoader { }
            }
            if App.grid-cards.length == 0 && !App.loading: Text {
                text: App.filter-text != "" ? "Nothing matches “" + App.filter-text + "”" : "Nothing here yet";
                color: Theme.text-secondary;
                font-size: 15px;
            }
            for group[g] in App.grid-groups: VerticalLayout {
                // Group header in the style of a library "group by" view:
                // a rule, the group name and how many items it holds.
                if group.title != "": Rectangle {
                    height: 58px;
                    Rectangle {
                        y: 0px;
                        height: 1px;
                        background: #1f1f1f;
                    }

                    Text {
                        x: 0px;
                        y: 14px;
                        width: parent.width - 120px;
                        text: group.title;
                        color: Theme.text;
                        font-size: 20px;
                        font-weight: Theme.bold;
                        overflow: elide;
                    }

                    Text {
                        x: parent.width - 120px;
                        y: 20px;
                        width: 120px;
                        text: group.cards.length + (group.cards.length == 1 ? " ITEM" : " ITEMS");
                        color: Theme.text-secondary;
                        font-size: 11px;
                        font-weight: Theme.demibold;
                        letter-spacing: 1px;
                        horizontal-alignment: right;
                    }
                }
                Rectangle {
                    property <int> n: group.cards.length;
                    property <int> first-row: max(0, floor((-art.absolute-position.y - art.overscan) / root.cell-h));
                    property <int> vis-rows: max(1, ceil((art.overscan + max(App.pane-height, 1px) + art.overscan) / root.cell-h));
                    height: ceil(n / root.cols) * root.cell-h;
                    art := ArtRequest {
                        width: 100%;
                        height: 100%;
                        window-height: App.pane-height;
                        from: first-row * root.cols;
                        upto: min(n, (first-row + vis-rows) * root.cols);
                        request(from, upto) => { App.grid-art(g, from, upto); }
                    }
                    for card[i] in group.cards: MediaCard {
                        x: mod(i, root.cols) * (root.card-w + root.gap);
                        y: floor(i / root.cols) * root.cell-h;
                        width: root.card-w;
                        card: card;
                    }
                }
            }
        }
    }
}

export component StubView inherits Rectangle {
    VerticalLayout {
        alignment: center;
        spacing: 10px;
        Text {
            text: App.page-title;
            color: Theme.text;
            font-size: 28px;
            font-weight: 700;
            horizontal-alignment: center;
        }

        Text {
            text: "This section isn't available in tidal-rust yet.";
            color: Theme.text-secondary;
            font-size: 15px;
            horizontal-alignment: center;
        }
    }
}

// ---------------------------------------------------------------- now playing

export component NowPlayingView inherits Rectangle {
    background: #1a1a1a;
    Rectangle {
        background: @linear-gradient(180deg, App.np-tint 0%, App.np-tint.darker(0.6) 55%, #1a1716 100%);
    }

    // Swallow clicks so they don't reach the view underneath.
    TouchArea { }

    DragArea {
        y: 0;
        height: 64px;
    }

    property <length> art: min(self.height - 96px - 200px, self.width * 0.40);
    Cover {
        x: max(48px, root.width * 0.28 - self.width / 2);
        y: (root.height - 96px - self.height) / 2 + 20px;
        width: art;
        height: art;
        source: App.np-cover-large;
        radius: 2px;
        drop-shadow-blur: 60px;
        drop-shadow-color: #00000080;
    }

    VerticalLayout {
        x: root.width * 0.51;
        y: 96px;
        width: root.width * 0.37;
        height: root.height - 96px - 110px;
        alignment: center;
        spacing: 30px;
        if App.lyrics.length == 0: Text {
            text: App.lyrics-status;
            color: #ffffff80;
            font-size: 28px;
            font-weight: 700;
            wrap: word-wrap;
        }
        for line in App.lyrics: Text {
            text: line.text;
            color: line.active ? white : #ffffff66;
            font-size: line.active ? 42px : 38px;
            font-weight: 700;
            wrap: word-wrap;
        }
    }

    HorizontalLayout {
        x: root.width - self.width - 16px;
        y: 12px;
        width: self.preferred-width;
        height: 40px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            DebugButton { }
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 68px;
                height: 34px;
                border-radius: 17px;
                background: white;
                Text {
                    text: "Lyrics";
                    color: black;
                    font-size: 14px;
                    font-weight: 600;
                }
            }
        }

        IconButton {
            icon: @image-url("icons/chevron-down.svg");
            size: 18px;
            tint: #ffffffb0;
            clicked => {
                App.show-now-playing = false;
            }
        }
    }
}

// ---------------------------------------------------------------- login

export component LoginView inherits Rectangle {
    background: Theme.bg;
    DragArea {
        y: 0;
        height: 64px;
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 520px;
                height: 440px;
                border-radius: 16px;
                background: #0e0e0e;
                border-width: 1px;
                border-color: Theme.border;
                VerticalLayout {
                    padding: 40px;
                    spacing: 18px;
                    alignment: center;
                    Text {
                        text: "T I D E";
                        color: Theme.text;
                        font-size: 30px;
                        font-weight: 800;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: App.user-code == "" ? "Log in to start listening in Max quality." : "Enter this code at link.tidal.com";
                        color: Theme.text-secondary;
                        font-size: 15px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }

                    // Default: Max-quality login in the default browser.
                    if App.user-code == "": MaxLogin {
                        centered: true;
                    }
                    if App.user-code != "": Rectangle {
                        height: 72px;
                        border-radius: 10px;
                        background: #161616;
                        EditableInput {
                            text: App.user-code;
                            read-only: true;
                            color: Theme.lossless;
                            font-size: 34px;
                            font-weight: 700;
                            letter-spacing: 6px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    if App.user-code != "": HorizontalLayout {
                        alignment: center;
                        PillButton {
                            width: 240px;
                            text: "Open browser";
                            primary: true;
                            clicked => {
                                App.open-browser();
                            }
                        }
                    }
                    if App.auth-status != "": Text {
                        text: App.auth-status;
                        color: Theme.text-secondary;
                        font-size: 13px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.border;
                    }

                    // Fallback: device code (TIDAL limits it to 16-bit, 44.1 kHz).
                    Rectangle {
                        height: 20px;
                        fallback := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                App.login();
                            }
                        }

                        Text {
                            text: "Trouble logging in? Use a device code instead (16-bit, 44.1 kHz only)";
                            color: fallback.has-hover ? Theme.text : Theme.text-secondary;
                            font-size: 13px;
                            horizontal-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
