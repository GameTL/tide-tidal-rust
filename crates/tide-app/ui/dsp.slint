// DSP page: the combined response, then the USR and SPK equalisers.
import { ScrollView } from "std-widgets.slint";
import { App, Theme, EditableInput, Toggle, Icon, Slider, MenuPanel, MenuRow } from "common.slint";

component Card inherits Rectangle {
    border-radius: 12px;
    background: #0e0e10;
    border-width: 1px;
    border-color: #17171a;
    VerticalLayout {
        padding: 18px;
        spacing: 14px;
        @children
    }
}

component Pill inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    in property <bool> selected: false;
    callback clicked();
    width: label.preferred-width + 30px;
    height: 34px;
    border-radius: 17px;
    background: primary || selected ? (ta.has-hover ? #e6e6e6 : white) : (ta.has-hover ? #2c2c2c : #1f1f22);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    label := Text {
        text: root.text;
        color: root.primary || root.selected ? black : white;
        font-size: 13px;
        font-weight: 600;
    }
}

// Frequency-response plot: 20 Hz – 20 kHz on a log axis.
component Plot inherits Rectangle {
    in property <float> min-db: -App.dsp-range;
    in property <float> max-db: App.dsp-range;
    background: #0b0c0e;
    border-radius: 10px;
    border-width: 1px;
    border-color: #1c1c20;
    clip: true;
    for mark in [
        { f: 50, t: "50" },
        { f: 100, t: "100" },
        { f: 200, t: "200" },
        { f: 500, t: "500" },
        { f: 1000, t: "1k" },
        { f: 2000, t: "2k" },
        { f: 5000, t: "5k" },
        { f: 10000, t: "10k" }
    ]: Rectangle {
        x: root.width * Math.log(mark.f / 20, 1000);
        y: 0px;
        width: 1px;
        height: root.height;
        background: #1a1c20;
        Text {
            x: 5px;
            y: root.height - 18px;
            text: mark.t;
            color: #6a6a70;
            font-size: 10.5px;
        }
    }
    for index in [0, 1, 2, 3, 4]: Rectangle {
        property <float> db: root.min-db + (root.max-db - root.min-db) * index / 4;
        x: 0px;
        y: root.height * (1 - (self.db - root.min-db) / (root.max-db - root.min-db));
        width: root.width;
        height: 1px;
        background: self.db == 0 ? #3a3d44 : #1a1c20;
        Text {
            x: 7px;
            y: parent.db == root.max-db ? 2px : -15px;
            text: (parent.db > 0 ? "+" : "") + parent.db + " dB";
            color: #6a6a70;
            font-size: 10.5px;
        }
    }
    @children
}

component Curve inherits Path {
    in property <color> tone: white;
    in property <length> weight: 2px;
    viewbox-width: 1000;
    viewbox-height: 1000;
    fit: fill;
    clip: true;
    stroke: root.tone;
    stroke-width: root.weight;
    stroke-line-join: round;
    fill: transparent;
}

// Height of the taller of `text` and `reserve`, so swapping copy does not jump.
component HoldText inherits Rectangle {
    in property <string> text;
    in property <string> reserve;
    in property <color> ink;
    in property <length> font-size: 13px;
    in property <int> font-weight: 400;
    horizontal-stretch: 1;
    height: max(shown.preferred-height, probe.preferred-height);

    shown := Text {
        width: parent.width;
        text: root.text;
        color: root.ink;
        font-size: root.font-size;
        font-weight: root.font-weight;
        wrap: word-wrap;
    }

    probe := Text {
        width: parent.width;
        visible: false;
        text: root.reserve;
        font-size: root.font-size;
        font-weight: root.font-weight;
        wrap: word-wrap;
    }
}

component LegendDot inherits HorizontalLayout {
    in property <color> tone;
    in property <string> text;
    in property <string> reserve;
    spacing: 6px;
    VerticalLayout {
        alignment: center;
        Rectangle {
            width: 14px;
            height: 3px;
            border-radius: 1.5px;
            background: root.tone;
        }
    }

    Rectangle {
        width: max(shown.preferred-width, probe.preferred-width);
        shown := Text {
            text: root.text;
            color: Theme.text-secondary;
            font-size: 12px;
            vertical-alignment: center;
        }

        probe := Text {
            visible: false;
            text: root.reserve == "" ? root.text : root.reserve;
            font-size: 12px;
        }
    }
}

// Label, slider and a typed value for one number.
component ParamRow inherits Rectangle {
    in property <string> label;
    in property <string> unit;
    in property <float> pos;
    in-out property <string> text;
    callback slid(float);
    callback typed(string);
    height: 40px;
    HorizontalLayout {
        spacing: 16px;
        Text {
            width: 84px;
            text: root.label;
            color: Theme.text;
            font-size: 14px;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            Slider {
                value: root.pos;
                live: true;
                changed(v) => {
                    root.slid(v);
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 84px;
                height: 34px;
                border-radius: 8px;
                border-width: 1px;
                border-color: input.has-focus ? #4a4a4a : #26262a;
                background: #0a0a0a;
                input := EditableInput {
                    x: 10px;
                    width: parent.width - 20px;
                    height: 20px;
                    text <=> root.text;
                    color: Theme.text;
                    font-size: 14px;
                    single-line: true;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                    selection-background-color: #4a4a4a;
                    accepted => {
                        self.clear-focus();
                    }
                    focused(on) => {
                        if !on {
                            root.typed(self.text);
                        }
                    }
                }
            }
        }

        Text {
            width: 22px;
            text: root.unit;
            color: Theme.text-secondary;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
}

export component DspView inherits Rectangle {
    property <length> column-w: min(892px, self.width - 64px);
    property <color> usr-tone: #38bdf8;
    property <color> spk-tone: #fb923c;
    property <string> device-lead: "Sound output: " + App.dsp-device + ". Both EQs are remembered for this output and come back whenever it is the one playing";
    property <string> usr-blurb: "User / preference EQ. Shape the sound to taste: more bass, less treble, whatever you like on top of the baseline.";
    property <string> spk-blurb: "Speaker / baseline EQ. Corrects this output towards a target, such as a neutral curve or another headphone. Set it once, then leave taste to the USR EQ.";
    property <string> band-none: "No bands yet. Add one, or double-click the graph.";
    property <string> band-pick: "Pick a dot to edit it. Drag it to change frequency and gain; double-click the graph to add a band.";
    ScrollView {
        content-y <=> App.scroll-y;
        VerticalLayout {
            padding-left: (root.width - root.column-w) / 2;
            padding-right: (root.width - root.column-w) / 2;
            padding-top: 12px;
            padding-bottom: 60px;
            spacing: 14px;
            alignment: start;
            HorizontalLayout {
                spacing: 12px;
                Text {
                    text: "DSP";
                    color: Theme.text;
                    font-size: 28px;
                    font-weight: 700;
                    height: 44px;
                    vertical-alignment: center;
                }


            }

            HoldText {
                text: root.device-lead + (App.dsp-outputs > 1 ? " (" + App.dsp-outputs + " outputs remembered)." : ".");
                reserve: root.device-lead + " (99 outputs remembered).";
                ink: Theme.text-secondary;
            }

            Card {
                HorizontalLayout {
                    spacing: 16px;
                    Text {
                        text: "Resultant response";
                        color: Theme.text;
                        font-size: 15px;
                        font-weight: 600;
                        vertical-alignment: center;
                    }

                    Rectangle { }

                    LegendDot {
                        tone: root.usr-tone;
                        text: App.dsp-usr-on ? "USR EQ" : "USR EQ (flat)";
                        reserve: "USR EQ (flat)";
                    }

                    LegendDot {
                        tone: root.spk-tone;
                        text: App.dsp-spk-on ? "SPK EQ" : "SPK EQ (flat)";
                        reserve: "SPK EQ (flat)";
                    }

                    LegendDot {
                        tone: white;
                        text: "Both, with preamp";
                    }
                }

                Plot {
                    min-db: App.dsp-result-min;
                    max-db: App.dsp-result-max;
                    height: 230px;
                    Curve {
                        width: parent.width;
                        height: parent.height;
                        commands: App.dsp-spk-path;
                        tone: root.spk-tone.with-alpha(App.dsp-spk-on ? 0.75 : 0.0);
                        weight: 1.25px;
                    }

                    Curve {
                        width: parent.width;
                        height: parent.height;
                        commands: App.dsp-usr-path;
                        tone: root.usr-tone.with-alpha(App.dsp-usr-on ? 0.75 : 0.0);
                        weight: 1.25px;
                    }

                    if !App.dsp-enabled: Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: #00000099;
                    }

                    Curve {
                        width: parent.width;
                        height: parent.height;
                        commands: App.dsp-total-path;
                        weight: 2.5px;
                    }
                }

                HorizontalLayout {
                    height: 34px;
                    spacing: 12px;
                    opacity: App.dsp-overshoot > 0 ? 1 : 0;
                    Text {
                        text: "Peaks " + Math.round(App.dsp-overshoot * 10) / 10 + " dB above full scale, so loud passages can clip.";
                        color: #f5b942;
                        font-size: 13px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Pill {
                        text: "Lower preamp";
                        clicked => {
                            if App.dsp-overshoot > 0 {
                                App.dsp-action("fix-headroom");
                            }
                        }
                    }
                }
            }

            Card {
                HorizontalLayout {
                    spacing: 12px;
                    ParamRow {
                        horizontal-stretch: 1;
                        label: "Preamp";
                        unit: "dB";
                        pos: App.dsp-preamp-pos;
                        text <=> App.dsp-preamp-text;
                        slid(v) => { App.dsp-set-preamp("", v); }
                        typed(t) => { App.dsp-set-preamp(t, -1); }
                    }

                    VerticalLayout {
                        alignment: center;
                        Pill {
                            text: "Auto";
                            selected: App.dsp-auto-preamp;
                            clicked => { App.dsp-toggle-auto-preamp(); }
                        }
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #19191c;
            }

            Rectangle {
                height: 48px;
                HorizontalLayout {
                    spacing: 0px;
                    for tab[i] in ["USR EQ", "SPK EQ"]: Rectangle {
                        horizontal-stretch: 1;
                        TouchArea { clicked => { App.dsp-select-tab(i); } }
                        HorizontalLayout {
                            padding-right: 16px;
                            padding-left: i == 0 ? 0px : 16px;
                            Text {
                                text: tab;
                                color: App.dsp-tab == i ? Theme.text : Theme.text-secondary;
                                font-size: 15px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                            Rectangle { }
                            VerticalLayout {
                                alignment: center;
                                Pill {
                                    property <bool> on: i == 0 ? App.dsp-usr-enabled : App.dsp-spk-enabled;
                                    width: 58px;
                                    text: self.on ? "On" : "Off";
                                    selected: self.on;
                                    clicked => { App.dsp-set-eq-enabled(i, !self.on); }
                                }
                            }
                        }
                        if App.dsp-tab == i: Rectangle {
                            y: parent.height - 2px;
                            height: 2px;
                            background: white;
                        }
                    }
                }
                Rectangle { x: parent.width / 2; width: 1px; height: parent.height; background: #26262a; }
                Rectangle { y: parent.height - 1px; height: 1px; background: #19191c; }
            }

            HoldText {
                text: App.dsp-tab == 0 ? root.usr-blurb : root.spk-blurb;
                reserve: App.dsp-tab == 0 ? root.spk-blurb : root.usr-blurb;
                ink: Theme.text-secondary;
            }

            Card {
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 34px;
                            min-width: 160px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: name-input.has-focus ? #4a4a4a : #26262a;
                            background: #0a0a0a;
                            if name-input.text == "": Text {
                                x: 12px;
                                text: "Name this EQ";
                                color: Theme.text-secondary;
                                font-size: 14px;
                                vertical-alignment: center;
                            }
                            name-input := EditableInput {
                                x: 12px;
                                width: parent.width - 24px;
                                height: 20px;
                                text <=> App.dsp-name;
                                color: Theme.text;
                                font-size: 14px;
                                single-line: true;
                                vertical-alignment: center;
                                selection-background-color: #4a4a4a;
                                accepted => {
                                    self.clear-focus();
                                }
                                focused(on) => {
                                    if !on {
                                        App.dsp-edit("name", self.text);
                                    }
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        menu-button := Pill {
                            text: "Save / load ▾";
                            clicked => {
                                preset-popup.show();
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        opacity: App.dsp-tab == 1 ? 1 : 0;
                        Pill {
                            text: "Browse AutoEq";
                            selected: App.autoeq-open && App.dsp-tab == 1;
                            clicked => {
                                if App.dsp-tab == 1 {
                                    App.dsp-action(App.autoeq-open ? "autoeq-close" : "autoeq");
                                }
                            }
                        }
                    }
                }

                if App.autoeq-open && App.dsp-tab == 1: Rectangle {
                    border-radius: 10px;
                    background: #0a0a0b;
                    border-width: 1px;
                    border-color: #1c1c20;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 8px;
                        HorizontalLayout {
                            spacing: 10px;
                            Rectangle {
                                height: 34px;
                                border-radius: 8px;
                                border-width: 1px;
                                border-color: search.has-focus ? #4a4a4a : #26262a;
                                background: #060606;
                                if search.text == "": Text {
                                    x: 12px;
                                    text: "Search AutoEq: headphone or source (\"HD 660S2 oratory\")";
                                    color: Theme.text-secondary;
                                    font-size: 14px;
                                    vertical-alignment: center;
                                }
                                search := EditableInput {
                                    x: 12px;
                                    width: parent.width - 24px;
                                    height: 20px;
                                    text <=> App.autoeq-query;
                                    color: Theme.text;
                                    font-size: 14px;
                                    single-line: true;
                                    vertical-alignment: center;
                                    selection-background-color: #4a4a4a;
                                    edited => {
                                        App.autoeq-search(self.text);
                                    }
                                }
                            }

                            Pill {
                                text: "Refresh";
                                clicked => {
                                    App.dsp-action("autoeq-refresh");
                                }
                            }

                            Pill {
                                text: "Close";
                                clicked => {
                                    App.dsp-action("autoeq-close");
                                }
                            }
                        }

                        Text {
                            text: App.autoeq-status;
                            color: Theme.text-secondary;
                            font-size: 12.5px;
                            wrap: word-wrap;
                        }

                        for hit[i] in App.autoeq-hits: Rectangle {
                            height: 38px;
                            border-radius: 8px;
                            background: hit-ta.has-hover ? #1c1c1f : transparent;
                            hit-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    App.autoeq-pick(i);
                                }
                            }

                            Text {
                                x: 12px;
                                width: parent.width * 0.58 - 12px;
                                text: hit.name;
                                color: Theme.text;
                                font-size: 14px;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            Text {
                                x: parent.width * 0.58 + 8px;
                                width: parent.width * 0.42 - 20px;
                                text: hit.source;
                                color: Theme.text-secondary;
                                font-size: 13px;
                                overflow: elide;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                graph := Plot {
                    height: 280px;
                    TouchArea {
                        clicked => {
                            App.dsp-select-band(-1);
                        }
                        double-clicked => {
                            App.dsp-add-band(self.mouse-x / self.width, self.mouse-y / self.height);
                        }
                    }

                    if App.dsp-selected >= 0 && App.dsp-band-path != "": Curve {
                        width: parent.width;
                        height: parent.height;
                        commands: App.dsp-band-path;
                        tone: App.dsp-bands[App.dsp-selected].tint.with-alpha(0.8);
                        weight: 1.25px;
                    }
                    Curve {
                        width: parent.width;
                        height: parent.height;
                        commands: App.dsp-curve-path;
                        tone: App.dsp-enabled ? white : #6a6a70;
                        weight: 2.5px;
                    }

                    for band[i] in App.dsp-bands: Rectangle {
                        property <bool> picked: App.dsp-selected == i;
                        x: band.x * graph.width - 8px;
                        y: band.y * graph.height - 8px;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: band.enabled ? band.tint : #55555a;
                        border-width: 1.5px;
                        border-color: self.picked ? white : #000000b0;
                        // The ring that marks the band being edited.
                        if self.picked: Rectangle {
                            x: -4px;
                            y: -4px;
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            border-width: 1.5px;
                            border-color: band.tint.with-alpha(0.7);
                        }
                        TouchArea {
                            x: -6px;
                            y: -6px;
                            width: 28px;
                            height: 28px;
                            mouse-cursor: move;
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down {
                                    App.dsp-select-band(i);
                                }
                            }
                            moved => {
                                if self.pressed {
                                    App.dsp-move-band(i, (parent.x + 8px + self.mouse-x - self.pressed-x) / graph.width, (parent.y + 8px + self.mouse-y - self.pressed-y) / graph.height);
                                }
                            }
                        }
                    }
                }


                Rectangle {
                    height: 1px;
                    background: #19191c;
                }

                HorizontalLayout {
                    height: 34px;
                    spacing: 10px;
                    Text {
                        horizontal-stretch: 1;
                        text: App.dsp-selected >= 0 ? "Band " + (App.dsp-selected + 1) : App.dsp-bands.length == 0 ? root.band-none : root.band-pick;
                        color: App.dsp-selected >= 0 ? Theme.text : Theme.text-secondary;
                        font-size: App.dsp-selected >= 0 ? 15px : 13px;
                        font-weight: App.dsp-selected >= 0 ? 600 : 400;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if App.dsp-selected >= 0: HorizontalLayout {
                        spacing: 6px;
                        for kind[k] in ["Peak", "Low shelf", "High shelf"]: VerticalLayout {
                            alignment: center;
                            Pill {
                                text: kind;
                                selected: App.dsp-band-kind == k;
                                clicked => {
                                    App.dsp-set-kind(k);
                                }
                            }
                        }
                    }
                    Rectangle { }

                    if App.dsp-selected >= 0: VerticalLayout {
                        alignment: center;
                        Toggle {
                            on: App.dsp-band-enabled;
                            toggled(v) => {
                                App.dsp-set-band-enabled(v);
                            }
                        }
                    }
                    if App.dsp-selected >= 0: VerticalLayout {
                        alignment: center;
                        Pill {
                            text: "Remove";
                            clicked => {
                                App.dsp-remove-band();
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Pill {
                            text: "Add band";
                            clicked => {
                                App.dsp-add-band(-1, -1);
                            }
                        }
                    }
                }

                if App.dsp-selected >= 0: ParamRow {
                    label: "Frequency";
                    unit: "Hz";
                    pos: App.dsp-freq-pos;
                    text <=> App.dsp-freq-text;
                    slid(v) => {
                        App.dsp-slide("freq", v);
                    }
                    typed(t) => {
                        App.dsp-edit("freq", t);
                    }
                }
                if App.dsp-selected >= 0: ParamRow {
                    label: "Gain";
                    unit: "dB";
                    pos: App.dsp-gain-pos;
                    text <=> App.dsp-gain-text;
                    slid(v) => {
                        App.dsp-slide("gain", v);
                    }
                    typed(t) => {
                        App.dsp-edit("gain", t);
                    }
                }
                if App.dsp-selected >= 0: ParamRow {
                    label: "Q";
                    unit: "";
                    pos: App.dsp-q-pos;
                    text <=> App.dsp-q-text;
                    slid(v) => {
                        App.dsp-slide("q", v);
                    }
                    typed(t) => {
                        App.dsp-edit("q", t);
                    }
                }
            }
        }
    }

    preset-popup := PopupWindow {
        x: menu-button.absolute-position.x - root.absolute-position.x;
        y: menu-button.absolute-position.y - root.absolute-position.y + 40px;
        width: 332px;
        height: 16px + 7 * 44px + 8px + (App.dsp-presets.length > 0 ? 33px + App.dsp-presets.length * 44px : 0px);
        MenuPanel {
            MenuRow {
                label: "Undo";
                hint: "⌘Z";
                icon: @image-url("icons/undo.svg");
                has-icon: true;
                enabled: App.dsp-can-undo;
                activated => {
                    App.dsp-action("undo");
                }
            }

            MenuRow {
                label: "Redo";
                hint: "⌘⇧Z";
                icon: @image-url("icons/redo.svg");
                has-icon: true;
                enabled: App.dsp-can-redo;
                activated => {
                    App.dsp-action("redo");
                }
            }

            Rectangle {
                height: 8px;
                Rectangle {
                    y: 4px;
                    height: 1px;
                    background: #444444;
                }
            }

            MenuRow {
                label: "Save as preset";
                icon: @image-url("icons/save.svg");
                has-icon: true;
                activated => {
                    App.dsp-action("save-preset");
                }
            }

            MenuRow {
                label: "Import from file…";
                icon: @image-url("icons/folder.svg");
                has-icon: true;
                activated => {
                    App.dsp-action("import");
                }
            }

            MenuRow {
                label: "Export parametric EQ…";
                icon: @image-url("icons/download.svg");
                has-icon: true;
                activated => {
                    App.dsp-action("export-parametric");
                }
            }

            MenuRow {
                label: "Export GraphicEQ (Wavelet)…";
                icon: @image-url("icons/eq.svg");
                has-icon: true;
                activated => {
                    App.dsp-action("export-graphic");
                }
            }

            MenuRow {
                label: "Reset to flat";
                icon: @image-url("icons/rotate-ccw.svg");
                has-icon: true;
                activated => {
                    App.dsp-action("reset");
                }
            }

            if App.dsp-presets.length > 0: Rectangle {
                height: 33px;
                Rectangle {
                    y: 4px;
                    height: 1px;
                    background: #444444;
                }

                Text {
                    x: 14px;
                    y: 10px;
                    text: "PRESETS";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 1px;
                }
            }
            for preset[i] in App.dsp-presets: Rectangle {
                height: 44px;
                border-radius: 8px;
                background: preset-ta.has-hover || delete-ta.has-hover ? #3d3d3d : transparent;
                preset-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        App.dsp-load-preset(i);
                    }
                }

                Text {
                    x: 14px;
                    width: parent.width - 58px;
                    text: preset;
                    color: Theme.text;
                    font-size: 15px;
                    overflow: elide;
                    vertical-alignment: center;
                }

                Rectangle {
                    x: parent.width - 38px;
                    width: 30px;
                    height: 30px;
                    border-radius: 15px;
                    background: delete-ta.has-hover ? #555555 : transparent;
                    delete-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            App.dsp-delete-preset(i);
                        }
                    }

                    Icon {
                        source: @image-url("icons/x.svg");
                        size: 14px;
                        tint: delete-ta.has-hover ? Theme.text : Theme.text-secondary;
                    }
                }
            }
        }
    }
}
