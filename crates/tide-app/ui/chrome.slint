// Window chrome: sidebar, top bar and the bottom player bar.
import { TrackMenuButton } from "context-menu.slint";
import { HoverTip } from "common.slint";
import { ScrollView } from "std-widgets.slint";
import { CreateButton, App, Theme, Kbd, EditableInput, Icon, IconButton, CircleButton, DebugButton, Cover, CardArt, CardData, ExplicitBadge, ArtistLinks, Slider, DragArea, Toggle, TideLoader } from "common.slint";

export component NavItem inherits Rectangle {
    // Icon only (the narrow sidebar).
    in property <bool> compact: App.sidebar-compact;
    in property <string> label;
    in property <image> icon;
    in property <string> key;
    // The key that opens this page (platform::configure_input), drawn at the
    // right of the row while ⌘ is held.
    in property <string> hint;
    // The label is lead + mark + tail; mark is the page key, drawn white.
    in property <string> lead;
    in property <string> mark;
    in property <string> tail;
    property <bool> selected: App.nav-key == key;
    // Official item: 8px pad, 24px icon box, 8px gap, 12px radius, 14px type.
    height: 40px;
    Rectangle {
        x: root.compact ? 9px : 16px;
        width: parent.width - 2 * self.x;
        border-radius: 12px;
        background: selected ? Theme.selected : ta.has-hover ? #141414 : transparent;
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                App.navigate(root.key);
            }
        }

        Icon {
            x: root.compact ? (parent.width - self.width) / 2 : 8px + (24px - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: root.icon;
            size: 16px;
            tint: selected || ta.has-hover ? Theme.text : Theme.text-secondary;
        }

        if !root.compact && root.mark == "": Text {
            x: 40px;
            height: 100%;
            text: root.label;
            color: selected || ta.has-hover ? Theme.text : Theme.text-secondary;
            font-size: 14px;
            font-weight: Theme.demibold;
            vertical-alignment: center;
        }

        if !root.compact && root.mark != "": label-row := HorizontalLayout {
            x: 40px;
            height: 100%;
            alignment: start;
            property <color> ink: selected || ta.has-hover ? Theme.text : Theme.text-secondary;
            if root.lead != "": Text {
                text: root.lead;
                color: label-row.ink;
                font-size: 14px;
                font-weight: Theme.demibold;
                vertical-alignment: center;
            }
            // The page key reads white, the rest of the label grey (Settings,
            // or while ⌘ is held).
            Text {
                text: root.mark;
                color: App.show-key-letters || App.command-held ? Theme.text : label-row.ink;
                font-size: 14px;
                font-weight: Theme.demibold;
                vertical-alignment: center;
            }
            if root.tail != "": Text {
                text: root.tail;
                color: label-row.ink;
                font-size: 14px;
                font-weight: Theme.demibold;
                vertical-alignment: center;
            }
        }

        if !root.compact && App.command-held && root.hint != "": Kbd {
            x: parent.width - self.width - 10px;
            y: (parent.height - self.height) / 2;
            glyph: root.hint;
        }
    }
}

export component SidebarPlaylist inherits Rectangle {
    in property <CardData> card;
    // Artwork only (the narrow sidebar).
    in property <bool> compact: App.sidebar-compact;
    height: 57px;
    ta := TouchArea {
        mouse-cursor: pointer;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                App.request-card-menu(root.card, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            App.open-card(root.card);
        }
    }

    Rectangle {
        x: 10px;
        width: parent.width - 20px;
        border-radius: 8px;
        background: ta.has-hover ? #141414 : transparent;
    }

    CardArt {
        x: 16px;
        width: 40px;
        height: 40px;
        card: root.card;
        radius: 3px;
    }

    if !root.compact: VerticalLayout {
        x: 68px;
        width: parent.width - 72px - 16px;
        alignment: center;
        spacing: 2px;
        Text {
            text: card.title;
            color: Theme.text;
            font-size: 15px;
            font-weight: 500;
            overflow: elide;
        }

        Text {
            // An own playlist's "98 TRACKS" and a folder's count are small caps.
            property <bool> counted: card.kind == "folder" || (card.kind == "playlist" && card.by == "Me");
            text: card.subtitle;
            color: Theme.text-secondary;
            font-size: self.counted ? 10.5px : 13px;
            font-weight: self.counted ? Theme.medium : 400;
            letter-spacing: self.counted ? 0.7px : 0px;
            overflow: elide;
        }
    }
}

export component Sidebar inherits Rectangle {
    width: App.sidebar-compact ? max(72px, 72px / App.zoom-factor) : 256px;
    property <length> header-height: App.sidebar-compact ? max(90px, 90px / App.zoom-factor) : 64px;
    background: Theme.bg;
    // Space for the macOS traffic lights.
    Rectangle {
        y: 0;
        height: root.header-height;
        DragArea { }

        IconButton {
            x: App.sidebar-compact ? (parent.width - self.width) / 2 : parent.width - 38px;
            y: App.sidebar-compact ? max(43px, 43px / App.zoom-factor) : 13px;
            icon: App.sidebar-compact ? @image-url("icons/chevron-right.svg") : @image-url("icons/collapse.svg");
            enabled: !App.compact-layout;
            size: 18px;
            tint: Theme.text-dim;
            clicked => { App.sidebar-collapsed = !App.sidebar-collapsed; }
        }
    }

    ScrollView {
        y: root.header-height;
        height: parent.height - root.header-height;
        VerticalLayout {
            alignment: start;
            padding-bottom: 12px + App.bar-inset;
            NavItem {
                label: "Music";
                hint: "esc";
                key: "home";
                icon: @image-url("icons/music.svg");
            }

            NavItem {
                label: "Explore";
                lead: "";
                mark: "E";
                tail: "xplore";
                hint: "E";
                key: "explore";
                icon: @image-url("icons/globe.svg");
            }

            NavItem {
                label: "Feed";
                lead: "";
                mark: "F";
                tail: "eed";
                hint: "F";
                key: "feed";
                icon: @image-url("icons/bell.svg");
            }

            if App.show-collection: VerticalLayout {
                if !App.sidebar-compact: Rectangle {
                    height: 54px;
                    Text {
                        x: 24px;
                        y: 24px;
                        text: "Collection";
                        color: Theme.text-dim;
                        font-size: 14px;
                        font-weight: Theme.bold;
                    }
                }

                NavItem {
                    label: "Mixes";
                    lead: "";
                    mark: "M";
                    tail: "ixes";
                    hint: "M";
                    key: "mixes";
                    icon: @image-url("icons/radio.svg");
                }

                NavItem {
                    label: "Playlists";
                    lead: "";
                    mark: "P";
                    tail: "laylists";
                    hint: "P";
                    key: "playlists";
                    icon: @image-url("icons/playlist.svg");
                }

                NavItem {
                    label: "Albums";
                    lead: "";
                    mark: "A";
                    tail: "lbums";
                    hint: "A";
                    key: "albums";
                    icon: @image-url("icons/disc.svg");
                }

                NavItem {
                    label: "Tracks";
                    lead: "";
                    mark: "T";
                    tail: "racks";
                    hint: "T";
                    key: "tracks";
                    icon: @image-url("icons/music.svg");
                }

                NavItem {
                    label: "Videos";
                    lead: "";
                    mark: "V";
                    tail: "ideos";
                    hint: "V";
                    key: "videos";
                    icon: @image-url("icons/video.svg");
                }

                NavItem {
                    label: "Profiles";
                    lead: "Pr";
                    mark: "o";
                    tail: "files";
                    hint: "O";
                    key: "profiles";
                    icon: @image-url("icons/key.svg");
                }

                NavItem {
                    label: "Save for Later";
                    key: "later";
                    icon: @image-url("icons/bookmark.svg");
                }

            }

            if !App.sidebar-compact: Rectangle {
                height: 54px;
                Text {
                    x: 24px;
                    y: 24px;
                    text: "All playlists";
                    color: Theme.text-dim;
                    font-size: 14px;
                    font-weight: Theme.medium;
                }

                CreateButton {
                    x: parent.width - 70px;
                    y: 16px;
                }

                IconButton {
                    x: parent.width - 36px;
                    y: 16px;
                    icon: @image-url("icons/sort.svg");
                    size: 16px;
                    tint: App.sidebar-ascending ? Theme.text-dim : Theme.text;
                    clicked => { App.sort-playlists(); }
                }
            }

            for card in App.sidebar-playlists: SidebarPlaylist {
                card: card;
            }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: #141414;
    }
}

// The user's own playlists in the sidebar's place while a track is dragged
// (App.drag-active): letting go over one adds the track to it. The area the
// drag started on keeps the pointer, so nothing here is hovered or clicked:
// the row under the pointer is worked out from where the pointer is.
export component PlaylistDrop inherits Rectangle {
    width: App.drop-panel-width;
    background: Theme.bg;
    property <length> row-h: 57px;
    property <int> rows: App.own-playlists.length;
    // The recently used playlists lead the list, set off by a hairline.
    property <int> recent: App.recent-playlists;
    property <length> gap: recent > 0 ? 17px : 0px;
    pure function row-y(index: int) -> length {
        return index * row-h + (index >= recent ? gap : 0px);
    }
    // The pointer: over the list, and how far down its content.
    property <length> px: App.drag-x - root.absolute-position.x;
    property <length> py: App.drag-y - list.absolute-position.y;
    property <bool> over: px >= 0 && px < root.width && py >= 0 && py < list.height;
    property <length> cy: py - list.content-y;
    property <int> hovered: !over ? -1
        : cy < recent * row-h ? floor(cy / row-h)
        : cy < recent * row-h + gap ? -1
        : recent + floor((cy - recent * row-h - gap) / row-h);
    property <int> target: hovered < rows ? hovered : -1;
    function publish() {
        if (target >= 0) {
            App.drop-target = App.own-playlists[target].id;
            App.drop-title = App.own-playlists[target].title;
            App.drop-source = "panel";
        } else if (App.drop-source == "panel") {
            App.drop-target = "";
            App.drop-title = "";
            App.drop-source = "";
        }
    }
    // A quick drag can already be over a row when the panel appears.
    init => { root.publish(); }
    changed target => { root.publish(); }

    // Near the top or bottom edge the list scrolls, faster the closer.
    property <length> edge: 64px;
    property <length> max-scroll: max(0px, list.content-height - list.height);
    property <float> pull: !over ? 0 : py < edge ? (edge - py) / edge : py > list.height - edge ? (list.height - edge - py) / edge : 0;
    Timer {
        interval: 16ms;
        running: root.pull != 0 && root.max-scroll > 0;
        triggered => {
            list.content-y = clamp(list.content-y + root.pull * 16px, -root.max-scroll, 0px);
        }
    }

    // The same place as the sidebar's "All playlists" heading, below the
    // traffic lights.
    Text {
        x: 24px;
        y: 64px + 24px;
        text: "Add to playlist";
        color: Theme.text-dim;
        font-size: 14px;
        font-weight: Theme.bold;
    }

    if rows == 0: Text {
        x: 24px;
        y: 64px + 54px + 12px;
        width: parent.width - 48px;
        text: "No playlists of your own yet";
        color: Theme.text-secondary;
        font-size: 14px;
        wrap: word-wrap;
    }

    list := Flickable {
        y: 64px + 54px;
        height: parent.height - self.y;
        content-height: root.row-y(root.rows) + 12px;
        interactive: false;
        if root.recent > 0: Rectangle {
            x: 24px;
            y: root.recent * root.row-h + 8px;
            width: parent.width - 48px;
            height: 1px;
            background: #ffffff1f;
        }
        for card[index] in App.own-playlists: row := Rectangle {
            property <bool> on: root.target == index;
            y: root.row-y(index);
            height: root.row-h;
            Rectangle {
                x: 10px;
                width: parent.width - 20px;
                border-radius: 8px;
                background: row.on ? #1c1c1c : transparent;
                border-width: row.on ? 1px : 0px;
                border-color: App.accent;
            }

            CardArt {
                x: 16px;
                width: 40px;
                height: 40px;
                card: card;
                radius: 3px;
            }

            VerticalLayout {
                x: 68px;
                width: parent.width - 72px - 16px;
                alignment: center;
                spacing: 2px;
                Text {
                    text: card.title;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 500;
                    overflow: elide;
                }

                Text {
                    text: row.on ? "Release to add" : card.subtitle;
                    color: row.on ? App.accent : Theme.text-secondary;
                    font-size: 13px;
                    overflow: elide;
                }
            }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: #141414;
    }
}

// The dragged track, beside the pointer. Under PlaylistDrop's playlists it
// says where the track would go.
export component DragChip inherits Rectangle {
    property <bool> aimed: App.drop-title != "";
    property <length> text-w: max(title.preferred-width, where.preferred-width);
    width: min(300px, 54px + self.text-w + 14px);
    height: 48px;
    border-radius: 10px;
    background: #2d2d2d;
    border-width: 1px;
    border-color: self.aimed ? App.accent : #ffffff1f;
    Cover {
        x: 6px;
        width: 36px;
        height: 36px;
        radius: 3px;
        source: App.drag-cover;
    }

    title := Text {
        x: 54px;
        y: 7px;
        width: parent.width - self.x - 14px;
        text: App.drag-title;
        color: Theme.text;
        font-size: 14px;
        font-weight: Theme.demibold;
        overflow: elide;
    }

    where := Text {
        x: 54px;
        y: 26px;
        width: parent.width - self.x - 14px;
        text: root.aimed ? "Add to " + App.drop-title : App.drag-artist;
        color: root.aimed ? App.accent : Theme.text-secondary;
        font-size: 12px;
        overflow: elide;
    }
}

// Dev panel under the computer button: chunk download grid, recent errors and
// the verbose log. A plain overlay, not a popup, so the rest of the window
// stays clickable. Scrolls when it is taller than the space below the top bar.
export component DebugPanel inherits Rectangle {
    in property <length> limit: 600px;
    // The window's width less the margins: narrower windows get a narrower panel.
    in property <length> room: 420px;
    width: min(420px, root.room);
    height: min(root.limit, panel-layout.preferred-height);
    clip: true;
    background: #141414;
    border-radius: 12px;
    border-width: 1px;
    border-color: #2a2a2a;
    // Clicks on the panel stay on the panel.
    TouchArea { }

    Flickable {
    content-height: panel-layout.preferred-height;
    panel-layout := VerticalLayout {
        padding: 14px;
        spacing: 8px;
        Text {
            text: "Debug · chunks · RAM";
            color: Theme.text;
            font-size: 13px;
            font-weight: 600;
        }

        Text {
            text: App.debug-title == "" ? "Nothing playing" : App.debug-title;
            color: Theme.text-secondary;
            font-size: 12px;
            overflow: elide;
        }

        Text {
            text: App.debug-status;
            color: App.debug-active ? #f5b942 : #3dd68c;
            font-size: 12px;
        }

        Text {
            text: App.debug-stats;
            color: Theme.text-secondary;
            font-size: 12px;
        }

        Rectangle {
            width: 100%;
            height: chunk-grid.height;
            chunk-grid := Rectangle {
                property <int> cols: 16;
                property <length> cell-w: 20px;
                property <length> cell-h: 16px;
                width: parent.width;
                height: max(cell-h, Math.ceil(max(App.debug-blocks.length, 1) * 1.0 / cols) * cell-h);
                for block[i] in App.debug-blocks: Rectangle {
                    x: Math.mod(i, chunk-grid.cols) * chunk-grid.cell-w;
                    y: Math.floor(i / chunk-grid.cols) * chunk-grid.cell-h;
                    width: chunk-grid.cell-w - 4px;
                    height: chunk-grid.cell-h - 4px;
                    border-radius: 2px;
                    background: block == 2 ? #3dd68c : block == 1 ? #f5b942 : #2c2c2c;
                }
            }
        }

        HorizontalLayout {
            spacing: 14px;
            VerticalLayout {
                alignment: center;
                Rectangle { width: 10px; height: 8px; border-radius: 2px; background: #2c2c2c; }
            }
            Text { text: "Queued"; color: Theme.text-secondary; font-size: 11px; vertical-alignment: center; }
            VerticalLayout {
                alignment: center;
                Rectangle { width: 10px; height: 8px; border-radius: 2px; background: #f5b942; }
            }
            Text { text: "Downloading"; color: Theme.text-secondary; font-size: 11px; vertical-alignment: center; }
            VerticalLayout {
                alignment: center;
                Rectangle { width: 10px; height: 8px; border-radius: 2px; background: #3dd68c; }
            }
            Text { text: "Received"; color: Theme.text-secondary; font-size: 11px; vertical-alignment: center; }
        }

        Rectangle {
            height: 1px;
            background: #2a2a2a;
        }

        HorizontalLayout {
            Text {
                text: "RAM";
                color: Theme.text;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                horizontal-stretch: 1;
                horizontal-alignment: right;
                text: App.mem-total == "" ? "Measuring…" : App.mem-total + "  ·  peak " + App.mem-peak;
                color: Theme.text-secondary;
                font-size: 11px;
                vertical-alignment: center;
            }
        }

        // Footprint split into coloured parts.
        mem-bar := Rectangle {
            height: 14px;
            border-radius: 4px;
            clip: true;
            background: #2c2c2c;
            for part[i] in App.mem-parts: Rectangle {
                property <float> before: i == 0 ? 0 : i == 1 ? App.mem-parts[0].frac : i == 2 ? App.mem-parts[0].frac + App.mem-parts[1].frac : i == 3 ? App.mem-parts[0].frac + App.mem-parts[1].frac + App.mem-parts[2].frac : App.mem-parts[0].frac + App.mem-parts[1].frac + App.mem-parts[2].frac + App.mem-parts[3].frac;
                x: mem-bar.width * self.before;
                width: max(0px, mem-bar.width * part.frac - (part.frac > 0.02 ? 1px : 0px));
                height: parent.height;
                background: part.color;
            }
        }

        // Legend: block, name, size, share.
        for part in App.mem-parts: HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Rectangle { width: 10px; height: 10px; border-radius: 2px; background: part.color; }
            }
            Text {
                horizontal-stretch: 1;
                text: part.label;
                color: Theme.text-secondary;
                font-size: 11px;
                overflow: elide;
                vertical-alignment: center;
            }
            Text {
                text: part.size;
                color: Theme.text;
                font-size: 11px;
                font-family: "Menlo";
                vertical-alignment: center;
            }
            Text {
                min-width: 34px;
                horizontal-alignment: right;
                text: Math.round(part.frac * 100) + "%";
                color: part.color;
                font-size: 11px;
                font-family: "Menlo";
                vertical-alignment: center;
            }
        }

        // Tracker: one stacked column per second, newest on the right.
        tracker := Rectangle {
            property <int> slots: 90;
            property <length> col-w: self.width / self.slots;
            property <float> scale: max(App.mem-scale, 1.0);
            height: 64px;
            border-radius: 4px;
            background: #0c0c0c;
            clip: true;
            for s[i] in App.mem-history: Rectangle {
                property <length> h-art: tracker.height * s.artwork / tracker.scale;
                property <length> h-snap: tracker.height * s.snapshots / tracker.scale;
                property <length> h-heap: tracker.height * s.heap / tracker.scale;
                property <length> h-win: tracker.height * s.window / tracker.scale;
                property <length> h-other: tracker.height * s.other / tracker.scale;
                x: (tracker.slots - App.mem-history.length + i) * tracker.col-w;
                y: 0;
                width: max(1px, tracker.col-w - 1px);
                height: tracker.height;
                if App.mem-parts.length == 5: Rectangle {
                    y: parent.height - h-art;
                    height: h-art;
                    background: App.mem-parts[0].color;
                }
                if App.mem-parts.length == 5: Rectangle {
                    y: parent.height - h-art - h-snap;
                    height: h-snap;
                    background: App.mem-parts[1].color;
                }
                if App.mem-parts.length == 5: Rectangle {
                    y: parent.height - h-art - h-snap - h-heap;
                    height: h-heap;
                    background: App.mem-parts[2].color;
                }
                if App.mem-parts.length == 5: Rectangle {
                    y: parent.height - h-art - h-snap - h-heap - h-win;
                    height: h-win;
                    background: App.mem-parts[3].color;
                }
                if App.mem-parts.length == 5: Rectangle {
                    y: parent.height - h-art - h-snap - h-heap - h-win - h-other;
                    height: h-other;
                    background: App.mem-parts[4].color;
                }
            }
            Text {
                x: 4px;
                y: 2px;
                text: Math.round(tracker.scale) + " MB";
                color: Theme.text-dim;
                font-size: 9px;
                font-family: "Menlo";
            }
        }

        if App.mem-note != "": Text {
            text: App.mem-note;
            color: Theme.text-dim;
            font-size: 10px;
            wrap: word-wrap;
        }

        if App.debug-errors.length > 0: Rectangle {
            height: 1px;
            background: #2a2a2a;
        }

        if App.debug-errors.length > 0: Text {
            text: "Recent errors";
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
        }

        for entry in App.debug-errors: VerticalLayout {
            spacing: 2px;
            Text {
                text: entry.time + " · " + entry.source;
                color: Theme.text-secondary;
                font-size: 11px;
                overflow: elide;
            }

            Text {
                text: entry.message;
                color: #ff7a7a;
                font-size: 12px;
                wrap: word-wrap;
                overflow: elide;
                max-height: 48px;
            }

            if entry.fields != "": Text {
                text: entry.fields;
                color: Theme.text-secondary;
                font-size: 11px;
                overflow: elide;
            }
        }

        Rectangle {
            height: 1px;
            background: #2a2a2a;
        }

        Text {
            text: "Log";
            color: Theme.text;
            font-size: 12px;
            font-weight: 600;
        }

        if App.debug-logs.length == 0: Text {
            text: "Nothing logged yet";
            color: Theme.text-secondary;
            font-size: 11px;
        }
        VerticalLayout {
            spacing: 3px;
            for line in App.debug-logs: Text {
                text: line.time + "  " + line.level + "  " + line.text;
                color: line.level == "ERROR" ? #ff7a7a : line.level == "WARN" ? #f5b942 : line.level == "DEBUG" ? #7c7c7c : #b8b8b8;
                font-family: "Menlo";
                font-size: 10px;
                wrap: word-wrap;
            }
        }
    }
    }
}

// Asks for the name of a new playlist or folder, or confirms deleting one or
// making a playlist public.
export component CreateDialog inherits Rectangle {
    property <bool> removing-playlist: App.create-kind == "delete-playlist";
    property <bool> publishing: App.create-kind == "publish-playlist";
    // Nothing to type: a question with Cancel and one way forward.
    property <bool> removing: App.create-kind == "delete-folder" || removing-playlist || publishing;
    property <bool> renaming: App.create-kind == "rename-folder";
    // Phone width: the public notice takes three lines.
    property <length> extra: root.publishing && root.width < 480px ? 22px : 0px;
    background: #000000b0;
    // Clicking outside the card cancels.
    TouchArea {
        clicked => {
            App.create-kind = "";
        }
    }

    function submit() {
        if (root.removing) {
            App.create-in-collection(App.create-kind, App.create-name);
            App.create-kind = "";
            return;
        }
        if (name.text != "") {
            App.create-in-collection(App.create-kind, name.text);
            App.create-kind = "";
        }
    }

    Rectangle {
        width: min(420px, root.width - 32px);
        height: (root.publishing ? 200px : root.removing ? 180px : 214px) + root.extra;
        border-radius: 14px;
        background: #1c1c1c;
        border-width: 1px;
        border-color: #2a2a2a;
        TouchArea { }

        Text {
            x: 24px;
            y: 22px;
            text: root.publishing ? "Make it public" : root.removing-playlist ? "Delete playlist" : root.removing ? "Delete folder" : root.renaming ? "Rename folder" : App.create-kind == "folder" ? "Create folder" : "Create playlist";
            color: Theme.text;
            font-size: 20px;
            font-weight: Theme.bold;
        }

        if removing: Text {
            x: 24px;
            y: 70px;
            width: parent.width - 48px;
            text: root.publishing ? "Your playlist will be visible on your Profile and accessible by anyone." : "“" + App.create-name + "”";
            color: Theme.text-secondary;
            font-size: 15px;
            wrap: root.publishing ? word-wrap : no-wrap;
            overflow: elide;
        }

        Rectangle {
            x: 24px;
            y: 70px;
            width: parent.width - 48px;
            height: 44px;
            border-radius: 8px;
            border-width: 1px;
            border-color: name.has-focus ? #4a4a4a : Theme.border;
            visible: !root.removing;
            if name.text == "": Text {
                x: 14px;
                text: App.create-kind == "folder" || root.renaming ? "Folder name" : "Playlist name";
                color: #aeafb2;
                font-size: 15px;
                vertical-alignment: center;
            }
            name := EditableInput {
                x: 14px;
                width: parent.width - 28px;
                height: 20px;
                color: Theme.text;
                font-size: 15px;
                single-line: true;
                vertical-alignment: center;
                selection-background-color: #4a4a4a;
                accepted => {
                    root.submit();
                }
            }
        }

        Rectangle {
            x: parent.width - 24px - 110px - 12px - 110px;
            y: (root.publishing ? 132px : root.removing ? 112px : 146px) + root.extra;
            width: 110px;
            height: 44px;
            border-radius: 22px;
            background: cancel.has-hover ? #2a2a2a : #222222;
            cancel := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    App.create-kind = "";
                }
            }

            Text {
                text: "Cancel";
                color: Theme.text;
                font-size: 15px;
                font-weight: Theme.demibold;
            }
        }

        Rectangle {
            x: parent.width - 24px - 110px;
            y: (root.publishing ? 132px : root.removing ? 112px : 146px) + root.extra;
            width: 110px;
            height: 44px;
            border-radius: 22px;
            background: !root.removing && name.text == "" ? #5a5a5a : create.has-hover ? #e6e6e6 : white;
            create := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.submit();
                }
            }

            Text {
                text: root.publishing ? "Confirm" : root.removing ? "Delete" : root.renaming ? "Rename" : "Create";
                color: black;
                font-size: 15px;
                font-weight: Theme.demibold;
            }
        }
    }

    init => {
        if (root.renaming) {
            name.text = App.create-name;
            name.select-all();
        }
        if (!root.removing) {
            name.focus();
        }
    }
}


// Title, description and sharing of one of the user's own playlists.
export component EditPlaylistDialog inherits Rectangle {
    property <bool> public: App.edit-public;
    property <int> typed: description.text.character-count;
    property <bool> valid: name.text != "" && typed <= 500;
    // Phone width: a small cover beside the title, the description under both.
    property <bool> narrow: root.width < 560px;
    property <length> cover: root.narrow ? 72px : 150px;
    property <length> field-x: 28px + root.cover + (root.narrow ? 16px : 24px);
    property <length> notes-x: root.narrow ? 28px : root.field-x;
    background: #000000b0;
    // Clicking outside the card cancels.
    TouchArea {
        clicked => {
            App.create-kind = "";
        }
    }

    function submit() {
        if (root.valid) {
            App.save-playlist(name.text, description.text, root.public);
            App.create-kind = "";
        }
    }

    Rectangle {
        width: min(640px, root.width - 32px);
        height: 552px;
        border-radius: 14px;
        background: #1c1c1c;
        border-width: 1px;
        border-color: #2a2a2a;
        TouchArea { }

        Text {
            x: 28px;
            y: 24px;
            text: "Edit playlist";
            color: Theme.text;
            font-size: 20px;
            font-weight: Theme.bold;
        }

        IconButton {
            x: parent.width - self.width - 16px;
            y: 18px;
            icon: @image-url("icons/x.svg");
            clicked => {
                App.create-kind = "";
            }
        }

        Cover {
            x: 28px;
            y: 76px;
            width: root.cover;
            height: root.cover;
            source: App.edit-cover;
            radius: 3px;
        }

        Rectangle {
            x: root.field-x;
            y: 76px;
            width: parent.width - self.x - 28px;
            height: 70px;
            border-radius: 10px;
            border-width: 1px;
            border-color: name.has-focus ? #4a4a4a : Theme.border;
            Text {
                x: 16px;
                y: 12px;
                text: "Title";
                color: Theme.text;
                font-size: 15px;
                font-weight: Theme.bold;
            }

            name := EditableInput {
                x: 16px;
                y: 38px;
                width: parent.width - 32px;
                height: 20px;
                color: Theme.text-secondary;
                font-size: 15px;
                single-line: true;
                vertical-alignment: center;
                selection-background-color: #4a4a4a;
                accepted => {
                    root.submit();
                }
            }
        }

        Rectangle {
            x: root.notes-x;
            y: root.narrow ? 164px : 158px;
            width: parent.width - self.x - 28px;
            height: root.narrow ? 180px : 200px;
            border-radius: 10px;
            border-width: 1px;
            border-color: description.has-focus ? #4a4a4a : Theme.border;
            clip: true;
            if description.text == "": Text {
                x: 16px;
                y: 14px;
                text: "Write a description";
                color: #aeafb2;
                font-size: 15px;
                font-weight: Theme.demibold;
            }
            description := EditableInput {
                x: 16px;
                y: 14px;
                width: parent.width - 32px;
                height: parent.height - 28px;
                color: Theme.text;
                font-size: 14px;
                single-line: false;
                wrap: word-wrap;
                selection-background-color: #4a4a4a;
            }
        }

        Text {
            x: root.notes-x + 6px;
            y: root.narrow ? 352px : 366px;
            text: root.typed + "/500 characters";
            color: root.typed > 500 ? #ff6b6b : Theme.text-secondary;
            font-size: 12px;
            font-weight: Theme.medium;
        }

        Rectangle {
            x: 28px;
            y: 396px;
            width: parent.width - 56px;
            height: 76px;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.border;
            Text {
                x: 18px;
                y: 16px;
                text: "Make it public";
                color: Theme.text;
                font-size: 16px;
                font-weight: Theme.bold;
            }

            Text {
                x: 18px;
                y: root.narrow ? 38px : 42px;
                width: parent.width - 36px - 62px;
                height: root.narrow ? 34px : self.preferred-height;
                text: "Your playlist will be visible on your Profile and accessible by anyone.";
                color: Theme.text-secondary;
                font-size: root.narrow ? 12px : 13px;
                wrap: root.narrow ? word-wrap : no-wrap;
                overflow: elide;
            }

            Toggle {
                x: parent.width - self.width - 18px;
                on: root.public;
                toggled(on) => {
                    root.public = on;
                }
            }
        }

        Rectangle {
            x: parent.width - 28px - 110px;
            y: 488px;
            width: 110px;
            height: 44px;
            border-radius: 22px;
            background: !root.valid ? #5a5a5a : save.has-hover ? #e6e6e6 : white;
            save := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.submit();
                }
            }

            Text {
                text: "Save";
                color: black;
                font-size: 15px;
                font-weight: Theme.demibold;
            }
        }
    }

    init => {
        name.text = App.create-name;
        description.text = App.edit-description;
        // The cursor goes after the title (the offsets are clamped to its end).
        name.set-selection-offsets(100000, 100000);
        name.focus();
    }
}

// The single error alert. Shows `App.alert-text`; a new error replaces it.
export component ErrorAlert inherits Rectangle {
    width: 520px;
    height: alert-layout.preferred-height;
    background: App.alert-error ? #2a1416 : #1c1c1c;
    border-radius: 10px;
    border-width: 1px;
    border-color: App.alert-error ? #6b2a2e : #3a3a3a;
    TouchArea { }

    alert-layout := HorizontalLayout {
        padding-left: 14px;
        padding-right: 4px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 8px;
        Text {
            text: App.alert-text;
            color: App.alert-error ? #ffb4b4 : Theme.text;
            font-size: 13px;
            wrap: word-wrap;
            overflow: elide;
            max-height: 52px;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("icons/x.svg");
                size: 13px;
                tint: App.alert-error ? #ffb4b4 : Theme.text-secondary;
                clicked => {
                    App.alert-text = "";
                }
            }
        }
    }
}

// A small rounded button for the update toast.
component ToastButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    callback clicked();
    height: 28px;
    border-radius: 14px;
    background: primary ? (ta.has-hover ? #e6e6e6 : white) : (ta.has-hover ? #333333 : #2a2a2a);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text {
            text: root.text;
            color: root.primary ? black : Theme.text;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
        }
    }
}

// The update toast: a newer release, its download, or why it failed. Grey like
// a confirmation notice, but it stays until answered.
export component UpdateToast inherits Rectangle {
    width: 520px;
    height: 60px;
    background: #1c1c1c;
    border-radius: 10px;
    border-width: 1px;
    border-color: #3a3a3a;
    TouchArea { }

    property <string> state: App.update-state;
    property <bool> busy: state == "downloading" || state == "installing";

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 4px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: state == "downloading" ? "Downloading TIDE " + App.update-to + "…"
                    : state == "installing" ? "Installing TIDE " + App.update-to + "…"
                    : state == "failed" ? "Could not update TIDE"
                    : "New version of TIDE";
                color: Theme.text;
                font-size: 13px;
                font-weight: 600;
                overflow: elide;
            }

            if state == "available": Text {
                text: App.update-from + "  →  " + App.update-to;
                color: Theme.text-secondary;
                font-size: 12px;
            }
            if state == "failed": Text {
                text: App.update-error;
                color: Theme.text-secondary;
                font-size: 12px;
                overflow: elide;
            }
            if root.busy: Rectangle {
                height: 4px;
                border-radius: 2px;
                background: #333333;
                Rectangle {
                    x: 0;
                    width: parent.width * (root.state == "installing" ? 1.0 : App.update-progress);
                    height: parent.height;
                    border-radius: parent.border-radius;
                    background: Theme.lossless;
                    animate width { duration: 150ms; }
                }
            }
        }

        if state == "available": VerticalLayout {
            alignment: center;
            ToastButton {
                // Phone width: the title keeps room beside the buttons.
                text: root.width < 440px ? "Skip" : "Skip this version";
                clicked => { App.update-skip(); }
            }
        }
        if state == "available": VerticalLayout {
            alignment: center;
            ToastButton {
                text: "Update now";
                primary: true;
                clicked => { App.update-now(); }
            }
        }
        if state == "failed": VerticalLayout {
            alignment: center;
            ToastButton {
                text: "Download page";
                clicked => { App.open-update-page(); }
            }
        }
        if state == "failed": VerticalLayout {
            alignment: center;
            ToastButton {
                text: "Try again";
                primary: true;
                clicked => { App.update-now(); }
            }
        }
        if state == "downloading": Text {
            text: Math.round(App.update-progress * 100) + "%";
            color: Theme.text-secondary;
            font-size: 12px;
            vertical-alignment: center;
        }

        VerticalLayout {
            alignment: center;
            IconButton {
                icon: @image-url("icons/x.svg");
                size: 13px;
                enabled: !root.busy;
                opacity: root.busy ? 0 : 1;
                clicked => { App.update-dismiss(); }
            }
        }
    }
}

// The search pill: the top bar's, and in phone layout a full-width row on
// Explore and the search results. ⌘F (App.focus-search) focuses whichever
// one is active, also one that appears after the shortcut.
export component SearchField inherits Rectangle {
    in property <bool> active: true;
    out property <bool> focused: input.has-focus;
    out property <bool> hovered: search-ta.has-hover;
    callback activity();
    height: 39px;
    border-radius: 19.5px;
    background: Theme.pill;
    border-width: input.has-focus ? 1px : 0px;
    border-color: #5a5a5a;

    // Focus ring sits just outside the pill.
    if input.has-focus: Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 22.5px;
        border-width: 1.5px;
        border-color: #ffffff;
    }
    search-ta := TouchArea {
        enabled: root.active;
        clicked => { input.focus(); root.activity(); }
        changed mouse-x => { root.activity(); }
        changed mouse-y => { root.activity(); }
    }
    Icon {
        x: 14px;
        y: (parent.height - self.height) / 2;
        source: @image-url("icons/search.svg");
        size: 15px;
        tint: Theme.text-secondary;
    }

    if input.text == "": Text {
        x: 48px;
        y: 0px;
        height: parent.height;
        text: "Search";
        color: Theme.text-secondary;
        font-size: 15px;
        vertical-alignment: center;
    }
    input := EditableInput {
        enabled: root.active;
        x: 48px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 48px - (self.text == "" ? 58px : 40px);
        height: 20px;
        text <=> App.search-text;
        color: Theme.text;
        font-size: 15px;
        single-line: true;
        vertical-alignment: center;
        // On macOS the caret is the selection colour, not the text colour.
        selection-background-color: #ffffff;
        selection-foreground-color: #111111;
        accepted => {
            App.search(self.text);
        }
    }

    property <bool> input-focused: input.has-focus;
    changed input-focused => { App.search-focused = self.input-focused; }
    property <int> focus-request: App.focus-search;
    changed focus-request => { root.take-focus(); }
    init => { root.take-focus(); }
    function take-focus() {
        if (root.active && App.focus-search != App.focus-search-seen) {
            App.focus-search-seen = App.focus-search;
            input.focus();
            input.select-all();
            root.activity();
        }
    }

    if input.text == "": HorizontalLayout {
        x: parent.width - self.preferred-width - 10px;
        y: (parent.height - 20px) / 2;
        height: 20px;
        spacing: 4px;
        Kbd { glyph: "⌘"; }
        Kbd { glyph: "F"; }
    }

    if input.text != "": IconButton {
        x: parent.width - 40px;
        y: (parent.height - self.height) / 2;
        icon: @image-url("icons/x.svg");
        size: 15px;
        tint: Theme.text;
        clicked => {
            App.search-text = "";
            input.focus();
        }
    }
}

// Shared by the page header and full-window video player.
export component HeaderTools inherits Rectangle {
    in property <bool> active: true;
    // Off where there is no room for the search field (narrow Now Playing,
    // whose width is then just the debug and profile buttons: 101px).
    in property <bool> search: true;
    out property <bool> engaged: field.focused || menu.is-open || field.hovered || debug-btn.hovered || pta.has-hover;
    callback activity();
    width: 407px;
    height: 64px;

    // Search. Right edge sits left of the debug circle.
    field := SearchField {
        visible: root.search;
        active: root.active && root.search;
        x: parent.width - 101px - self.width;
        y: (parent.height - self.height) / 2;
        width: parent.width - 101px;
        activity => { root.activity(); }
    }

    // Dev chunk monitor
    debug-btn := DebugButton {
        x: parent.width - 56px - self.width;
        y: (parent.height - self.height) / 2;
        enabled: root.active;
    }

    // Profile
    profile := Rectangle {
        x: parent.width - 13px - self.width;
        y: (parent.height - self.height) / 2;
        width: 35px;
        height: 35px;
        border-radius: 17.5px;
        background: pta.has-hover ? #333333 : #2a2a2a;
        pta := TouchArea {
            enabled: root.active;
            mouse-cursor: pointer;
            clicked => {
                menu.show();
            }
        }

        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            source: @image-url("icons/user.svg");
            size: 18px;
        }
    }

    menu := PopupWindow {
        x: root.width - 13px - 230px;
        y: 58px;
        width: 230px;
        Rectangle {
            background: #1c1c1c;
            border-radius: 10px;
            border-width: 1px;
            border-color: #2a2a2a;
            VerticalLayout {
                padding: 8px;
                Rectangle {
                    height: 44px;
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: App.username;
                        color: Theme.text-secondary;
                        font-size: 13px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: sta.has-hover ? #2a2a2a : transparent;
                    sta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            menu.close();
                            App.navigate("settings");
                        }
                    }

                    Text {
                        x: 10px;
                        text: "Settings";
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Text {
                        x: parent.width - self.width - 10px;
                        text: "⌘,";
                        color: Theme.text-secondary;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: lta.has-hover ? #2a2a2a : transparent;
                    lta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            menu.close();
                            App.logout();
                        }
                    }

                    Text {
                        x: 10px;
                        text: "Log out";
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

export component TopBar inherits Rectangle {
    height: 64px;
    // Phone layout has no sidebar: the bar starts right of the traffic lights
    // and the search moves into the pages (Explore and the results).
    property <length> shift: App.phone-layout ? 60px : 0px;
    DragArea { }

    // Back / forward
    Rectangle {
        x: 18px + root.shift;
        y: 13px;
        width: 76px;
        height: 39px;
        border-radius: 19.5px;
        background: Theme.pill;
        // Chevron size, weight, spacing and colours measured from the official client.
        HorizontalLayout {
            alignment: center;
            IconButton {
                width: 38px;
                height: 39px;
                icon: @image-url("icons/nav-back.svg");
                size: 24px;
                enabled: App.can-go-back;
                tint: #f0f0f0;
                disabled-tint: #404040;
                clicked => {
                    App.back();
                }
            }

            IconButton {
                width: 38px;
                height: 39px;
                icon: @image-url("icons/nav-forward.svg");
                size: 24px;
                enabled: App.can-go-forward;
                tint: #f0f0f0;
                disabled-tint: #404040;
                clicked => {
                    App.forward();
                }
            }
        }
    }

    // Divider, then the tide mark: still while the page is current, filling
    // with water while a page shown from cache is checked against the server.
    Rectangle {
        x: 106px + root.shift;
        y: 23px;
        width: 1px;
        height: 19px;
        background: #2c2c2c;
    }

    Rectangle {
        x: 117px + root.shift;
        y: 13px;
        width: 36px;
        height: 39px;
        accessible-role: text;
        accessible-label: App.syncing ? "Checking for updates" : "Up to date";
        Image {
            width: 26px;
            height: 26px * 367 / 601;
            source: @image-url("icons/wave.svg");
            colorize: #5a5a5a;
            image-fit: fill;
        }
        if App.syncing: TideLoader {
            size: 26px;
            tint: #d8d8d8;
            init => {
                self.epoch = animation-tick();
            }
        }
    }

    HeaderTools {
        width: App.phone-layout ? 101px : min(407px, parent.width - 165px);
        x: parent.width - self.width;
        search: !App.phone-layout;
        active: !App.video-open && !App.show-now-playing;
    }
}

// Inset "LCD" pill, as in the official client: black rim, a highlight under the
// lower edge, and a glow in the quality colour rising from the bottom centre.
component QualityPill inherits Rectangle {
    callback clicked();
    property <color> tone: App.video-active ? Theme.text : App.quality-tier == "lossless" ? #19d8a7 : App.accent;
    property <color> top: root.tone.mix(#141818, 0.04);
    width: 133px;
    height: 45px;
    Rectangle {
        y: 1px;
        height: 44px;
        border-radius: 22px;
        background: #383838;
    }

    Rectangle {
        y: 0px;
        height: 44px;
        border-radius: 22px;
        background: black;
        Rectangle {
            x: 1.5px;
            y: 1.5px;
            width: parent.width - 3px;
            height: parent.height - 3px;
            border-radius: self.height / 2;
            background: #0c1010;
            clip: true;
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: parent.height * 0.75 - self.height / 2;
                width: 150px;
                height: 150px;
                background: @radial-gradient(circle, root.tone.mix(#0c1010, 0.2) 0%, #0c101000 50%);
            }

            Rectangle {
                background: @linear-gradient(180deg, root.top 0%, root.top.with-alpha(0) 60%);
            }
        }
    }

    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }

    HorizontalLayout {
        y: 0px;
        height: 44px;
        alignment: center;
        spacing: 5px;
        // Signal-path indicator: gold = bit-perfect hi-res, cyan = bit-perfect lossless, green = processed, white = lossy.
        if App.signal-quality != "": VerticalLayout {
            alignment: center;
            Icon {
                source: @image-url("icons/sparkle.svg");
                size: 10px;
                tint: App.signal-color(App.signal-quality);
            }
        }
        Text {
            text: App.video-active ? (App.video-quality-label != "" ? App.video-quality-label : App.video-quality == "Auto" ? "AUTO" : App.video-quality) : App.quality-label;
            color: root.tone;
            font-size: 13px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

component SignalPathPanel inherits Rectangle {
    // Video mode: the rendition picker as a column on the left.
    in property <bool> show-quality: false;
    in property <bool> show-signal: true;
    callback quality-picked();
    background: #141416;
    border-radius: 14px;
    border-width: 1px;
    border-color: #2a2a2e;
    HorizontalLayout {
        if root.show-quality: VerticalLayout {
            width: 200px;
            padding: 12px;
            padding-top: 16px;
            spacing: 0px;
            // Sits on the card's bottom edge, next to the player bar's pill.
            alignment: end;
            Rectangle {
                height: 34px;
                Text {
                    x: 12px;
                    text: "QUALITY";
                    color: Theme.text-secondary;
                    font-size: 11px;
                    font-weight: Theme.demibold;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }

            if App.video-qualities.length == 0: Rectangle {
                height: 40px;
                Text {
                    x: 12px;
                    text: "Loading…";
                    color: Theme.text-secondary;
                    font-size: 14px;
                    vertical-alignment: center;
                }
            }
            for choice in App.video-qualities: Rectangle {
                height: 40px;
                border-radius: 8px;
                background: row-ta.has-hover ? #2a2a2a : transparent;
                row-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        App.set-video-quality(choice);
                        root.quality-picked();
                    }
                }

                Text {
                    x: 12px;
                    text: choice == "Auto" && App.video-quality-label != "" ? "Auto (" + App.video-quality-label + ")" : choice;
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: choice == App.video-quality ? Theme.demibold : Theme.regular;
                    vertical-alignment: center;
                }

                if choice == App.video-quality: Icon {
                    x: parent.width - 12px - self.width;
                    source: @image-url("icons/check.svg");
                    size: 16px;
                    tint: Theme.text;
                }
            }
        }

        if root.show-quality && root.show-signal: Rectangle {
            width: 1px;
            background: #2a2a2e;
        }

        if root.show-signal: VerticalLayout {
            padding: 20px;
            spacing: 14px;
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Text {
                    text: "Signal path:";
                    color: Theme.text;
                    font-size: 17px;
                    font-weight: 700;
                    vertical-alignment: center;
                }

                // Centred like the sparkle: the row can be taller than the text.
                Text {
                    text: App.signal-title;
                    color: App.signal-color(App.signal-quality);
                    font-size: 17px;
                    font-weight: 500;
                    vertical-alignment: center;
                }

                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: @image-url("icons/sparkle.svg");
                        size: 13px;
                        tint: App.signal-color(App.signal-quality);
                    }
                }
            }

            VerticalLayout {
                spacing: 0px;
                for stage[i] in App.signal-stages: Rectangle {
                    height: 58px;
                    // Connector to the next stage
                    if i + 1 < App.signal-stages.length: Rectangle {
                        x: 16px;
                        y: 40px;
                        width: 1px;
                        height: 26px;
                        background: #4a4a50;
                    }
                    Rectangle {
                        x: 0px;
                        y: 6px;
                        width: 34px;
                        height: 34px;
                        border-radius: 17px;
                        border-width: 1px;
                        border-color: #6a6a70;
                        Icon {
                            source: stage.kind == "video" ? @image-url("icons/video.svg") : stage.kind == "source" ? @image-url("icons/music.svg") : stage.kind == "output" ? @image-url("icons/volume.svg") : @image-url("icons/sort.svg");
                            size: 16px;
                        }
                    }

                    HorizontalLayout {
                        x: 48px;
                        y: 3px;
                        height: 20px;
                        width: self.preferred-width;
                        spacing: 7px;
                        Text {
                            text: stage.title;
                            color: Theme.text;
                            font-size: 14px;
                            font-weight: 600;
                            vertical-alignment: center;
                        }

                        VerticalLayout {
                            alignment: center;
                            Icon {
                                source: @image-url("icons/sparkle.svg");
                                size: 10px;
                                tint: App.signal-color(stage.quality);
                            }
                        }
                    }

                    Text {
                        x: 48px;
                        y: 25px;
                        width: parent.width - 48px;
                        text: stage.detail;
                        color: App.signal-color(stage.quality);
                        font-size: 14px;
                        overflow: elide;
                    }
                }
            }

            Text {
                text: App.signal-note;
                color: Theme.text-secondary;
                font-size: 12.5px;
                wrap: word-wrap;
            }

            Rectangle {
                height: 1px;
                background: #2a2a2e;
            }

            HorizontalLayout {
                alignment: space-between;
                spacing: 12px;
                Text {
                    text: "DSP";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                VerticalLayout {
                    alignment: center;
                    Toggle {
                        on: App.dsp-enabled;
                        toggled(v) => { App.dsp-set-enabled(v); }
                    }
                }
            }

            HorizontalLayout {
                alignment: space-between;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: "Bit-perfect playback";
                        color: Theme.text;
                        font-size: 14px;
                        font-weight: 600;
                    }

                    Text {
                        text: "Match output sample rate and bit depth";
                        color: Theme.text-secondary;
                        font-size: 12px;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Toggle {
                        on: App.rate-matching;
                        toggled(v) => {
                            App.set-rate-matching(v);
                        }
                    }
                }
            }
        }
    }
}

// Player-bar label: underlines on hover, and (optionally) pops a tooltip after a short pause.
component PlayerLink inherits Rectangle {
    in property <string> text;
    in property <string> tip;
    in property <color> text-color: Theme.text-secondary;
    in property <length> font-size: 13px;
    in property <int> font-weight: 400;
    in property <length> max-w: 200px;
    in property <bool> clickable: false;
    // The label is the playing track's name: it can be dragged to a playlist.
    in property <bool> drags-track: false;
    callback clicked();
    callback context-requested(length, length);
    out property <bool> hovered: ta.has-hover;
    property <bool> armed: false;
    width: min(probe.preferred-width, root.max-w);
    height: probe.preferred-height;
    probe := Text {
        visible: false;
        text: root.text;
        font-size: root.font-size;
        font-weight: root.font-weight;
    }

    Text {
        width: parent.width;
        text: root.text;
        color: ta.has-hover ? Theme.text : root.text-color;
        font-size: root.font-size;
        font-weight: root.font-weight;
        overflow: elide;
    }

    if ta.has-hover: Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.text;
    }
    Timer {
        interval: 350ms;
        running: root.tip != "" && ta.has-hover && !root.armed;
        triggered => {
            root.armed = true;
        }
    }

    ta := TouchArea {
        mouse-cursor: App.drag-active ? grabbing : root.clickable ? pointer : default;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context-requested(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                App.drag-release(true);
            }
            if (e.kind == PointerEventKind.cancel) {
                App.drag-release(false);
            }
        }
        moved => {
            if (root.drags-track && self.pressed) {
                App.drag-move(App.current-id, App.np-title, App.np-artist, App.np-cover, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        clicked => {
            // The release that ends a drag is not a click.
            if (!App.drag-gesture) {
                root.clicked();
            }
        }
        changed has-hover => {
            if !self.has-hover {
                root.armed = false;
            }
        }
    }

    if root.armed && ta.has-hover && !App.drag-active: HoverTip {
        x: (parent.width - self.width) / 2;
        y: -(self.height + 8px);
        text: root.tip;
    }
}

component ArtistCard inherits Rectangle {
    callback read-more();
    out property <bool> hovered: card-ta.has-hover || more-ta.has-hover || follow-ta.has-hover;
    width: 350px;
    height: 338px;
    background: #181818;
    border-radius: 12px;
    border-width: 1px;
    border-color: #2a2a2a;
    clip: true;
    Image {
        width: 100%;
        height: 200px;
        source: App.np-artist-image;
        image-fit: cover;
        opacity: App.np-artist-image.width > 0 ? 1.0 : 0.0;
        animate opacity {
            duration: 200ms;
        }
    }

    Rectangle {
        y: 100px;
        height: 100px;
        background: @linear-gradient(180deg, #18181800 0%, #181818 100%);
    }

    Text {
        x: 20px;
        y: 166px;
        width: parent.width - 40px;
        text: App.np-artist-name;
        color: Theme.text;
        font-size: 20px;
        font-weight: 700;
        overflow: elide;
    }

    Text {
        x: 20px;
        y: 208px;
        width: parent.width - 40px;
        height: 60px;
        text: App.np-artist-bio;
        color: #9a9a9a;
        font-size: 13px;
        wrap: word-wrap;
    }

    card-ta := TouchArea { }

    Rectangle {
        x: 20px;
        y: 282px;
        width: follow-label.preferred-width + 40px;
        height: 40px;
        border-radius: 20px;
        background: follow-ta.has-hover ? #2e2e2e : #222222;
        border-width: App.np-artist-followed ? 0px : 1px;
        border-color: #3a3a3a;
        follow-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                App.toggle-follow-artist();
            }
        }

        follow-label := Text {
            text: App.np-artist-followed ? "Following" : "Follow";
            color: Theme.text;
            font-size: 14px;
            font-weight: 500;
        }
    }

    Rectangle {
        x: 20px + follow-label.preferred-width + 40px + 8px;
        y: 282px;
        width: 112px;
        height: 40px;
        border-radius: 20px;
        background: more-ta.has-hover ? #2e2e2e : #222222;
        more-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                root.read-more();
            }
        }

        Text {
            text: "Read more";
            color: Theme.text;
            font-size: 14px;
            font-weight: 500;
        }
    }
}

// TIDAL-style playback scrubber: thin muted hairline when idle; expands on hover/drag
// with a cursor preview shade, quality-accent fill + thumb, live scrubbed timestamp,
// and clickable total / remaining duration toggle.
component Scrubber inherits Rectangle {
    in property <length> bar-w;
    callback seek(float);

    property <bool> active: App.has-track && (ta.has-hover || ta.pressed);
    property <float> drag: 0.0;
    property <float> hover-frac: 0.0;
    property <float> shown: ta.pressed ? root.drag : clamp(App.progress, 0.0, 1.0);
    property <int> shown-secs: Math.round(root.shown * App.duration-secs);
    property <length> track-h: root.active ? 4px : 2px;

    height: 20px;

    // Left timestamp: live scrubbed time in accent while dragging, elapsed otherwise.
    Text {
        x: (root.width - root.bar-w) / 2 - 14px - self.width;
        y: (parent.height - self.height) / 2;
        text: ta.pressed && App.duration-secs > 0 ? App.format-time(root.shown-secs) : App.elapsed;
        color: ta.pressed ? App.accent : root.active ? Theme.text : #6e6e6e;
        font-size: 12px;
        vertical-alignment: center;
        animate color { duration: 120ms; }
    }

    // Track & interactive scrub bar
    bar-area := Rectangle {
        x: (root.width - root.bar-w) / 2;
        y: 0px;
        width: root.bar-w;
        height: parent.height;

        ta := TouchArea {
            enabled: App.has-track;
            mouse-cursor: App.has-track ? pointer : default;
            pointer-event(e) => {
                if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                    root.drag = clamp(self.mouse-x / self.width, 0.0, 1.0);
                    root.hover-frac = root.drag;
                } else if e.button == PointerEventButton.left && e.kind == PointerEventKind.up {
                    root.seek(root.drag);
                }
            }
            moved => {
                root.hover-frac = clamp(self.mouse-x / self.width, 0.0, 1.0);
                if self.pressed {
                    root.drag = root.hover-frac;
                }
            }
        }

        // Base track
        Rectangle {
            y: (parent.height - self.height) / 2;
            width: parent.width;
            height: root.track-h;
            border-radius: self.height / 2;
            background: root.active ? #383838 : #2e2e2e;
            clip: true;
            animate height, background { duration: 120ms; }

            // Hover-position preview shade under cursor
            if ta.has-hover && App.has-track: Rectangle {
                x: 0px;
                width: parent.width * root.hover-frac;
                height: parent.height;
                border-radius: parent.border-radius;
                background: #ffffff24;
            }

            // Downloaded / buffered range: a dimmer white that glides forward
            // as chunks land, behind the played fill.
            if App.has-track: Rectangle {
                x: 0px;
                width: parent.width * clamp(App.loaded, 0.0, 1.0);
                height: parent.height;
                border-radius: parent.border-radius;
                background: root.active ? #ffffff40 : #ffffff2e;
                animate width { duration: 450ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
                animate background { duration: 120ms; }
            }

            // Played / scrubbed progress fill
            Rectangle {
                x: 0px;
                width: parent.width * root.shown;
                height: parent.height;
                border-radius: parent.border-radius;
                background: root.active ? App.accent : #b3b3b3;
                animate background { duration: 120ms; }
            }
        }

        // Circular scrubber thumb
        Rectangle {
            x: clamp(parent.width * root.shown - self.width / 2, 0px, max(0px, parent.width - self.width));
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 12px;
            border-radius: 6px;
            background: App.accent;
            opacity: root.active ? 1.0 : 0.0;
            animate opacity { duration: 120ms; }
        }
    }

    // Right timestamp: click to toggle total duration vs remaining time (-m:ss)
    rem-label := Text {
        x: (root.width + root.bar-w) / 2 + 14px;
        y: (parent.height - self.height) / 2;
        text: App.show-remaining && App.has-track && App.duration-secs > 0
            ? "-" + App.format-time(max(0, App.duration-secs - root.shown-secs))
            : App.total;
        color: rem-ta.has-hover && App.has-track ? Theme.text : #6e6e6e;
        font-size: 12px;
        vertical-alignment: center;
        animate color { duration: 120ms; }
    }

    rem-ta := TouchArea {
        x: rem-label.x - 4px;
        y: 0px;
        width: max(36px, rem-label.width + 8px);
        height: parent.height;
        enabled: App.has-track;
        mouse-cursor: App.has-track ? pointer : default;
        clicked => {
            App.show-remaining = !App.show-remaining;
        }
    }
}

export component PlayerBar inherits Rectangle {
    in property <bool> overlay: false;
    property <bool> compact: root.width < 960px;
    height: App.player-height;
    // Glass: the marker brush the Skia renderer draws as a backdrop blur
    // (vendor/i-slint-renderer-skia/glass.rs). Its second stop is the tint.
    // Not while Now Playing or the video hides the bar anyway.
    property <bool> glass: !overlay && App.glass && !(App.bar-covered && (App.show-now-playing || App.video-open));
    background: overlay ? transparent
        : root.glass ? @conic-gradient(#474c5301 0deg, #34343680 360deg)
        : Theme.player-bg;

    // Pages run beneath the bar: nothing aimed at the bar reaches them.
    if !overlay: TouchArea {
        scroll-event(e) => { return accept; }
    }

    // A video's thumbnail is 16:9; the titles move right to make room. In the
    // page's compact bar (720 - 960 wide) the artwork and titles share the
    // first row with the transport, left of it; Now Playing's own compact
    // bar shows no titles (Now Playing does).
    property <bool> titles: !root.compact || !root.overlay;
    property <length> art-w: App.video-active ? App.video-slot-w : App.art-slot-size;
    property <length> text-x: overlay ? 32px : 16px + art-w + (root.compact ? 12px : 15px);
    // The left edge of the transport row (centred).
    property <length> transport-x: (root.width - 232px) / 2;
    // Compact: how wide the titles may be, up to the transport.
    property <length> compact-text-w: max(40px, root.transport-x - 16px - root.text-x);

    function open-track-menu(x: length, y: length) {
        if (App.video-active) {
            App.request-card-menu(App.video-card, x, y);
        } else if (App.has-track) {
            more.open-at(x, y);
        }
    }

    // Left: artwork + titles
    TouchArea {
        visible: root.titles;
        width: root.compact ? root.transport-x - 8px : root.width * 0.32;
        height: root.compact ? 72px : root.height;
        y: 0px;
        enabled: App.has-track;
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.open-track-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    if !overlay && !App.video-active: Rectangle {
        x: 16px;
        y: App.art-slot-top;
        width: root.art-w;
        height: App.art-slot-size;
        if !App.has-track: Cover { source: App.np-cover; }
        // Click opens Now Playing; dragged, the track goes to a playlist.
        TouchArea {
            mouse-cursor: App.drag-active ? grabbing : pointer;
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                    root.open-track-menu(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                    App.drag-release(true);
                }
                if (e.kind == PointerEventKind.cancel) {
                    App.drag-release(false);
                }
            }
            moved => {
                if (App.has-track && self.pressed) {
                    App.drag-move(App.current-id, App.np-title, App.np-artist, App.np-cover, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            clicked => {
                if (App.drag-gesture) {
                    return;
                }
                if (App.video-active) {
                    App.open-video();
                } else {
                    App.open-now-playing();
                }
            }
        }
    }
    HorizontalLayout {
        visible: root.titles;
        x: root.text-x;
        y: 0;
        height: root.compact ? 72px : root.height;
        width: root.compact ? root.compact-text-w : max(120px, root.width * 0.32 - self.x);
        alignment: start;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 0;
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                PlayerLink {
                    context-requested(x, y) => { root.open-track-menu(x, y); }
                    text: App.has-track ? App.np-title : "Nothing playing";
                    clickable: App.video-active || App.np-album-id != "";
                    drags-track: App.has-track && !App.video-active;
                    clicked => {
                        if (App.video-active) { App.open-video(); }
                        else { App.open-now-playing-album(); }
                    }
                    tip: App.has-track ? App.np-title : "";
                    text-color: Theme.text;
                    font-size: 15px;
                    font-weight: 500;
                    max-w: root.compact ? root.compact-text-w - (App.np-explicit ? 24px : 0px) : max(80px, root.width * 0.32 - 220px);
                }

                if App.np-explicit: VerticalLayout {
                    alignment: center;
                    ExplicitBadge { }
                }
            }

            artist-link := ArtistLinks {
                width: min(self.preferred-width, root.compact ? root.compact-text-w : max(80px, root.width * 0.32 - 200px));
                artists: App.has-track ? App.np-artists : [];
                text: App.has-track ? App.np-artist : "Pick something to play";
                text-color: Theme.text-secondary;
                font-size: 13px;
                font-weight: 400;
                context-requested(x, y) => { root.open-track-menu(x, y); }
                open(a) => {
                    root.artist-card-open = false;
                    App.open-artist(a);
                }
                hover(i, on, x) => {
                    if (on) {
                        root.hover-artist = i;
                        root.card-x = x - root.absolute-position.x - 12px;
                        // Already open: retarget the card at the newly hovered name.
                        if (root.artist-card-open) {
                            App.np-artist-hovered(App.np-artists[i]);
                        }
                    } else if (root.hover-artist == i) {
                        root.hover-artist = -1;
                    }
                }
            }

            // Compact, two lines: the context is Now Playing's.
            if App.np-context != "" && !root.compact: HorizontalLayout {
                alignment: start;
                spacing: 5px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: App.video-active ? @image-url("icons/video.svg") : @image-url("icons/music.svg");
                        size: 12px;
                        tint: Theme.text-secondary;
                    }
                }

                PlayerLink {
                    context-requested(x, y) => { root.open-track-menu(x, y); }
                    text: App.np-context;
                    clickable: App.has-track;
                    clicked => { App.open-now-playing-context(); }
                    tip: "Playing from: " + App.np-context;
                    max-w: max(80px, root.width * 0.32 - 215px);
                }
            }
        }

        // Compact: the heart and More are in Now Playing (and the right-click).
        VerticalLayout {
            visible: App.has-track && !root.compact;
            alignment: center;
            HorizontalLayout {
                spacing: 0px;
                IconButton {
                    context-requested(x, y) => { root.open-track-menu(x, y); }
                    icon: App.np-favorite ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
                    size: 17px;
                    tint: Theme.text;
                    clicked => {
                        App.toggle-favorite(App.current-id);
                    }
                }

                Rectangle {
                    width: more.width;
                    height: more.height;
                    more := TrackMenuButton {
                        visible: !App.video-active;
                        track-id: App.video-active ? "" : App.current-id;
                    }

                    if App.video-active: IconButton {
                        icon: @image-url("icons/more.svg");
                        size: 17px;
                        tint: Theme.text;
                        clicked => {
                            App.request-card-menu(App.video-card, self.absolute-position.x, self.absolute-position.y + self.height);
                        }
                    }
                }
            }
        }
    }

    // Artist hover card: opens after a short hover on the artist name and stays while the
    // pointer is on the name or the card (with a grace period to cross the gap between them).
    // Each credited artist is its own link; the card follows the name under the pointer.
    property <bool> artist-card-open: false;
    property <int> hover-artist: -1;
    property <length> card-x: root.text-x - 12px;
    Timer {
        interval: 400ms;
        running: App.has-track && root.hover-artist >= 0 && root.hover-artist < App.np-artists.length && !root.artist-card-open;
        triggered => {
            App.np-artist-hovered(App.np-artists[root.hover-artist]);
            root.artist-card-open = true;
        }
    }

    Timer {
        interval: 300ms;
        running: root.artist-card-open && root.hover-artist < 0 && !artist-card.hovered;
        triggered => {
            root.artist-card-open = false;
        }
    }

    artist-card := ArtistCard {
        visible: root.artist-card-open;
        x: root.card-x;
        y: -(self.height) - 2px;
        read-more => {
            root.artist-card-open = false;
            App.open-now-playing-artist();
        }
    }

    // Centre: transport
    HorizontalLayout {
        y: 16px;
        height: 40px;
        alignment: center;
        spacing: 8px;
        CircleButton {
            accessible-role: button;
            accessible-label: "Shuffle";
            icon: @image-url("icons/shuffle.svg");
            size: 19px;
            tint: App.shuffle ? App.accent : Theme.text-secondary;
            hover-tint: App.shuffle ? App.accent : Theme.text;
            clicked => {
                App.toggle-shuffle();
            }
        }

        CircleButton {
            icon: @image-url("icons/skip-back.svg");
            size: 22px;
            tint: Theme.text;
            clicked => {
                App.prev();
            }
        }

        CircleButton {
            icon: App.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
            size: 28px;
            busy: App.buffering;
            tint: Theme.text;
            clicked => {
                App.toggle-play();
            }
        }

        CircleButton {
            icon: @image-url("icons/skip-forward.svg");
            size: 22px;
            tint: Theme.text;
            clicked => {
                App.next();
            }
        }

        CircleButton {
            accessible-role: button;
            accessible-label: "Repeat";
            icon: App.repeat-mode == 2 ? @image-url("icons/repeat-one.svg") : @image-url("icons/repeat.svg");
            size: 19px;
            tint: App.repeat-mode != 0 ? App.accent : Theme.text-secondary;
            hover-tint: App.repeat-mode != 0 ? App.accent : Theme.text;
            clicked => {
                App.cycle-repeat();
            }
        }
    }

    // Centre: timeline scrubber
    Scrubber {
        x: 0px;
        y: 64px;
        width: root.width;
        // In Now Playing the times stay inside the rounded glass pane.
        bar-w: root.compact ? root.width - (root.overlay ? 140px : 100px) : min(728px, root.width * 0.354);
        seek(v) => {
            App.seek(v);
        }
    }

    // Right: queue, output, volume, DSP, now playing, quality. Compact, a
    // row below the scrubber; in Now Playing (overlay) that row spreads to
    // the corners, the buttons left and the quality right.
    property <bool> corners: root.overlay && root.compact;
    HorizontalLayout {
        y: root.corners ? 88px : root.compact ? 96px : 0px;
        height: root.compact ? 48px : root.height;
        x: root.corners ? 14px : root.compact ? (root.width - self.width) / 2 : root.width - self.width - 20px;
        width: root.corners ? root.width - 28px : self.preferred-width;
        alignment: root.corners ? space-between : end;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                // Tighter in the corners, down to a 320px window.
                spacing: root.corners ? 2px : 8px;
                // While a video is on screen this opens "Similar videos";
                // inside Now Playing it toggles the Queue panel in-place.
                IconButton {
                    accessible-role: button;
                    accessible-label: "Play queue";
                    icon: @image-url("icons/queue.svg");
                    size: 18px;
                    tint: (App.video-open ? App.video-similar-open
                        : App.show-now-playing ? App.show-queue
                        : App.nav-key == "queue") ? Theme.text : Theme.text-secondary;
                    clicked => {
                        if (App.video-open) {
                            App.video-similar-open = !App.video-similar-open;
                        } else if (App.show-now-playing) {
                            App.toggle-np-queue();
                        } else {
                            App.navigate("queue");
                        }
                    }
                }

                dev := IconButton {
                    icon: @image-url("icons/device.svg");
                    size: 18px;
                    clicked => {
                        dev-popup.show();
                    }
                }

                vol := IconButton {
                    icon: App.muted || App.volume == 0 ? @image-url("icons/volume-x.svg") : @image-url("icons/volume.svg");
                    size: 18px;
                    clicked => {
                        vol-popup.show();
                    }
                }

                // DSP: magenta while an equaliser is shaping the sound.
                IconButton {
                    icon: @image-url("icons/eq.svg");
                    size: 18px;
                    tint: App.dsp-active ? Theme.enhanced : App.nav-key == "dsp" ? Theme.text : Theme.text-secondary;
                    hover-tint: App.dsp-active ? Theme.enhanced : Theme.text;
                    clicked => {
                        App.navigate("dsp");
                    }
                }

                // Opens Now Playing: not needed in it once space is short
                // (Minimize closes it). Below 1060px the one-row bar has no
                // room for it beside the centred transport; the artwork
                // opens Now Playing there.
                if !root.corners && (root.compact || root.width >= 1060px): IconButton {
                    icon: @image-url("icons/pip.svg");
                    size: 18px;
                    tint: App.show-now-playing || App.video-open ? Theme.text : Theme.text-secondary;
                    clicked => {
                        App.open-now-playing();
                    }
                }

            }
        }

        Rectangle {
            width: root.corners ? 0px : 12px;
        }

        VerticalLayout {
            alignment: center;
            QualityPill {
                clicked => {
                    if App.video-active || App.signal-quality != "" {
                        signal-popup.show();
                    }
                }
            }
        }
    }

    signal-popup := PopupWindow {
        // Video mode adds the quality column on the left; the signal path
        // keeps its place at the right edge.
        property <bool> with-signal: App.signal-quality != "";
        property <length> quality-width: App.video-active ? (self.with-signal ? 201px : 200px) : 0px;
        close-policy: close-on-click-outside;
        x: max(8px, root.width - 20px - self.width);
        y: -(self.height + 10px);
        width: min(root.width - 16px, self.quality-width + (self.with-signal ? 360px : 0px));
        height: max(self.with-signal ? 262px + App.signal-stages.length * 58px : 0px, App.video-active ? 68px + max(1, App.video-qualities.length) * 40px : 0px);
        SignalPathPanel {
            show-quality: App.video-active;
            show-signal: signal-popup.with-signal;
            quality-picked => {
                signal-popup.close();
            }
        }
    }

    vol-popup := PopupWindow {
        x: max(8px, root.width - 20px - 132px - 12px - 232px);
        y: -44px;
        width: 220px;
        height: 48px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: #1c1c1c;
            border-radius: 10px;
            border-width: 1px;
            border-color: #2a2a2a;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 16px;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: App.muted || App.volume == 0 ? @image-url("icons/volume-x.svg") : @image-url("icons/volume.svg");
                        size: 18px;
                        clicked => {
                            App.toggle-mute();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Slider {
                        value: App.muted ? 0 : App.volume;
                        live: true;
                        changed(v) => {
                            App.set-volume(v);
                        }
                    }
                }
            }
        }
    }

    dev-popup := PopupWindow {
        x: max(8px, root.width - 20px - 132px - 12px - 292px);
        y: -58px;
        width: 250px;
        height: 62px;
        Rectangle {
            background: #1c1c1c;
            border-radius: 10px;
            border-width: 1px;
            border-color: #2a2a2a;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                alignment: center;
                Text {
                    text: "Sound output";
                    color: Theme.text-secondary;
                    font-size: 12px;
                }

                Text {
                    text: App.output-info;
                    color: Theme.text;
                    font-size: 14px;
                    overflow: elide;
                }
            }
        }
    }
}

// One tab of the phone layout's tab bar: an icon, on a rounded plate when it
// is the page on screen.
component DockTab inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> key;
    in property <bool> selected;
    accessible-role: tab;
    accessible-label: root.label;
    accessible-item-selected: root.selected;
    accessible-action-default => { App.navigate(root.key); }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { App.navigate(root.key); }
    }
    Rectangle {
        width: min(parent.width - 8px, 80px);
        height: 40px;
        border-radius: 20px;
        background: root.selected ? #ffffff1f : ta.has-hover ? #ffffff0d : transparent;
        animate background { duration: 150ms; }
    }
    Icon {
        source: root.icon;
        size: 22px;
        tint: root.selected || ta.has-hover ? Theme.text : Theme.text-secondary;
    }
}

// Phone layout (App.phone-layout): what the sidebar and the player bar do on
// a wide window, at the bottom edge. A mini player (artwork, title, artist,
// play / pause and next; the rest opens Now Playing) over a tab bar of the
// four main places. Glass like the player bar, under the same rules: the
// pages run beneath it by App.bar-inset.
export component PhoneDock inherits Rectangle {
    height: App.dock-height;
    property <bool> glass: App.glass && !(App.bar-covered && (App.show-now-playing || App.video-open));
    background: root.glass ? @conic-gradient(#474c5301 0deg, #34343680 360deg) : Theme.player-bg;

    // Pages run beneath the dock: nothing aimed at it reaches them.
    TouchArea {
        scroll-event(e) => { return accept; }
    }

    if App.has-track: mini := Rectangle {
        y: 0px;
        height: App.mini-height;
        property <length> art-w: App.video-active ? App.video-slot-w : App.art-slot-size;
        accessible-role: button;
        accessible-label: "Now Playing";
        accessible-action-default => { if (App.video-active) { App.open-video(); } else { App.open-now-playing(); } }

        // How far the track has played: a hairline along the top edge.
        Rectangle {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 2px;
            background: #ffffff14;
            Rectangle {
                x: 0px;
                width: parent.width * clamp(App.progress, 0, 1);
                background: App.playing ? App.accent : #b3b3b3;
            }
        }

        // The artwork is Now Playing's (it grows from here); the video is the
        // video view's. Clicking the row opens either; dragged, the track
        // goes to a playlist, as from the player bar.
        TouchArea {
            mouse-cursor: App.drag-active ? grabbing : pointer;
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                    if (App.video-active) {
                        App.request-card-menu(App.video-card, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    } else {
                        App.request-track-menu(App.current-id, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
                if (e.button == PointerEventButton.left && e.kind == PointerEventKind.up) {
                    App.drag-release(true);
                }
                if (e.kind == PointerEventKind.cancel) {
                    App.drag-release(false);
                }
            }
            moved => {
                if (self.pressed && !App.video-active) {
                    App.drag-move(App.current-id, App.np-title, App.np-artist, App.np-cover, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
            }
            clicked => {
                if (App.drag-gesture) {
                    return;
                }
                if (App.video-active) {
                    App.open-video();
                } else {
                    App.open-now-playing();
                }
            }
        }

        VerticalLayout {
            x: 16px + mini.art-w + 12px;
            width: parent.width - self.x - 112px;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                alignment: start;
                spacing: 6px;
                Text {
                    text: App.np-title;
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: Theme.demibold;
                    overflow: elide;
                }
                if App.np-explicit: VerticalLayout {
                    alignment: center;
                    ExplicitBadge { }
                }
            }
            Text {
                text: App.np-artist;
                color: Theme.text-secondary;
                font-size: 13px;
                overflow: elide;
            }
        }

        CircleButton {
            x: parent.width - 16px - 40px - 44px;
            y: (parent.height - self.height) / 2;
            icon: App.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
            size: 26px;
            busy: App.buffering;
            tint: Theme.text;
            accessible-role: button;
            accessible-label: App.playing ? "Pause" : "Play";
            accessible-action-default => { App.toggle-play(); }
            clicked => { App.toggle-play(); }
        }
        CircleButton {
            x: parent.width - 12px - 40px;
            y: (parent.height - self.height) / 2;
            icon: @image-url("icons/skip-forward.svg");
            size: 22px;
            tint: Theme.text;
            accessible-role: button;
            accessible-label: "Next";
            accessible-action-default => { App.next(); }
            clicked => { App.next(); }
        }
    }

    // The tab bar: Home, Feed, Explore (with search), and the collection.
    tabs := Rectangle {
        y: parent.height - self.height;
        height: App.tabs-height;
        HorizontalLayout {
            x: (parent.width - self.width) / 2;
            width: min(parent.width - 16px, 520px);
            padding-bottom: 6px;
            DockTab {
                horizontal-stretch: 1;
                icon: @image-url("icons/music.svg");
                label: "Home";
                key: "home";
                selected: App.nav-key == "home";
            }
            DockTab {
                horizontal-stretch: 1;
                icon: @image-url("icons/bell.svg");
                label: "Feed";
                key: "feed";
                selected: App.nav-key == "feed";
            }
            DockTab {
                horizontal-stretch: 1;
                icon: @image-url("icons/search.svg");
                label: "Explore";
                key: "explore";
                selected: App.nav-key == "explore" || App.view == "search";
            }
            DockTab {
                horizontal-stretch: 1;
                icon: @image-url("icons/library.svg");
                label: "Collection";
                key: "collection";
                selected: App.nav-key == "collection" || App.nav-key == "mixes" || App.nav-key == "playlists"
                    || App.nav-key == "albums" || App.nav-key == "tracks" || App.nav-key == "videos"
                    || App.nav-key == "profiles" || App.nav-key == "later";
            }
        }
    }
}
