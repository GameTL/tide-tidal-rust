// Window chrome: sidebar, top bar and the bottom player bar.
import { ScrollView } from "std-widgets.slint";
import { App, Theme, Icon, IconButton, Cover, CardArt, CardData, ExplicitBadge, Slider, DragArea } from "common.slint";

component NavItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <string> key;
    property <bool> selected: App.nav-key == key;
    height: 44px;
    Rectangle {
        x: 17px;
        width: parent.width - 34px;
        border-radius: 10px;
        background: selected ? Theme.selected : ta.has-hover ? #141414 : transparent;
        ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                App.navigate(root.key);
            }
        }

        Icon {
            x: 12px;
            source: root.icon;
            size: 19px;
            tint: selected || ta.has-hover ? Theme.text : Theme.text-secondary;
        }

        Text {
            x: 44px;
            text: root.label;
            color: selected || ta.has-hover ? Theme.text : Theme.text-secondary;
            font-size: 15px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }
}

component SidebarPlaylist inherits Rectangle {
    in property <CardData> card;
    height: 57px;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            App.open-card(root.card);
        }
    }

    Rectangle {
        x: 10px;
        width: parent.width - 20px;
        border-radius: 8px;
        background: ta.has-hover ? #141414 : transparent;
    }

    CardArt {
        x: 19px;
        width: 40px;
        height: 40px;
        card: root.card;
        radius: 3px;
    }

    VerticalLayout {
        x: 72px;
        width: parent.width - 72px - 16px;
        alignment: center;
        spacing: 2px;
        Text {
            text: card.title;
            color: Theme.text;
            font-size: 15px;
            font-weight: 500;
            overflow: elide;
        }

        Text {
            text: card.subtitle;
            color: Theme.text-secondary;
            font-size: 13px;
            overflow: elide;
        }
    }
}

export component Sidebar inherits Rectangle {
    width: 261px;
    background: Theme.bg;
    // Space for the macOS traffic lights.
    Rectangle {
        y: 0;
        height: 64px;
        DragArea { }

        Icon {
            x: parent.width - 34px;
            y: 23px;
            source: @image-url("icons/collapse.svg");
            size: 18px;
            tint: Theme.text-dim;
        }
    }

    ScrollView {
        y: 64px;
        height: parent.height - 64px;
        VerticalLayout {
            alignment: start;
            padding-bottom: 12px;
            NavItem {
                label: "Music";
                key: "home";
                icon: @image-url("icons/music.svg");
            }

            NavItem {
                label: "Explore";
                key: "explore";
                icon: @image-url("icons/globe.svg");
            }

            NavItem {
                label: "Feed";
                key: "feed";
                icon: @image-url("icons/bell.svg");
            }

            Rectangle {
                height: 58px;
                Text {
                    x: 19px;
                    y: 30px;
                    text: "Collection";
                    color: Theme.text-dim;
                    font-size: 14px;
                    font-weight: 500;
                }
            }

            NavItem {
                label: "Mixes & Radio";
                key: "mixes";
                icon: @image-url("icons/radio.svg");
            }

            NavItem {
                label: "Playlists";
                key: "playlists";
                icon: @image-url("icons/playlist.svg");
            }

            NavItem {
                label: "Albums";
                key: "albums";
                icon: @image-url("icons/disc.svg");
            }

            NavItem {
                label: "Tracks";
                key: "tracks";
                icon: @image-url("icons/music.svg");
            }

            NavItem {
                label: "Videos";
                key: "videos";
                icon: @image-url("icons/video.svg");
            }

            NavItem {
                label: "Profiles";
                key: "profiles";
                icon: @image-url("icons/key.svg");
            }

            NavItem {
                label: "Save for Later";
                key: "later";
                icon: @image-url("icons/bookmark.svg");
            }

            Rectangle {
                height: 62px;
                Text {
                    x: 19px;
                    y: 30px;
                    text: "All playlists";
                    color: Theme.text-dim;
                    font-size: 14px;
                    font-weight: 500;
                }

                Icon {
                    x: parent.width - 72px;
                    y: 31px;
                    source: @image-url("icons/plus-circle.svg");
                    size: 16px;
                    tint: Theme.text-secondary;
                }

                Icon {
                    x: parent.width - 42px;
                    y: 31px;
                    source: @image-url("icons/sort.svg");
                    size: 16px;
                    tint: Theme.text-secondary;
                }
            }

            for card in App.sidebar-playlists: SidebarPlaylist {
                card: card;
            }
        }
    }

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: #111111;
    }
}

export component TopBar inherits Rectangle {
    height: 64px;
    DragArea { }

    // Back / forward
    Rectangle {
        x: 18px;
        y: 13px;
        width: 76px;
        height: 39px;
        border-radius: 19.5px;
        background: Theme.pill;
        HorizontalLayout {
            padding-left: 4px;
            padding-right: 4px;
            IconButton {
                icon: @image-url("icons/chevron-left.svg");
                size: 18px;
                enabled: App.can-go-back;
                tint: Theme.text;
                clicked => {
                    App.back();
                }
            }

            IconButton {
                icon: @image-url("icons/chevron-right.svg");
                size: 18px;
                enabled: App.can-go-forward;
                tint: Theme.text;
                clicked => {
                    App.forward();
                }
            }
        }
    }

    // Search
    Rectangle {
        x: parent.width - 66px - self.width;
        y: 13px;
        width: min(306px, parent.width - 190px);
        height: 39px;
        border-radius: 19.5px;
        background: Theme.pill;
        border-width: input.has-focus ? 1px : 0px;
        border-color: #3a3a3a;
        Icon {
            x: 14px;
            source: @image-url("icons/search.svg");
            size: 15px;
            tint: Theme.text-secondary;
        }

        if input.text == "": Text {
            x: 48px;
            text: "Search";
            color: Theme.text-secondary;
            font-size: 15px;
            vertical-alignment: center;
        }
        input := TextInput {
            x: 48px;
            width: parent.width - 48px - 40px;
            height: 20px;
            text <=> App.search-text;
            color: Theme.text;
            font-size: 15px;
            single-line: true;
            vertical-alignment: center;
            selection-background-color: #4a4a4a;
            accepted => {
                App.search(self.text);
            }
        }

        property <int> focus-request: App.focus-search;
        changed focus-request => {
            input.focus();
            input.select-all();
        }

        if input.text != "": IconButton {
            x: parent.width - 40px;
            icon: @image-url("icons/x.svg");
            size: 15px;
            tint: Theme.text;
            clicked => {
                App.search-text = "";
                input.focus();
            }
        }
    }

    // Profile
    profile := Rectangle {
        x: parent.width - 13px - self.width;
        y: 15px;
        width: 35px;
        height: 35px;
        border-radius: 17.5px;
        background: pta.has-hover ? #333333 : #2a2a2a;
        pta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                menu.show();
            }
        }

        Icon {
            source: @image-url("icons/user.svg");
            size: 18px;
        }
    }

    menu := PopupWindow {
        x: root.width - 13px - 230px;
        y: 58px;
        width: 230px;
        Rectangle {
            background: #1c1c1c;
            border-radius: 10px;
            border-width: 1px;
            border-color: #2a2a2a;
            VerticalLayout {
                padding: 8px;
                Rectangle {
                    height: 44px;
                    Text {
                        x: 10px;
                        width: parent.width - 20px;
                        text: App.username;
                        color: Theme.text-secondary;
                        font-size: 13px;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: sta.has-hover ? #2a2a2a : transparent;
                    sta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            App.navigate("settings");
                        }
                    }

                    Text {
                        x: 10px;
                        text: "Settings";
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                    }

                    Text {
                        x: parent.width - self.width - 10px;
                        text: "⌘,";
                        color: Theme.text-secondary;
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: lta.has-hover ? #2a2a2a : transparent;
                    lta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            App.logout();
                        }
                    }

                    Text {
                        x: 10px;
                        text: "Log out";
                        color: Theme.text;
                        font-size: 14px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

component QualityPill inherits Rectangle {
    width: 132px;
    height: 43px;
    border-radius: 21.5px;
    background: #050505;
    border-width: 1px;
    border-color: #2b2b2b;
    drop-shadow-blur: App.has-track ? 14px : 0px;
    drop-shadow-color: App.accent.with-alpha(0.12);
    Text {
        text: App.quality-label;
        color: App.accent;
        font-size: 13px;
        font-weight: 500;
    }
}

export component PlayerBar inherits Rectangle {
    in property <bool> overlay: false;
    height: 96px;
    background: overlay ? transparent : Theme.player-bg;

    // Left: artwork + titles
    if !overlay: Cover {
        x: 16px;
        y: 17px;
        width: 62px;
        height: 62px;
        source: App.np-cover;
        TouchArea {
            mouse-cursor: pointer;
            clicked => {
                App.open-now-playing();
            }
        }
    }
    HorizontalLayout {
        x: overlay ? 32px : 93px;
        y: 0;
        width: max(120px, root.width * 0.32 - self.x);
        alignment: start;
        spacing: 14px;
        VerticalLayout {
            alignment: center;
            spacing: 4px;
            horizontal-stretch: 0;
            HorizontalLayout {
                alignment: start;
                spacing: 8px;
                Text {
                    text: App.has-track ? App.np-title : "Nothing playing";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 500;
                    overflow: elide;
                    max-width: max(80px, root.width * 0.32 - 220px);
                }

                if App.np-explicit: VerticalLayout {
                    alignment: center;
                    ExplicitBadge { }
                }
            }

            Text {
                text: App.has-track ? App.np-artist : "Pick something to play";
                color: Theme.text-secondary;
                font-size: 13px;
                overflow: elide;
                max-width: max(80px, root.width * 0.32 - 200px);
            }

            if App.np-context != "": HorizontalLayout {
                alignment: start;
                spacing: 5px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        source: @image-url("icons/music.svg");
                        size: 12px;
                        tint: Theme.text-secondary;
                    }
                }

                Text {
                    text: App.np-context;
                    color: Theme.text-secondary;
                    font-size: 13px;
                }
            }
        }

        if App.has-track: VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 0px;
                IconButton {
                    icon: App.np-favorite ? @image-url("icons/heart-fill.svg") : @image-url("icons/heart.svg");
                    size: 17px;
                    tint: Theme.text;
                    clicked => {
                        App.toggle-favorite(App.current-id);
                    }
                }

                IconButton {
                    icon: @image-url("icons/more.svg");
                    size: 17px;
                }
            }
        }
    }

    // Centre: transport
    HorizontalLayout {
        y: 16px;
        height: 40px;
        alignment: center;
        spacing: 12px;
        IconButton {
            icon: @image-url("icons/shuffle.svg");
            size: 19px;
            tint: App.shuffle ? App.accent : Theme.text-secondary;
            hover-tint: App.shuffle ? App.accent : Theme.text;
            clicked => {
                App.toggle-shuffle();
            }
        }

        IconButton {
            icon: @image-url("icons/skip-back.svg");
            size: 22px;
            tint: Theme.text;
            clicked => {
                App.prev();
            }
        }

        IconButton {
            icon: App.playing ? @image-url("icons/pause.svg") : @image-url("icons/play.svg");
            size: 28px;
            tint: App.buffering ? Theme.text-secondary : Theme.text;
            clicked => {
                App.toggle-play();
            }
        }

        IconButton {
            icon: @image-url("icons/skip-forward.svg");
            size: 22px;
            tint: Theme.text;
            clicked => {
                App.next();
            }
        }

        IconButton {
            icon: App.repeat-mode == 2 ? @image-url("icons/repeat-one.svg") : @image-url("icons/repeat.svg");
            size: 19px;
            tint: App.repeat-mode != 0 ? App.accent : Theme.text-secondary;
            hover-tint: App.repeat-mode != 0 ? App.accent : Theme.text;
            clicked => {
                App.cycle-repeat();
            }
        }
    }

    // Centre: timeline
    property <length> bar-w: min(728px, root.width * 0.354);
    Text {
        x: (root.width - bar-w) / 2 - 16px - self.width;
        y: 66px;
        height: 16px;
        text: App.elapsed;
        color: #6e6e6e;
        font-size: 12px;
        vertical-alignment: center;
    }

    Slider {
        x: (root.width - bar-w) / 2;
        y: 66px;
        width: bar-w;
        value: App.progress;
        changed(v) => {
            App.seek(v);
        }
    }

    Text {
        x: (root.width + bar-w) / 2 + 16px;
        y: 66px;
        height: 16px;
        text: App.total;
        color: #6e6e6e;
        font-size: 12px;
        vertical-alignment: center;
    }

    // Right: queue, output, volume, now playing, quality
    HorizontalLayout {
        x: root.width - self.width - 20px;
        width: self.preferred-width;
        alignment: end;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                IconButton {
                    icon: @image-url("icons/queue.svg");
                    size: 18px;
                    tint: App.nav-key == "queue" ? Theme.text : Theme.text-secondary;
                    clicked => {
                        App.navigate("queue");
                    }
                }

                dev := IconButton {
                    icon: @image-url("icons/device.svg");
                    size: 18px;
                    clicked => {
                        dev-popup.show();
                    }
                }

                vol := IconButton {
                    icon: App.muted || App.volume == 0 ? @image-url("icons/volume-x.svg") : @image-url("icons/volume.svg");
                    size: 18px;
                    clicked => {
                        vol-popup.show();
                    }
                }

                IconButton {
                    icon: @image-url("icons/pip.svg");
                    size: 18px;
                    tint: App.show-now-playing ? Theme.text : Theme.text-secondary;
                    clicked => {
                        App.open-now-playing();
                    }
                }
            }
        }

        Rectangle {
            width: 12px;
        }

        VerticalLayout {
            alignment: center;
            QualityPill { }
        }
    }

    vol-popup := PopupWindow {
        x: root.width - 20px - 132px - 12px - 190px;
        y: -44px;
        width: 220px;
        height: 48px;
        close-policy: close-on-click-outside;
        Rectangle {
            background: #1c1c1c;
            border-radius: 10px;
            border-width: 1px;
            border-color: #2a2a2a;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 16px;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: App.muted || App.volume == 0 ? @image-url("icons/volume-x.svg") : @image-url("icons/volume.svg");
                        size: 18px;
                        clicked => {
                            App.toggle-mute();
                        }
                    }
                }

                VerticalLayout {
                    alignment: center;
                    Slider {
                        value: App.muted ? 0 : App.volume;
                        live: true;
                        changed(v) => {
                            App.set-volume(v);
                        }
                    }
                }
            }
        }
    }

    dev-popup := PopupWindow {
        x: root.width - 20px - 132px - 12px - 250px;
        y: -58px;
        width: 250px;
        height: 62px;
        Rectangle {
            background: #1c1c1c;
            border-radius: 10px;
            border-width: 1px;
            border-color: #2a2a2a;
            VerticalLayout {
                padding: 12px;
                spacing: 4px;
                alignment: center;
                Text {
                    text: "Sound output";
                    color: Theme.text-secondary;
                    font-size: 12px;
                }

                Text {
                    text: App.output-info;
                    color: Theme.text;
                    font-size: 14px;
                    overflow: elide;
                }
            }
        }
    }
}
