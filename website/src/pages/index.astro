---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Beats from '../components/Beats.astro';
import Download from '../components/Download.astro';
import Footer from '../components/Footer.astro';
import releasesData from '../data/releases.json';

type Release = {
  version: string;
  tag: string;
  publishedAt: string | null;
  macUniversalUrl: string | null;
  linuxUrl: string | null;
  windowsUrl: string | null;
};

const releases = (releasesData.releases ?? []) as Release[];
const latestMacUrl = releases.find((r) => r.macUniversalUrl)?.macUniversalUrl ?? null;
---
<Layout>
  <Hero latestMacUrl={latestMacUrl} />
  <Beats />
  <Download releases={releases} />
  <Footer />
</Layout>
