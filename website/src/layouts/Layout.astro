---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'TIDE — unofficial native TIDAL player',
  description = 'Unofficial native TIDAL player for macOS. Bit-perfect playback, parametric EQ, no telemetry.',
} = Astro.props;

const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href={`${base}brand/tide.png`} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
