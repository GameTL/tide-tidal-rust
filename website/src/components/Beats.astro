            <line x1="0" y1="40" x2="400" y2="40" />
            <line x1="0" y1="120" x2="400" y2="120" />
            <line x1="93.2" y1="0" x2="93.2" y2="160" />
            <line x1="226.5" y1="0" x2="226.5" y2="160" />
            <line x1="359.9" y1="0" x2="359.9" y2="160" />
