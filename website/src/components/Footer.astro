---
import { Image } from 'astro:assets';
import DownloadButton from './DownloadButton.astro';
import { github } from '../data/links';
import { site } from '../data/site';
import logo from '../assets/tide.png';
---
<section class="sec sec-cta">
  <div class="container cta-inner">
    <h2 class="cta-title">Your music deserves<br />better than a browser tab.</h2>
    <p>Free and open source. Sign in with TIDAL and press play.</p>
    <div class="hero-ctas">
      <DownloadButton />
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <Image src={logo} alt="" width={18} height={18} densities={[1, 2]} />
      <span>Not affiliated with TIDAL. Requires a TIDAL subscription.</span>
    </div>
    <nav aria-label="Footer">
      <a href={site.author.url}>By {site.author.name}</a>
      <a href={github}>GitHub</a>
      <a href={`${github}/releases`}>Releases</a>
      <a href={`${github}/blob/staging/SECURITY.md`}>Security</a>
    </nav>
  </div>
</footer>
