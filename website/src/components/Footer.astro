---
interface Props {
  latestMacUrl: string | null;
}

const { latestMacUrl } = Astro.props;
const base = import.meta.env.BASE_URL;
const github = 'https://github.com/GameTL/tide-tidal-rust';
const ctaHref = latestMacUrl ?? `${github}/releases`;
---
<section class="sec sec-cta">
  <div class="container cta-inner">
    <h2 class="cta-title">Your music deserves<br />better than a browser tab.</h2>
    <p>Free and open source. Sign in with TIDAL and press play.</p>
    <div class="hero-ctas">
      <a class="btn-primary" href={ctaHref}>Download for macOS</a>
      <a class="text-link" href={`${github}/releases`} target="_blank" rel="noreferrer">
        All releases <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <img src={`${base}brand/tide.png`} alt="" width="18" height="18" />
      <span>Not affiliated with TIDAL. Requires a TIDAL subscription.</span>
    </div>
    <nav>
      <a href={github}>GitHub</a>
      <a href={`${github}/releases`}>Releases</a>
      <a href={`${github}/blob/staging/SECURITY.md`}>Security</a>
    </nav>
  </div>
</footer>
