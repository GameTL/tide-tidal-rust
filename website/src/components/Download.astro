---
// One card per system: the download, then the one thing to know on first launch.
import InstallCommand from './InstallCommand.astro';
import {
  brewCommand,
  github,
  latestLinuxArmTarball,
  latestLinuxTarball,
  latestMacDmg,
  latestWindows,
} from '../data/links';
---
<section class="sec" id="download">
  <div class="container">
    <div class="sec-head">
      <h2>Download</h2>
      <p>Free. Sign in with your TIDAL account and press play.</p>
    </div>

    <div class="platforms">
      <div class="tile platform">
        <div class="platform-head"><span>macOS</span></div>
        <p class="muted">Apple Silicon and Intel.</p>
        <a class="btn-primary" href={latestMacDmg}>Download the dmg</a>
        <p class="muted small">
          First launch: click <strong>Done</strong>, then System Settings › Privacy &amp; Security ›{' '}
          <strong>Open Anyway</strong>. Or skip that with Terminal:
        </p>
        <InstallCommand />
      </div>

      {latestWindows ? (
        <div class="tile platform">
          <div class="platform-head"><span>Windows</span></div>
          <p class="muted">Windows 10 and 11.</p>
          <a class="btn-primary" href={latestWindows}>Download for Windows</a>
          <p class="muted small">
            First launch: SmartScreen asks once. Click <strong>More info</strong>, then{' '}
            <strong>Run anyway</strong>.
          </p>
        </div>
      ) : (
        <div class="tile platform dim">
          <div class="platform-head">
            <span>Windows</span>
            <span class="pill-soon">Coming soon</span>
          </div>
          <p class="muted">Windows 10 and 11.</p>
        </div>
      )}

      {latestLinuxTarball ? (
        <div class="tile platform">
          <div class="platform-head"><span>Linux</span></div>
          <p class="muted">
            Ubuntu, Bazzite and others, with <a class="text-link inline" href="https://brew.sh">Homebrew</a>:
          </p>
          <InstallCommand command={brewCommand} />
          <p class="muted small">
            Then open TIDE from your app menu, or run <code>tide</code>. Without Homebrew:{' '}
            <a class="text-link inline" href={latestLinuxTarball}>x86-64</a>
            {latestLinuxArmTarball && (
              <>
                {' · '}
                <a class="text-link inline" href={latestLinuxArmTarball}>Arm</a>
              </>
            )}
          </p>
        </div>
      ) : (
        <div class="tile platform dim">
          <div class="platform-head">
            <span>Linux</span>
            <span class="pill-soon">Coming soon</span>
          </div>
          <p class="muted">Ubuntu, Bazzite and others.</p>
        </div>
      )}
    </div>

    <p class="muted small dl-foot">
      TIDE isn’t signed by Apple or Microsoft, which costs money every year, so each system asks
      once. The code is <a class="text-link inline" href={github}>open source</a>.{' '}
      <a class="text-link inline" href={`${github}/releases`}>Older versions ↗</a>
    </p>
  </div>
</section>
