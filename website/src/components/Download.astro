---
interface Release {
  version: string;
  tag: string;
  publishedAt: string | null;
  macUniversalUrl: string | null;
  linuxUrl: string | null;
  windowsUrl: string | null;
}

interface Props {
  releases: Release[];
}

import { github, latestMacDmg } from '../data/links';
import InstallCommand from './InstallCommand.astro';

const { releases } = Astro.props;
const kind = (url: string) => (url.toLowerCase().endsWith('.dmg') ? 'dmg' : 'zip');
const fmt = (d: string | null) =>
  d
    ? new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })
    : '';
---
<section class="sec" id="download">
  <div class="container">
    <div class="sec-head">
      <h2>Downloads</h2>
      <p>Two ways to install on macOS. Both get the latest release.</p>
    </div>

    <div class="install-ways">
      <div class="tile install-way">
        <div class="platform-head">
          <span>Install from Terminal</span>
          <span class="pill-ok">Recommended</span>
        </div>
        <p class="muted">
          Paste this into Terminal. It downloads the latest release and opens without a
          security prompt.
        </p>
        <InstallCommand />
        <p class="muted small">
          TIDE goes to <code>/Applications/TIDE.app</code>, or{' '}
          <code>~/Applications/TIDE.app</code> if /Applications isn’t writable. Open it from
          Spotlight or Launchpad.
        </p>
      </div>

      <div class="tile install-way">
        <div class="platform-head">
          <span>Download the dmg</span>
        </div>
        <p class="muted">Open it and drag TIDE into Applications.</p>
        <a class="btn-primary" href={latestMacDmg}>Download for macOS</a>
        <p class="muted small">
          The first launch says “Apple could not verify TIDE”. To open it anyway:
        </p>
        <ol class="steps">
          <li>Click <strong>Done</strong> on the warning.</li>
          <li>Open <strong>System Settings › Privacy &amp; Security</strong>.</li>
          <li>Scroll down and click <strong>Open Anyway</strong>, then confirm.</li>
        </ol>
        <p class="muted small">You only do this once.</p>
      </div>
    </div>

    <p class="why-unsigned">
      <strong>Why the warning?</strong> TIDE is a free, personal project, so it isn’t signed
      through Apple’s paid Developer Program ($99 a year). macOS can’t verify apps that aren’t
      signed that way and asks you once. The code is{' '}
      <a class="text-link" href={github}>open source</a> if you’d rather check it, or build it
      yourself.
    </p>

    <div class="platforms">
      <div class="tile platform">
        <div class="platform-head">
          <span>macOS</span>
          <span class="pill-ok">Available</span>
        </div>
        <p class="muted">Apple Silicon and Intel.</p>
      </div>
      <div class="tile platform dim">
        <div class="platform-head">
          <span>Linux</span>
          <span class="pill-soon">Planned</span>
        </div>
        <p class="muted">No builds yet.</p>
      </div>
      <div class="tile platform dim">
        <div class="platform-head">
          <span>Windows</span>
          <span class="pill-soon">Planned</span>
        </div>
        <p class="muted">No builds yet.</p>
      </div>
    </div>

    <div class="tile releases">
      {releases.length === 0 ? (
        <div class="release-row">
          <span class="muted">No releases published yet.</span>
          <a class="text-link" href={`${github}/releases`}>GitHub Releases ↗</a>
        </div>
      ) : (
        releases.map((r, i) => (
          <div class="release-row">
            <div class="release-ver">
              <code>v{r.version}</code>
              {i === 0 && <span class="pill-ok">Latest</span>}
              <span class="muted">{fmt(r.publishedAt)}</span>
            </div>
            {r.macUniversalUrl ? (
              <a class="text-link" href={r.macUniversalUrl}>macOS universal {kind(r.macUniversalUrl)} ↓</a>
            ) : (
              <span class="muted">Unavailable</span>
            )}
          </div>
        ))
      )}
    </div>
  </div>
</section>
