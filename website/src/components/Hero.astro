---
interface Props {
  latestMacUrl: string | null;
}

const { latestMacUrl } = Astro.props;
const base = import.meta.env.BASE_URL;
const github = 'https://github.com/GameTL/tide-tidal-rust';
const ctaHref = latestMacUrl ?? `${github}/releases`;
const ctaDisabled = !latestMacUrl;
---
<section class="hero">
  <div class="ornaments" aria-hidden="true">
    <span class="badge max">MAX</span>
    <span class="badge hires">HIRES</span>
    <span class="badge lossless">LOSSLESS</span>
    <span class="mark m1"><img src={`${base}brand/tide.png`} alt="" /></span>
    <span class="mark m2"><img src={`${base}brand/tide.png`} alt="" /></span>
  </div>

  <div class="wrap">
    <p class="eyebrow">
      <img src={`${base}brand/tide.png`} alt="" />
      TIDE
    </p>
    <h1>The unofficial native player for your TIDAL subscription.</h1>
    <p class="lead">
      Opinionated TIDAL API music player in pure Rust. Bring your own subscription.
      Bit-perfect when the output allows. I don’t want your data.
    </p>
    <div class="btn-row">
      <a
        class="btn btn-primary"
        href={ctaHref}
        aria-disabled={ctaDisabled ? 'true' : undefined}
      >
        <svg class="apple" viewBox="0 0 16 16" aria-hidden="true">
          <path d="M12.5 8.2c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.7-1.3-.1-2.5.8-3.1.8-.7 0-1.7-.7-2.8-.7-1.4 0-2.8.9-3.5 2.2-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.6 2.2 2.7 2.1 1.1-.1 1.5-.7 2.8-.7s1.7.7 2.8.6c1.2-.1 1.9-1 2.6-2 .8-1.2 1.1-2.3 1.1-2.4-.1 0-2.2-.9-2.2-3.5zM10.3 2.6c.6-.7 1-1.7.9-2.6-.9 0-1.9.6-2.5 1.3-.6.6-1.1 1.6-.9 2.5 1 .1 1.9-.5 2.5-1.2z"></path>
        </svg>
        Download for macOS
      </a>
      <a class="btn btn-ghost" href={github} target="_blank" rel="noreferrer">
        GitHub ↗
      </a>
    </div>
    <p class="note">
      Universal binary · unsigned build · right-click the app → Open the first time.
      {ctaDisabled ? ' No release published yet — CTA opens GitHub Releases.' : ''}
    </p>

    <figure class="preview">
      <img
        src={`${base}screenshots/app-home.png`}
        alt="TIDE desktop app showing the home library"
        width="1600"
        height="1000"
      />
    </figure>
  </div>
</section>
