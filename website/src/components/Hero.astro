---
import DownloadButton from './DownloadButton.astro';
import { Image, Picture } from 'astro:assets';
import logo from '../assets/tide.png';
import appHome from '../assets/screenshots/app-home.png';
---
<section class="hero">
  <div class="hero-float" aria-hidden="true">
    <span class="float-tile ft-1">
      <svg viewBox="0 0 24 24"><path d="M9 18V5l11-2v13" /><circle cx="6" cy="18" r="3" /><circle cx="17" cy="16" r="3" /></svg>
    </span>
    <span class="float-tile ft-2 q-max">MAX</span>
    <span class="float-tile ft-3 q-high">HIGH</span>
    <span class="float-tile ft-4 sparkle">
      <svg viewBox="0 0 24 24"><path d="M12 3c.6 4.6 3.4 7.4 8 8-4.6.6-7.4 3.4-8 8-.6-4.6-3.4-7.4-8-8 4.6-.6 7.4-3.4 8-8z" /></svg>
    </span>
    <span class="float-tile ft-5">
      <svg viewBox="0 0 24 24"><path d="M3 12h2M7 8v8M11 4v16M15 7v10M19 10v4M21 12h0" /></svg>
    </span>
    <span class="float-tile ft-6">
      <svg viewBox="0 0 24 24"><path d="M4 15v-3a8 8 0 0 1 16 0v3" /><rect x="3" y="14" width="4" height="6" rx="1.5" /><rect x="17" y="14" width="4" height="6" rx="1.5" /></svg>
    </span>
  </div>

  <div class="container hero-inner">
    <div class="hero-logo">
      <span class="hero-logo-glow" aria-hidden="true"></span>
      <Image src={logo} alt="TIDE logo" width={128} height={128} densities={[1, 2]} loading="eager" fetchpriority="high" />
    </div>
    <h1>The native player<br />for your TIDAL<br />subscription.</h1>
    <p class="hero-sub">
      A desktop app for macOS, Windows and Linux, in pure Rust. Bit-perfect playback, a parametric EQ, a native UI
      that’s faster everywhere, and no telemetry.
    </p>
    <div class="hero-ctas">
      <DownloadButton extras />
    </div>
    <p class="hero-meta">Free · Open source · Unofficial</p>
  </div>

  <div class="container">
    <figure class="hero-shot">
      <Picture
        src={appHome}
        formats={['avif', 'webp']}
        widths={[640, 960, 1440, 1920]}
        sizes="(max-width: 1008px) calc(100vw - 48px), 960px"
        alt="TIDE, a native TIDAL desktop app, showing the home feed, listening history and recommended tracks"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </div>
</section>
